# forge-record-answer.service — the coordinator's read-only answer (27 September 2026)
#
# WHAT: the one small service that answers, read-only, two questions about what
#   the coordinator wrote down:
#     GET /recorded?build=<build>   -> {"build":…, "recorded":…, "start_commit":…}
#     GET /recorded?target=<target> -> {"target":…, "recorded":…, "counter":…, "build":…}
#     GET /healthz                  -> {"status":"healthy"}
#   It changes nothing: the record is opened read-only (the URI form with
#   mode=ro), so the store itself refuses a write on its handle, and there is no
#   verb but GET.
#
# WHY IT HAS TO BE UP BEFORE THE DEPLOY HELPER IS ROLLED OUT. The deploy helper
#   reads a project's own two declaration files at a commit, and honours the
#   commit a request names only when this answer confirms it is the one recorded
#   for that build. The coordinator stamps that commit on every deploy request
#   for a build that came through planning. With nothing answering, the helper
#   refuses those requests — nothing is deployed, the live thing is untouched
#   and the sentence is plain, but the factory stops deploying. So: this service
#   first, then the helper's own setting naming it (below), then the helper.
#
# THE SETTING THAT NAMES IT: FORGE_TARGET_OWNER_URL, read by the deploy helper
#   (forge.deploy_sidecar.service). It carries this service's address WITH the
#   route on the end, for example
#     FORGE_TARGET_OWNER_URL=http://127.0.0.1:8126/recorded
#   The helper on the host is given it by
#   scripts/systemd/forge-deploy-sidecar.service. The helper inside a
#   repository's sandbox is given it by the sandbox's own environment file, and
#   deploy/sandbox-deploy.sh carries it in when it is set — there the address
#   must be one that resolves from INSIDE the sandbox, and the sandbox's
#   outbound allowance (the profile's sandbox.allow_network) must name it.
#
# SCOPE: a systemd USER unit, the same shape as the deploy sidecar's, binding
#   the forge developer venv. Loopback by default (the service's own DEFAULT_HOST).
#   This file is AUTHORED only — the attended install/enable is the coordinator's
#   step, with Rich present.
#
# INSTALL (coordinator, attended):
#     mkdir -p ~/.config/systemd/user
#     cp scripts/systemd/forge-record-answer.service ~/.config/systemd/user/
#     systemctl --user daemon-reload
#     systemctl --user enable --now forge-record-answer.service
#   Verify:
#     curl -s 'http://127.0.0.1:8126/healthz'
#     curl -s 'http://127.0.0.1:8126/recorded?build=<a build id>'

[Unit]
Description=forge record answer (read-only: what a build starts from, who owns a target)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# The coordinator's own record. The same path the requeue sweep's liveness
# guard reads, and the one the deploy sidecar unit already names.
Environment=FORGE_DB_PATH=%h/forge-prod-state/.forge/forge.db
WorkingDirectory=%h/Projects/appmilla_github/forge
ExecStart=%h/Projects/appmilla_github/forge/.venv/bin/python -m forge.record_answer \
  --host 127.0.0.1 \
  --port 8126
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
KillSignal=SIGINT
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
