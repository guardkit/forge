# ---------------------------------------------------------------------------
# EVERY NAME FORGE'S COMPOSE BUNDLE NEEDS. Copy this file to '.env' beside it
# and fill in the lines marked CHANGE THIS. Nothing else on a new machine has
# to be edited: this file is the only place a machine's own address, port or
# file path is written down, and it is the whole of the difference between a
# local machine and a cloud one.
#
# NO VALUE BELOW BELONGS TO ANY MACHINE. Where an example value is needed so
# that 'docker compose config' renders and can be checked, it is either a
# service name (which is the same everywhere) or the IETF's documentation
# address block, which routes nowhere on purpose.
# ---------------------------------------------------------------------------

# --- the release image ------------------------------------------------------
# The tested image, by tag or digest. There is no default anywhere: the
# compose file refuses by name if this is unset, because an image that
# defaults to 'latest' silently downgraded production on 24 September 2026.
FORGE_IMAGE=forge:2026.09.24-4

# --- the one machine address ------------------------------------------------
# CHANGE THIS. The FACTORY GATEWAY ADDRESS: the single address on this machine
# that everything crossing the sandbox boundary uses. A sandbox is a separate
# small machine with its own engine, so a service name never reaches it; this
# address is how the coordinator reaches into a sandbox and how a sandbox
# reaches the answer service, the bus, the model router and the memory
# service.
#
# Prefer a private host bridge address and PROVE all three paths before
# trusting it (Docker's 'host-gateway' normally identifies the default bridge,
# not a custom one). Never 0.0.0.0 and never blank: either publishes on the
# local network. Every port published on it is permitted PER ROUTE - this
# listener, this port, this allowed source - and refused to every other
# caller, the local network included.
#
# The value below is 192.0.2.1, the IETF's TEST-NET-1 documentation address
# (RFC 5737). It routes nowhere, it belongs to no machine, and it is here only
# so this example renders and can be checked. Leave it and nothing will
# publish; that is the safe failure.
FACTORY_GATEWAY_ADDRESS=192.0.2.1

# --- the bus ----------------------------------------------------------------
# A SERVICE NAME on the 'factory' network, not an address. The bus's own
# compose file (the estate bundle composes it alongside this one) gives the
# service that name.
FORGE_NATS_URL=nats://nats:4222

# --- the answer service -----------------------------------------------------
# The port the read-only answer is published on, at the factory gateway
# address. A project's deploy helper is given the whole of it as
# FORGE_TARGET_OWNER_URL, with the route on the end:
#   http://${FACTORY_GATEWAY_ADDRESS}:${FORGE_ANSWER_PORT}/recorded
FORGE_ANSWER_PORT=8126

# --- into a project's sandbox -----------------------------------------------
# CHANGE THESE TWO PORTS to the ports that project's sandbox publishes its
# deploy helper and its build runner on. The addresses themselves are built
# out of the gateway address above, so there is only ever one machine address
# in this file.
FORGE_SANDBOX_SIDECAR_PORT=8125
FORGE_SANDBOX_RUNNER_PORT=8124
FORGE_SANDBOX_SIDECAR_URL=http://${FACTORY_GATEWAY_ADDRESS}:${FORGE_SANDBOX_SIDECAR_PORT}
FORGE_SANDBOX_RUNNER_URL=http://${FACTORY_GATEWAY_ADDRESS}:${FORGE_SANDBOX_RUNNER_PORT}
# What the coordinator dispatches a build to. The same runner, named
# separately because the coordinator reads it under its own long-standing
# setting name.
FORGE_AUTOBUILD_RUNNER_URL=${FORGE_SANDBOX_RUNNER_URL}

# --- the publisher ----------------------------------------------------------
# A SERVICE NAME on the publisher's own network, which only the coordinator
# joins. The publisher publishes no port and is not reachable from this
# machine at all.
FORGE_PUBLISHER_URL=http://forge-publisher:8711

# The publisher's own tested image, by tag or digest. It is a SEPARATE image
# from the coordinator's on purpose: it holds the one credential that can
# write to a project's remote, and an image of its own is what makes that
# wall real. Nothing here ever builds it.
#
# FROM RELEASE 2026.09.24-4 IT IS REALLY BUILT: the release manifest lists
# both images and one run of the release script builds them from the same
# fetched commits, so this tag and the one above are the same release said
# twice and should always be moved together. Before that release the publisher
# could only run from the coordinator's image with its own start line, which
# was a stand-in and not the tested arrangement.
FORGE_PUBLISHER_IMAGE=forge-publisher:2026.09.24-4

# CHANGE THIS. The publisher's own settings file on this machine - which
# projects, which read-only source address, which remote. Start from
# src/forge/publisher/settings.sample.json. It holds NO secret: only the path
# of the file the credential is in, which is the next line.
FORGE_PUBLISHER_SETTINGS_FILE=/etc/forge/publisher-settings.json

# CHANGE THIS IF YOUR MACHINE PUTS SECRET FILES SOMEWHERE ELSE. The one file
# the publisher's credential is in. It is mounted read-only into the publisher
# and into nothing else in this estate. Its CONTENTS never appear in any file
# here, in any image, or in any log.
FORGE_PUBLISHER_CREDENTIAL_FILE=/run/secrets/forge-publisher-credential

# The ledger as the publisher reads it: read-only, the FOLDER and not the one
# file (the store keeps companion files beside the record). Naming the volume
# here rather than a folder on disk is what keeps the publisher reading the
# same record the coordinator writes.
FORGE_LEDGER_DIR=forge-ledger

# --- how loud ---------------------------------------------------------------
FORGE_LOG_LEVEL=info

# ===========================================================================
# ONE PROJECT'S SANDBOX (compose.sandbox-runner.yaml)
#
# Only needed on a machine that looks after a project's sandbox. That file
# replaces the two host units forge-sandbox-keeper@ and forge-sandbox-runner@.
# Compose the two files together:
#
#   docker compose --env-file .env -f compose.yaml \
#       -f compose.sandbox-runner.yaml up -d
# ===========================================================================

# --- the two things of this machine the service is given --------------------
# CHANGE BOTH. They are the only host paths in this file, and the only ones in
# the bundle: the sandbox daemon makes the sandboxes, so it is the host, and
# this service talks to it over its socket with its own static client binary.
#
# 'sbx daemon status' prints where the socket really is on this machine. On an
# ordinary Linux install it sits under the owning user's own state folder; the
# value below is a placeholder that belongs to no machine, and the service
# refuses at the door, in one sentence, if nothing is there.
SBX_BINARY_PATH=/usr/bin/sbx
SANDBOXD_SOCKET_PATH=/run/sandboxes/sandboxd/sandboxd.sock

# CHANGE THESE IF THIS MACHINE'S FIRST USER IS NOT 1000. The daemon's socket is
# owner-only, so the container runs as the user that owns it. This is the one
# service in the bundle that does not run as the image's own user.
FACTORY_HOST_UID=1000
FACTORY_HOST_GID=1000

# --- which sandbox, and what runs in it -------------------------------------
# CHANGE THESE TWO. The name the project declares for its sandbox, and the
# command that project's sandbox runs — the project's own bootstrap, exactly as
# it is invoked today. The service knows nothing else about it.
SANDBOX_NAME=my-project-deploy
SANDBOX_BOOTSTRAP=deploy/sandbox-runner.sh

# The word that bootstrap takes to stop itself. The stop goes through the same
# door as the start, and this one word is all that is known about it out here —
# no process names, no ports. A bootstrap that does NOT take this word must not
# be run under this service: an older one ignores the word and starts a SECOND
# supervisor instead. README.md says how to check before you start.
SANDBOX_BOOTSTRAP_STOP_ARGUMENT=stop

# How long each stop inside the sandbox is given, how many times it is tried
# and how long between tries, and how long Docker waits for the whole stop.
# The grace period must stay above the worst case, ATTEMPTS x (TIMEOUT +
# RETRY) + TIMEOUT for the hold: with these values 3 x (45 + 5) + 45 = 195s,
# so 210s. Change one, change the others, or Docker kills the container
# mid-retry and the plain sentence about the work still running is lost.
SANDBOX_STOP_TIMEOUT_SECONDS=45
SANDBOX_STOP_ATTEMPTS=3
SANDBOX_STOP_RETRY_SECONDS=5
SANDBOX_STOP_GRACE_PERIOD=210s
SANDBOX_RESTART_SECONDS=5

# Anything the client needs before the verb, e.g. a flag pinning it to the
# daemon on this machine rather than a hosted service. Usually empty.
SANDBOX_CLIENT_ARGUMENTS=

# --- the names that project's bootstrap is handed ---------------------------
# THE LIST BELONGS TO THE PROJECT, NOT TO THE FACTORY. The service forwards the
# names below and never reads a value; a name with nothing set is left out, and
# the bootstrap reports it unset. The list is what the live machine's unit
# drop-in had baked into one start line on 17 September 2026, as values
# written into a file that had to be edited per machine (14 names below; the
# design's row said eleven from memory, and this list is the one that counts). Here each is a name,
# and the compose file names none of them: it hands this whole file to the
# service, which forwards the names listed here and nothing else.
#
# The names here are the factory's own (its build system's settings, the
# sandbox's copies of the factory code, the model router) and nothing else. A
# project's own toolchain names — a package manager's cache folder, say — do
# not belong in this shipped file: the project adds them to the machine's own
# .env and to this list, as the review of 24 September 2026 asked.
SANDBOX_ENV_NAMES=SANDBOX_FORGE_PATH SANDBOX_GUARDKIT_PATH OPENAI_BASE_URL GUARDKIT_LOCAL_SEAT_HOSTS GUARDKIT_HARNESS GUARDKIT_AUTOBUILD_PRESERVE_DEBUG GUARDKIT_SDK_TIMEOUT GUARDKIT_AUTOBUILD_TASK_TIMEOUT_FLOOR FORGE_AUTOBUILD_WORKTREE_BASE TMPDIR FLEET_MEMORY_EMBED_URL GUARDKIT_QAV_SHADOW_URL GUARDKIT_QAV_PROBE_URL FORGE_TARGET_OWNER_URL

# Which file those names and values are in. By default the .env you are
# reading; point it elsewhere to keep a project's own settings in a file of
# their own. Whatever is in it arrives in the service's environment; only the
# names listed above cross into the sandbox.
SANDBOX_PROJECT_ENV_FILE=.env

# Where that project's sandbox has the factory's own checkouts mounted, and
# where it keeps its scratch space. Paths INSIDE the sandbox, not on this
# machine. Left empty they are not handed in and the bootstrap uses its own
# defaults.
SANDBOX_FORGE_PATH=
SANDBOX_GUARDKIT_PATH=
FORGE_AUTOBUILD_WORKTREE_BASE=
# TMPDIR is a path inside the sandbox, but the name is also meaningful to the
# service's own container, which will use it for its own temporary files.
# Leave it empty unless the project needs it, and if it is set, set it to a
# folder that exists in both.
TMPDIR=

# The addresses that project's sandbox reaches back out to. Each is built from
# the one machine address at the top of this file, because a sandbox is a
# separate small machine and the factory gateway address is the whole of the
# boundary. Fill in the ports this machine publishes them on.
OPENAI_BASE_URL=
GUARDKIT_LOCAL_SEAT_HOSTS=
FLEET_MEMORY_EMBED_URL=
GUARDKIT_QAV_SHADOW_URL=
GUARDKIT_QAV_PROBE_URL=
# The read-only "what commit did this build start from" answer, at the gateway
# address and the answer service's port above. With nothing here the deploy
# helper inside the sandbox refuses every deploy that names a commit, which is
# the safe side.
FORGE_TARGET_OWNER_URL=http://${FACTORY_GATEWAY_ADDRESS}:${FORGE_ANSWER_PORT}/recorded

# That project's own dials. Values, not names, are the project's to choose.
GUARDKIT_HARNESS=
GUARDKIT_AUTOBUILD_PRESERVE_DEBUG=
GUARDKIT_SDK_TIMEOUT=
GUARDKIT_AUTOBUILD_TASK_TIMEOUT_FLOOR=
