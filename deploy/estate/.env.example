# ===========================================================================
# EVERY NAME THE ESTATE NEEDS. Copy this file to '.env' beside it and fill in
# the lines marked CHANGE THIS. This file is the whole of the difference
# between a clean laptop and a cloud machine: three lines differ, and README.md
# says which three.
#
# NO VALUE BELOW BELONGS TO ANY MACHINE. Where an example value is needed so
# that 'docker compose config' renders and can be checked, it is either a
# service name (the same everywhere), a path inside a container (the same
# everywhere), or the IETF's documentation address block (RFC 5737), which
# routes nowhere on purpose.
#
# NO SECRET IS IN THIS FILE AND NONE BELONGS IN .env EITHER. What is here is
# the PATH of the file a secret lives in, and the NAMES of the values a
# password reaches the estate under. The values themselves are passed into the
# command from a child process — see "The bus's account passwords" below.
# ===========================================================================


# ---------------------------------------------------------------------------
# THE RELEASE
# ---------------------------------------------------------------------------
# The four images this estate runs, all at one release version. There is no
# default anywhere: an image that defaults to 'latest' silently downgraded
# production on 24 September 2026.
#
# The first two are built by ../../scripts/build-release-image.sh from
# ../../release/manifest.yaml. The other two are built by
# ./build-estate-images.sh from ./estate-pins.conf — the bus from the bus
# repository's own Dockerfile at a pinned commit, and the one-shot that
# provisions the bus's storage. A test holds all four of these lines to the
# manifest's version, so the release cannot move without them.
FORGE_IMAGE=forge:2026.09.24-7
FORGE_PUBLISHER_IMAGE=forge-publisher:2026.09.24-7
NATS_IMAGE=factory-nats:2026.09.24-7
NATS_PROVISION_IMAGE=factory-nats-provision:2026.09.24-7

# The volume holding the bus repository's own config and provisioning scripts
# at that same pin. ./build-estate-images.sh makes it and prints its name. It
# is part of the release, not of a run, so 'down -v' leaves it alone and
# 'docker volume rm' is what removes it.
BUS_SOURCE_VOLUME=factory-bus-source-2026.09.24-7


# ---------------------------------------------------------------------------
# THE ONE MACHINE ADDRESS
# ---------------------------------------------------------------------------
# CHANGE THIS. The FACTORY GATEWAY ADDRESS: the single address on this machine
# that everything crossing the sandbox boundary uses. A sandbox is a separate
# small machine with its own engine, so a service name never reaches it; this
# address is how the coordinator reaches into a sandbox and how a sandbox
# reaches the answer service and the bus.
#
# Prefer a private host bridge address and PROVE all three paths before
# trusting it (Docker's 'host-gateway' normally identifies the default bridge,
# not a custom one). Never 0.0.0.0 and never blank: either publishes on the
# local network.
#
# The per-route refusal rule — this listener, this port, this allowed source,
# refused to everything else including the local network — is NOT enforced by
# this bundle yet. README.md lists it as a rollout precondition. Until it is,
# use a private address of this machine.
#
# The value below is 192.0.2.1, the IETF's TEST-NET-1 documentation address
# (RFC 5737). It routes nowhere and belongs to no machine; it is here only so
# this example renders and can be checked. Leave it and nothing will publish,
# which is the safe failure.
FACTORY_GATEWAY_ADDRESS=192.0.2.1


# ---------------------------------------------------------------------------
# THE BUS
# ---------------------------------------------------------------------------
# What the coordinator is given. A SERVICE NAME on the 'factory' network, with
# the account it connects as. The password is not written here: the ${NAME}
# below is filled in from the environment the 'docker compose' command was run
# in, and is empty unless that command was run the way README.md says.
#
# This one address is still built with the password in it, because the
# coordinator reads its bus address from one setting and that is Forge's own
# code, not this bundle's. It means the coordinator's container environment
# carries a password where 'docker inspect' can read it. The bus's own eight
# and the provisioning account's are handled the other way — as files, see
# below — and the coordinator's is recorded in README.md as work of its own.
FORGE_NATS_URL=nats://forge:${FORGE_NATS_PASSWORD}@nats:4222

# The port the bus is published on, at the factory gateway address, so a
# project's sandbox can reach it. The bus's monitoring port is deliberately not
# published: the estate's own check asks for it from inside the network.
NATS_CLIENT_PORT=4222

# WHERE THE ONE-SHOT PROVISIONS THE BUS'S STORAGE, and as whom. Three lines,
# and NOT one address with a credential in it, because the bus repository's two
# provisioning scripts PRINT the address they are given — so an address of the
# nats://user:password@host form put the password into that container's log at
# every start, on every machine (found by the review on 24 September 2026).
#
# The address below is therefore a plain service name, safe to print. The
# account's password is handed to the container as a FILE and written into the
# nats client's own context file; the third line says which of the bus's eight
# password names that account's password is under, so it is always one of the
# eight the bus itself is given.
#
# The account needs JetStream rights; the bus repository's own accounts file
# says which accounts have them.
NATS_PROVISION_ADDRESS=nats://nats:4222
NATS_PROVISION_USER=rich
NATS_PROVISION_PASSWORD_NAME=RICH_NATS_PASSWORD

# --- the bus's account passwords -------------------------------------------
# CHANGE THIS PATH. The one file the bus's eight account passwords live in,
# encrypted. Its CONTENTS never appear in any file here, in any image or in any
# log, and this bundle never decrypts it: the command does.
#
#   sops exec-env "$NATS_SECRETS_FILE" 'docker compose --env-file .env up -d'
#
# That runs compose as a CHILD PROCESS with the eight values in its
# environment, and compose hands each one to the bus AS A FILE — not as a
# container environment variable, where 'docker inspect' would show it to
# anybody who can reach the Docker daemon. The bus repository chose the child
# process over an env_file and the reason is worth keeping: an env_file whose
# values were still encrypted would feed ciphertext through the template
# renderer and produce a broker with unusable accounts, whereas this way a
# value can only ever be a real one. A bare 'up' fails loudly instead, naming
# the variable nothing set.
#
# READING the estate needs none of them: 'docker compose config' and 'ps', and
# so 'estate-check services' and 'factory-hello', render this bundle in a clean
# shell. Only starting it needs the values, and so does 'estate-check host',
# which checks that they have them.
#
# THE EIGHT NAMES, so 'estate-check host' can say whether each has a value
# without ever printing one:
#
#   ADMIN_NATS_PASSWORD  RICH_NATS_PASSWORD   JAMES_NATS_PASSWORD
#   MARK_NATS_PASSWORD   FORGE_NATS_PASSWORD  FLEET_MEMORY_NATS_PASSWORD
#   GUARDKIT_NATS_PASSWORD  JARVIS_NATS_PASSWORD
#
# None of them is set below, on purpose.
NATS_SECRETS_FILE=/etc/factory/secrets/bus-accounts.enc.env


# ---------------------------------------------------------------------------
# THE ANSWER SERVICE
# ---------------------------------------------------------------------------
# The port the read-only answer is published on, at the factory gateway
# address. A project's deploy helper inside its sandbox is given the whole of
# it as FORGE_TARGET_OWNER_URL, with the route on the end.
FORGE_ANSWER_PORT=8126


# ---------------------------------------------------------------------------
# INTO A PROJECT'S SANDBOX
# ---------------------------------------------------------------------------
# CHANGE THESE TWO PORTS to the ports that project's sandbox publishes its
# deploy helper and its build runner on. The addresses are built out of the one
# gateway address above.
FORGE_SANDBOX_SIDECAR_PORT=8125
FORGE_SANDBOX_RUNNER_PORT=8124
FORGE_SANDBOX_SIDECAR_URL=http://${FACTORY_GATEWAY_ADDRESS}:${FORGE_SANDBOX_SIDECAR_PORT}
FORGE_SANDBOX_RUNNER_URL=http://${FACTORY_GATEWAY_ADDRESS}:${FORGE_SANDBOX_RUNNER_PORT}
# What the coordinator dispatches a build to. The same runner, named separately
# because the coordinator reads it under its own long-standing setting name.
FORGE_AUTOBUILD_RUNNER_URL=${FORGE_SANDBOX_RUNNER_URL}


# ---------------------------------------------------------------------------
# THE PUBLISHER
# ---------------------------------------------------------------------------
# A SERVICE NAME on the publisher's own network, which only the coordinator
# joins. The publisher publishes no port and is not reachable from this machine
# at all.
FORGE_PUBLISHER_URL=http://forge-publisher:8711

# CHANGE THIS. The publisher's own settings file on this machine — which
# projects, which read-only source address, which remote. Start from
# ../../src/forge/publisher/settings.sample.json. It holds NO secret: only the
# path of the file the credential is in, which is the next line.
FORGE_PUBLISHER_SETTINGS_FILE=/etc/factory/publisher-settings.json

# CHANGE THIS IF YOUR MACHINE PUTS SECRET FILES SOMEWHERE ELSE. The one file
# the publisher's credential is in. It is mounted read-only into the publisher
# and into nothing else.
FORGE_PUBLISHER_CREDENTIAL_FILE=/etc/factory/secrets/publisher-credential

# The ledger as the publisher reads it: read-only, the FOLDER and not the one
# file. Naming the volume here rather than a folder on disk is what keeps the
# publisher reading the same record the coordinator writes.
FORGE_LEDGER_DIR=forge-ledger


# ---------------------------------------------------------------------------
# HOW LOUD
# ---------------------------------------------------------------------------
FORGE_LOG_LEVEL=info


# ===========================================================================
# WHAT 'estate-check host' LOOKS FOR
#
# Thresholds and names, so the check is a check of THIS machine against THIS
# release and not against a number somebody remembered.
# ===========================================================================

# The sandbox tool's version this release was proven against. The check reports
# the machine's version and says so plainly when it differs; it does not guess
# whether a different one is compatible.
ESTATE_SBX_VERSION=v0.42.1

# How much free disk the check insists on, in gigabytes, where Docker keeps its
# volumes. A sandbox and a release's images need room; a machine that runs out
# mid-build fails in ways that look like anything but a full disk.
ESTATE_DISK_FREE_GB=40

# The operating systems and processor architectures a sandbox is supported on,
# as 'system/arch' pairs separated by spaces. Docker's sandbox install page for
# the version above is where this list comes from.
ESTATE_SUPPORTED_PLATFORMS=Linux/x86_64 Linux/aarch64 Darwin/arm64

# Every file the estate expects to hold a secret, as PATH:USER-ID pairs
# separated by spaces. The check says whether each exists and whether anybody
# but THAT user can read it. It never opens one and never prints anything out
# of one.
#
# THE USER ID IS PER FILE, because the design asks for each secret file to be
# readable by its own service's user and by nobody else, and those users are
# not all the same thing:
#
#   the bus's accounts file    is never mounted into a container at all. It is
#                              decrypted on this machine by the person or the
#                              account that starts the estate, so its owner is
#                              the OPERATOR below;
#   the publisher's credential is mounted read-only into the publisher, which
#                              runs as its own image's user, so it must be
#                              owned by THAT user id — and not be readable by
#                              anything else on the machine.
#
# On an ordinary single-user machine today both come out as 1000 and the
# distinction costs nothing. It stops costing nothing the first time the estate
# runs somewhere the publisher is not the operator, which is the cloud machine.
# A path with no user id after it is checked against the operator's, and the
# check says that is what it did.
# The two user ids are named FIRST, because the line below is built out of
# them and a value is built out of what is above it.
#
# The user id that starts the estate on this machine and decrypts the bus's
# accounts file.
ESTATE_OPERATOR_UID=1000

# The user id the publisher's image runs as. 'docker image inspect' of the
# publisher image names the user; it is 'publisher', uid 1000, in the images
# this release builds.
FORGE_PUBLISHER_UID=1000

ESTATE_SECRET_FILES=${NATS_SECRETS_FILE}:${ESTATE_OPERATOR_UID} ${FORGE_PUBLISHER_CREDENTIAL_FILE}:${FORGE_PUBLISHER_UID}

# --- what else the estate would reach, when it is there --------------------
# Neither the memory service nor a model seat is in this bundle yet (README.md
# says so). Give either an address and 'estate-check services' will ask it;
# leave it empty and the check says there is nothing named to ask.
FLEET_MEMORY_URL=
MODEL_SEAT_URL=


# ===========================================================================
# ONE PROJECT'S SANDBOX (../compose/compose.sandbox-runner.yaml)
#
# Only needed on a machine that looks after a project's sandbox. That file
# replaces the two host units forge-sandbox-keeper@ and forge-sandbox-runner@.
# It carries a profile, so 'docker compose up' leaves it alone and a machine
# that has a sandbox says:
#
#   docker compose --env-file .env --profile sandbox up -d
# ===========================================================================

# --- the two things of this machine the service is given --------------------
# CHANGE BOTH. They are the only paths of this machine in the running estate,
# and the reason is that the sandbox daemon makes the sandboxes, so it IS the
# host: this service talks to it over its socket with its own static client
# binary.
#
# 'sbx daemon status' prints where the socket really is on this machine. On an
# ordinary Linux install it sits under the owning user's own state folder; the
# value below is a placeholder that belongs to no machine, and the service
# refuses at the door, in one sentence, if nothing is there.
SBX_BINARY_PATH=/usr/bin/sbx
SANDBOXD_SOCKET_PATH=/run/sandboxes/sandboxd/sandboxd.sock

# CHANGE THESE IF THIS MACHINE'S FIRST USER IS NOT 1000. The daemon's socket is
# owner-only, so the container runs as the user that owns it. This is the one
# service in the estate that does not run as the image's own user.
FACTORY_HOST_UID=1000
FACTORY_HOST_GID=1000

# --- which sandbox, and what runs in it -------------------------------------
# CHANGE THESE TWO. The name the project declares for its sandbox, and the
# command that project's sandbox runs — the project's own bootstrap, exactly as
# it is invoked today. The service knows nothing else about it.
#
# SANDBOX_NAME is also what 'estate-check services' uses for item 9, the one
# item this bundle cannot yet prove: the answer service reached FROM INSIDE a
# sandbox. Leave it as it is, or on a machine with no sandbox leave it empty,
# and the check says plainly that the item was not checked and counts it as
# NOT PASSED.
SANDBOX_NAME=my-project-deploy
SANDBOX_BOOTSTRAP=deploy/sandbox-runner.sh

# The word that bootstrap takes to stop itself. A bootstrap that does NOT take
# this word must not be run under this service: an older one ignores the word
# and starts a SECOND supervisor instead. ../compose/README.md says how to
# check before you start.
SANDBOX_BOOTSTRAP_STOP_ARGUMENT=stop

# How long each stop inside the sandbox is given, how many times it is tried
# and how long between tries, and how long Docker waits for the whole stop.
# The grace period must stay above the worst case, ATTEMPTS x (TIMEOUT +
# RETRY) + TIMEOUT for the hold: with these values 3 x (45 + 5) + 45 = 195s,
# so 210s. Change one, change the others.
SANDBOX_STOP_TIMEOUT_SECONDS=45
SANDBOX_STOP_ATTEMPTS=3
SANDBOX_STOP_RETRY_SECONDS=5
SANDBOX_STOP_GRACE_PERIOD=210s
SANDBOX_RESTART_SECONDS=5

# Anything the client needs before the verb, e.g. a flag pinning it to the
# daemon on this machine rather than a hosted service. Usually empty.
SANDBOX_CLIENT_ARGUMENTS=

# --- the names that project's bootstrap is handed ---------------------------
# THE LIST BELONGS TO THE PROJECT, NOT TO THE FACTORY. The service forwards the
# names below and never reads a value; a name with nothing set is left out, and
# the bootstrap reports it unset. A project with a different toolchain writes a
# different list here and nothing in the factory changes.
# This list is the SAME as deploy/compose/.env.example's, because the estate composes
# that bundle in; the stage 4f review found the two had drifted (the bootstrap now
# requires FORGE_IMAGE and FORGE_IMAGE_IDENTITY, which this copy did not forward).
SANDBOX_ENV_NAMES=FORGE_IMAGE FORGE_IMAGE_IDENTITY FORGE_RELEASE_VERSION FORGE_RELEASE_MANIFEST_SHA256 FORGE_TARGET_OWNER_URL FORGE_NATS_URL FACTORY_GATEWAY_ADDRESS SANDBOX_CONTAINER_ENV_NAMES SANDBOX_RECEIPTS_PATH OPENAI_BASE_URL GUARDKIT_LOCAL_SEAT_HOSTS GUARDKIT_HARNESS GUARDKIT_AUTOBUILD_PRESERVE_DEBUG GUARDKIT_SDK_TIMEOUT GUARDKIT_AUTOBUILD_TASK_TIMEOUT_FLOOR FORGE_AUTOBUILD_WORKTREE_BASE FORGE_DEPLOY_NOTES_DIR TMPDIR FLEET_MEMORY_EMBED_URL GUARDKIT_QAV_SHADOW_URL GUARDKIT_QAV_PROBE_URL

# Which file those names and values are in. It is read by the sandbox service,
# whose compose file lives one folder over, so the path is written from THERE
# and not from here. Point it elsewhere to keep a project's own settings in a
# file of their own.
SANDBOX_PROJECT_ENV_FILE=../estate/.env

# Where that project's sandbox has the factory's own copies mounted, and where
# it keeps its scratch space. Paths INSIDE the sandbox, not on this machine.
# Left empty they are not handed in and the bootstrap uses its own defaults.
SANDBOX_FORGE_PATH=
SANDBOX_GUARDKIT_PATH=
FORGE_AUTOBUILD_WORKTREE_BASE=
# Where the deploy helper inside the sandbox writes its executor notes — one
# per deployment target, saying what it is running and under which counter, so
# that a helper which has just been replaced does not come back to an empty
# slot while the deploy command it started is still running (24 September
# 2026, stage 4f). It is a folder of the sandbox, made by the bootstrap and
# bound into both of that sandbox's containers. Left empty, the bootstrap names
# one under its own state in the sandbox rather than let the notes sit inside a
# container and go with it.
FORGE_DEPLOY_NOTES_DIR=

# --- what the release image IS, for the sandbox's own checks -------------------
# ../estate/hand-release-image-to-sandbox.sh <sandbox> <version> prints these
# when it has finished carrying the image in; the bootstrap inside the sandbox
# checks them again before it runs anything from the image, and refuses by name
# if they do not match. FORGE_IMAGE is the release image named at the top of this
# file. FORGE_IMAGE_IDENTITY is the image's whole identity — platform, filesystem
# and runtime configuration hashed as one — which both kinds of engine answer the
# same way and no tag can change (see deploy/compose/.env.example for the long
# note). These lines were missing here until the stage 4f review of 24 September
# 2026, which found this copy's forwarded list had drifted from the bundle's.
FORGE_IMAGE_IDENTITY=
FORGE_RELEASE_VERSION=
FORGE_RELEASE_MANIFEST_SHA256=

# Extra setting names the PROJECT's own services need inside its sandbox, space
# or comma separated. The factory's own names are built into the bootstrap; this
# is where a project adds its own.
SANDBOX_CONTAINER_ENV_NAMES=

# Where a project's receipts land inside its sandbox, if its own deploy profile
# points somewhere of its own; left empty, the bootstrap's own folder is used.
SANDBOX_RECEIPTS_PATH=
# TMPDIR is a path inside the sandbox, but the name is also meaningful to the
# service's own container. Leave it empty unless the project needs it.
TMPDIR=

# The addresses that project's sandbox reaches back out to. Each is built from
# the one machine address at the top of this file. Fill in the ports this
# machine publishes them on.
OPENAI_BASE_URL=
GUARDKIT_LOCAL_SEAT_HOSTS=
FLEET_MEMORY_EMBED_URL=
GUARDKIT_QAV_SHADOW_URL=
GUARDKIT_QAV_PROBE_URL=
# The read-only "what commit did this build start from" answer, at the gateway
# address and the answer service's port above. With nothing here the deploy
# helper inside the sandbox refuses every deploy that names a commit, which is
# the safe side.
FORGE_TARGET_OWNER_URL=http://${FACTORY_GATEWAY_ADDRESS}:${FORGE_ANSWER_PORT}/recorded

# That project's own dials. Values, not names, are the project's to choose.
GUARDKIT_HARNESS=
GUARDKIT_AUTOBUILD_PRESERVE_DEBUG=
GUARDKIT_SDK_TIMEOUT=
GUARDKIT_AUTOBUILD_TASK_TIMEOUT_FLOOR=
