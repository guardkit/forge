#!/usr/bin/env python3
"""Own the one nftables policy that blocks host access to the publisher.

The policy is deliberately fixed.  Project identity selects its names; callers
cannot supply rules, ports, interfaces, paths, or arbitrary Docker endpoints.
"""
from __future__ import annotations

import argparse
import fcntl
import hashlib
import json
import os
from pathlib import Path
import re
import shutil
import stat
import subprocess
import sys
import tempfile
from typing import Any

PORT = 8711
DOCKER_HOST = "unix:///var/run/docker.sock"
CONFIG_DIR = Path("/etc/forge-publisher-policy")
HELPER = Path("/usr/local/libexec/forge-publisher-host-policy")
UNIT = Path("/etc/systemd/system/forge-publisher-host-policy@.service")
DROPIN_DIR = Path("/etc/systemd/system/docker.service.d")
LOCK_DIR = Path("/run/lock")
PROJECT_RE = re.compile(r"[a-z0-9][a-z0-9_-]{1,62}")


class Refusal(Exception):
    pass


def refuse(message: str) -> None:
    raise Refusal(message)


def binding(project: str) -> dict[str, str]:
    if not PROJECT_RE.fullmatch(project):
        refuse("project must be an explicit 2-63 character lower-case Compose project name")
    suffix = hashlib.sha256(project.encode("utf-8")).hexdigest()[:12]
    return {
        "project": project,
        "suffix": suffix,
        "bridge": f"fpb{suffix}",
        "table": f"forge_pub_{suffix}",
        "network": f"{project}_forge-publisher-net",
    }


def nft_text(bound: dict[str, str]) -> str:
    return (
        f"table inet {bound['table']} {{\n"
        "    chain host_output {\n"
        "        type filter hook output priority -5; policy accept;\n"
        f"        oifname \"{bound['bridge']}\" meta l4proto tcp tcp dport {PORT} ct direction reply return\n"
        f"        oifname \"{bound['bridge']}\" meta l4proto tcp tcp dport {PORT} counter drop\n"
        "    }\n"
        "}\n"
    )


def specification(bound: dict[str, str]) -> dict[str, Any]:
    spec = {
        "family": "inet", "table": bound["table"], "chain": "host_output",
        "hook": "output", "priority": -5, "policy": "accept",
        "rules": [
            ["oifname", bound["bridge"], "l4proto", "tcp", "dport", PORT,
             "ct-direction", "reply", "return"],
            ["oifname", bound["bridge"], "l4proto", "tcp", "dport", PORT,
             "counter", "drop"],
        ],
    }
    packed = json.dumps(spec, sort_keys=True, separators=(",", ":")).encode()
    return {**spec, "sha256": hashlib.sha256(packed).hexdigest()}


def clean_docker_env(host: str) -> dict[str, str]:
    if host != DOCKER_HOST:
        refuse(f"only the local rootful endpoint {DOCKER_HOST} is supported")
    ambient = os.environ.get("DOCKER_HOST")
    if ambient and ambient != host:
        refuse("ambient DOCKER_HOST conflicts with --docker-host")
    for name in ("DOCKER_CONTEXT", "DOCKER_TLS_VERIFY", "DOCKER_CERT_PATH"):
        if os.environ.get(name):
            refuse(f"{name} selects a different Docker endpoint; unset it")
    env = {"PATH": os.environ.get("PATH", "/usr/sbin:/usr/bin:/sbin:/bin"), "DOCKER_HOST": host}
    if os.environ.get("DOCKER_CONFIG"):
        env["DOCKER_CONFIG"] = os.environ["DOCKER_CONFIG"]
    return env


def run(argv: list[str], *, input_text: str | None = None,
        env: dict[str, str] | None = None, check: bool = True) -> subprocess.CompletedProcess[str]:
    try:
        result = subprocess.run(argv, input=input_text, text=True, capture_output=True,
                                env=env, timeout=60, check=False)
    except OSError as exc:
        refuse(f"cannot run {Path(argv[0]).name} ({type(exc).__name__})")
    if check and result.returncode:
        refuse(f"{Path(argv[0]).name} refused the requested operation (exit {result.returncode})")
    return result


def docker_json(host: str, *args: str) -> Any:
    result = run(["docker", "--host", host, *args], env=clean_docker_env(host))
    try:
        data = json.loads(result.stdout)
    except json.JSONDecodeError:
        refuse("Docker returned unreadable identity data")
    if args[0] == "info":
        if not isinstance(data, dict): refuse("Docker info must be an object")
    elif not isinstance(data, list) or len(data) != 1 or not isinstance(data[0], dict):
        refuse("Docker inspection must return exactly one object")
    return data


def docker_rows(host: str, *args: str) -> list[dict[str, Any]]:
    result = run(["docker", "--host", host, *args, "--format", "{{json .}}"], env=clean_docker_env(host))
    rows = []
    for line in result.stdout.splitlines():
        try: row = json.loads(line)
        except json.JSONDecodeError: refuse("Docker list returned a malformed JSON line")
        if not isinstance(row, dict) or not isinstance(row.get("ID"), str) or not row["ID"]:
            refuse("Docker list returned an invalid object identity")
        if args[:2] == ("network", "ls") and (not isinstance(row.get("Name"), str) or not row["Name"]):
            refuse("Docker network list returned an invalid name")
        rows.append(row)
    return rows


def read_env(path: Path) -> dict[str, str]:
    if not path.is_absolute() or not path.is_file() or path.is_symlink():
        refuse("--env-file must be an absolute regular file, without a symlink")
    values: dict[str, str] = {}
    for raw in path.read_text(encoding="utf-8").splitlines():
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        key, sep, value = line.partition("=")
        if not sep or not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", key.strip()):
            refuse("estate env file contains an invalid assignment")
        values[key.strip()] = value.strip().strip("'\"")
    return values


def validate_env(path: Path, bound: dict[str, str]) -> None:
    values = read_env(path)
    if values.get("FORGE_PUBLISHER_BRIDGE") != bound["bridge"]:
        refuse("FORGE_PUBLISHER_BRIDGE does not match the explicit Compose project")
    if values.get("FORGE_PUBLISHER_URL") != f"http://forge-publisher:{PORT}":
        refuse("FORGE_PUBLISHER_URL must be http://forge-publisher:8711")
    settings = values.get("FORGE_PUBLISHER_SETTINGS_FILE", "")
    if not settings or not Path(settings).is_absolute():
        refuse("FORGE_PUBLISHER_SETTINGS_FILE must name the absolute publisher settings file")
    settings_identity(Path(settings))


def settings_identity(path: Path) -> dict[str, Any]:
    if not path.is_absolute() or path.is_symlink() or not path.is_file():
        refuse("publisher settings must be an absolute regular file without symlinks")
    try:
        raw = path.read_bytes(); payload = json.loads(raw)
    except (OSError, json.JSONDecodeError):
        refuse("publisher settings cannot be read as JSON")
    if not isinstance(payload, dict) or payload.get("host") != "0.0.0.0" or payload.get("port") != PORT:
        refuse("publisher settings must listen on 0.0.0.0:8711")
    return {"host": "0.0.0.0", "port": PORT, "sha256": hashlib.sha256(raw).hexdigest()}


def settings_mount(mounts: Any, *, rendered: bool) -> Path:
    target, source, kind = ("target", "source", "type") if rendered else ("Destination", "Source", "Type")
    if not isinstance(mounts, list): refuse("publisher settings mount is unreadable")
    rows = [x for x in mounts if isinstance(x, dict) and x.get(target) == "/etc/forge-publisher/settings.json"]
    if len(rows) != 1 or rows[0].get(kind) != "bind" or not isinstance(rows[0].get(source), str):
        refuse("publisher must have exactly one declared settings bind mount")
    if (rows[0].get("read_only") is not True if rendered else rows[0].get("RW") is not False):
        refuse("publisher settings mount must be read-only")
    return Path(rows[0][source])


def verify_publisher_settings(host: str, identifier: str, expected: Path) -> None:
    container = docker_json(host, "inspect", identifier)[0]
    mounted = settings_mount(container.get("Mounts"), rendered=False)
    if mounted != expected: refuse("running publisher settings mount differs from the validated env file")
    identity = settings_identity(mounted)
    if container.get("State", {}).get("Running") is True:
        code = "import hashlib,json,pathlib; b=pathlib.Path('/etc/forge-publisher/settings.json').read_bytes(); d=json.loads(b); print(json.dumps({'host':d.get('host'),'port':d.get('port'),'sha256':hashlib.sha256(b).hexdigest()}))"
        result = run(["docker", "--host", host, "exec", identifier, "python", "-c", code], env=clean_docker_env(host))
        try: observed = json.loads(result.stdout)
        except json.JSONDecodeError: refuse("running publisher settings identity is unreadable")
        if observed != identity: refuse("running publisher settings bytes or listener differ from the validated mount")


def validate_declared(model: Any, bound: dict[str, str], expected_settings: Path | None = None) -> None:
    if not isinstance(model, dict) or model.get("name") != bound["project"]:
        refuse("rendered Compose project differs from the policy binding")
    services, networks = model.get("services"), model.get("networks")
    if not isinstance(services, dict) or not isinstance(networks, dict):
        refuse("rendered Compose topology is unreadable")
    net = networks.get("forge-publisher-net") or {}
    if net.get("name") != bound["network"] or net.get("driver", "bridge") != "bridge" or net.get("internal", False) or net.get("enable_ipv6") is not False or net.get("driver_opts", {}).get("com.docker.network.bridge.name") != bound["bridge"]:
        refuse("rendered Compose publisher bridge differs from the fixed policy binding")
    members = {name for name, service in services.items() if "forge-publisher-net" in (service.get("networks") or {})}
    if members != {"coordinator", "forge-publisher"}:
        refuse("rendered publisher membership differs from the two qualified roles")
    publisher = services["forge-publisher"]
    mounted = settings_mount(publisher.get("volumes"), rendered=True)
    if expected_settings is not None and mounted != expected_settings:
        refuse("effective Compose publisher settings mount differs from the validated env file")
    settings_identity(mounted)
    if set(publisher.get("networks", {})) != {"forge-publisher-net"} or publisher.get("ports") or publisher.get("network_mode"):
        refuse("rendered publisher has another network or published port")
    if "localhost:8711/healthz" not in json.dumps(publisher.get("healthcheck")):
        refuse("rendered publisher healthcheck differs from the fixed port")
    environment = services["coordinator"].get("environment") or {}
    if not isinstance(environment, dict) or environment.get("FORGE_PUBLISHER_URL") != "http://forge-publisher:8711":
        refuse("rendered coordinator publisher URL differs from the fixed port")


def firewall_driver(field: str, value: Any) -> str:
    if isinstance(value, str):
        driver = value
    elif field == "FirewallBackend" and isinstance(value, dict):
        driver = value.get("Driver")
        details = value.get("Info", [])
        if not isinstance(details, list) or any(
            not isinstance(row, list) or len(row) != 2 or any(not isinstance(item, str) for item in row)
            for row in details
        ):
            refuse("Docker firewall backend details are malformed")
    else:
        refuse("Docker firewall backend identity is malformed")
    if not isinstance(driver, str) or not driver:
        refuse("Docker firewall backend driver is malformed")
    return driver


def daemon_identity(host: str) -> str:
    info = docker_json(host, "info", "--format", "{{json .}}")
    if not isinstance(info.get("ID"), str) or not info["ID"]:
        refuse("Docker daemon did not return a stable ID")
    if info.get("OSType") != "linux" or not isinstance(info.get("SecurityOptions"), list):
        refuse("publisher policy requires readable Linux rootful Docker identity")
    if any(not isinstance(x, str) or "rootless" in x.lower() for x in info["SecurityOptions"]):
        refuse("publisher policy does not support a rootless or unknown Docker daemon")
    for field in ("FirewallBackend", "FirewallDriver"):
        if field in info and firewall_driver(field, info[field]) != "iptables":
            refuse("Docker native nftables or unknown firewall backend is not qualified")
    version = run(["iptables", "--version"]).stdout.strip()
    if not re.fullmatch(r"iptables v1\.8\.\d+ \(nf_tables\)", version):
        refuse("iptables must positively identify the qualified nf_tables backend")
    if not re.match(r"nftables v1\.0\.\d+(?: |$)", run(["nft", "--version"]).stdout.strip()):
        refuse("nftables version is outside the qualified 1.0 series")
    # Older engines omit FirewallBackend. Require actual iptables Docker chains
    # and a FORWARD jump, not just an installed nf_tables executable.
    rules = run(["iptables", "-w", "5", "-t", "filter", "-S"]).stdout.splitlines()
    if "-N DOCKER" not in rules or "-N DOCKER-USER" not in rules or not any(
        line.startswith("-A FORWARD ") and line.split()[-2:] == ["-j", "DOCKER-USER"] for line in rules
    ):
        refuse("active Docker iptables filter chains cannot be positively qualified")
    tables = nft_tables()
    if any(row.get("name") == "docker-bridges" for row in tables):
        refuse("Docker native nftables tables conflict with the qualified iptables backend")
    return info["ID"]


def inspect_topology(host: str, bound: dict[str, str], *, require_members: bool) -> dict[str, Any]:
    # Global discovery is intentional: project filters hide foreign collisions.
    listed = docker_rows(host, "network", "ls")
    candidates = []
    for row in listed:
        net = docker_json(host, "network", "inspect", row["ID"])[0]
        labels, options = net.get("Labels"), net.get("Options")
        if not isinstance(labels, (dict, type(None))) or not isinstance(options, (dict, type(None))):
            refuse("Docker network labels or options are malformed")
        labels, options = labels or {}, options or {}
        if net.get("Name") == bound["network"] or options.get("com.docker.network.bridge.name") == bound["bridge"] or (
            labels.get("com.docker.compose.project") == bound["project"] and labels.get("com.docker.compose.network") == "forge-publisher-net"
        ):
            candidates.append(net)
    try: links = json.loads(run(["ip", "-j", "-d", "link", "show"]).stdout)
    except json.JSONDecodeError: refuse("Linux interface inspection is unreadable")
    if not isinstance(links, list) or any(not isinstance(x, dict) or not isinstance(x.get("ifname"), str) for x in links):
        refuse("Linux interface inspection has invalid shape")
    matches = [x for x in links if x["ifname"] == bound["bridge"]]
    publisher_rows = docker_rows(host, "ps", "-a", "--no-trunc", "--filter", f"label=com.docker.compose.project={bound['project']}", "--filter", "label=com.docker.compose.service=forge-publisher")
    if len(publisher_rows) > 1: refuse("project has duplicate publisher definitions")
    if not candidates:
        if publisher_rows: refuse("owned publisher exists without its qualified network")
        if matches: refuse("derived Linux interface exists without the owned Docker network")
        if require_members: refuse("the owned publisher network is absent")
        return {"network_id": "", "members": {}}
    if len(candidates) != 1: refuse("publisher network or bridge identity collides")
    net = candidates[0]; labels = net.get("Labels") or {}; options = net.get("Options") or {}
    if net.get("Name") != bound["network"] or labels.get("com.docker.compose.project") != bound["project"] or labels.get("com.docker.compose.network") != "forge-publisher-net":
        refuse("publisher network is not owned by the exact Compose project")
    if net.get("Driver") != "bridge" or net.get("Scope") != "local" or net.get("Internal") is not False or options.get("com.docker.network.bridge.name") != bound["bridge"] or options.get("com.docker.network.bridge.enable_ip_masquerade", "true") != "true":
        refuse("publisher network is not the qualified ordinary local bridge")
    if net.get("EnableIPv6") is not False:
        refuse("publisher network must have IPv6 explicitly disabled")
    ipam = net.get("IPAM") or {}
    if not isinstance(ipam, dict) or any(not isinstance(x, dict) or ":" in str(x.get("Subnet", "")) for x in ipam.get("Config", [])):
        refuse("publisher network has malformed or IPv6 address allocation")
    if len(matches) != 1 or matches[0].get("linkinfo", {}).get("info_kind") != "bridge":
        refuse("owned publisher network has no exact Linux bridge interface")
    containers = net.get("Containers")
    if not isinstance(containers, dict): refuse("publisher network membership is unreadable")
    roles = {}
    for identifier, endpoint in containers.items():
        if not isinstance(endpoint, dict) or endpoint.get("IPv6Address", ""):
            refuse("publisher network has a malformed or IPv6 endpoint")
        container = docker_json(host, "inspect", identifier)[0]
        config = container.get("Config") or {}; labels = config.get("Labels") or {}
        service, project = labels.get("com.docker.compose.service"), labels.get("com.docker.compose.project")
        if project != bound["project"] or service not in {"coordinator", "forge-publisher"} or service in roles:
            refuse("publisher network contains an unexpected or duplicate member")
        if require_members and container.get("State", {}).get("Running") is not True:
            refuse("running verification requires running coordinator and publisher")
        roles[service] = identifier
        if service == "forge-publisher":
            settings = container.get("NetworkSettings") or {}; networks = settings.get("Networks")
            ports = settings.get("Ports"); host_config = container.get("HostConfig") or {}
            if not isinstance(networks, dict) or set(networks) != {bound["network"]} or not isinstance(ports, dict) or any(ports.values()) or host_config.get("PortBindings") or host_config.get("PublishAllPorts"):
                refuse("publisher has another network or a published port")
            endpoint = networks[bound["network"]]
            if not isinstance(endpoint, dict) or endpoint.get("GlobalIPv6Address") or endpoint.get("IPv6Gateway") or settings.get("GlobalIPv6Address"):
                refuse("publisher has an unexpected IPv6 endpoint")
            if "localhost:8711/healthz" not in json.dumps(config.get("Healthcheck")):
                refuse("publisher healthcheck does not use the fixed listener port")
    listed_ids = {row["ID"] for row in publisher_rows}
    if "forge-publisher" in roles and roles["forge-publisher"] not in listed_ids:
        refuse("publisher membership and global project inventory disagree")
    for identifier in listed_ids - set(roles.values()):
        container = docker_json(host, "inspect", identifier)[0]
        networks = container.get("NetworkSettings", {}).get("Networks") or {}
        labels = container.get("Config", {}).get("Labels") or {}
        if labels.get("com.docker.compose.project") != bound["project"] or labels.get("com.docker.compose.service") != "forge-publisher" or container.get("State", {}).get("Running") is not False or set(networks) != {bound["network"]}:
            refuse("owned publisher is stranded outside the qualified network membership")
        # A stopped, correctly attached publisher need not have an active endpoint
        # in network inspect. It must still be stopped before any policy update.
        if container.get("HostConfig", {}).get("PortBindings") or container.get("HostConfig", {}).get("PublishAllPorts"):
            refuse("stopped publisher retains a published-port definition")
        if require_members: refuse("running verification requires running publisher membership")
        roles["forge-publisher"] = identifier
    if require_members and set(roles) != {"coordinator", "forge-publisher"}:
        refuse("running verification requires exact coordinator and publisher members")
    return {"network_id": net["Id"], "members": roles}


def nft_tables() -> list[dict[str, Any]]:
    try: data = json.loads(run(["nft", "-j", "list", "tables"]).stdout)
    except json.JSONDecodeError: refuse("current kernel table inventory is unreadable")
    if not isinstance(data, dict) or not isinstance(data.get("nftables"), list):
        refuse("current kernel table inventory is malformed")
    tables = []
    for entry in data["nftables"]:
        if not isinstance(entry, dict): refuse("current kernel table inventory is malformed")
        if set(entry) == {"metainfo"}: continue
        if set(entry) != {"table"} or not isinstance(entry["table"], dict) or not all(isinstance(entry["table"].get(k), str) for k in ("family", "name")):
            refuse("current kernel table inventory is malformed")
        tables.append(entry["table"])
    return tables


def nft_json(table: str) -> dict[str, Any] | None:
    result = run(["nft", "-j", "list", "table", "inet", table], check=False)
    if result.returncode:
        if any(row["family"] == "inet" and row["name"] == table for row in nft_tables()):
            refuse("existing kernel table cannot be read")
        return None
    try:
        data = json.loads(result.stdout)
    except json.JSONDecodeError:
        refuse("current kernel policy is unreadable")
    if not isinstance(data, dict):
        refuse("current kernel policy is unreadable")
    return data


def _match(expr: Any, left: dict[str, Any], right: Any) -> bool:
    return expr == {"match": {"op": "==", "left": left, "right": right}}


def verify_semantics(data: dict[str, Any] | None, bound: dict[str, str]) -> None:
    if data is None:
        refuse("the current kernel has no owned publisher policy")
    entries = data.get("nftables")
    if not isinstance(entries, list):
        refuse("current kernel policy is not nftables JSON")
    if any(not isinstance(entry, dict) or len(entry) != 1 for entry in entries):
        refuse("current kernel policy contains malformed entries")
    substantive = [entry for entry in entries if set(entry) != {"metainfo"}]
    tables = [x["table"] for x in substantive if set(x) == {"table"}]
    chains = [x["chain"] for x in substantive if set(x) == {"chain"}]
    rules = [x["rule"] for x in substantive if set(x) == {"rule"}]
    if len(tables) != 1 or len(chains) != 1 or len(rules) != 2 or len(substantive) != 4:
        refuse("owned policy has missing or unexpected tables, chains, or rules")
    table = {k: v for k, v in tables[0].items() if k not in {"handle"}}
    chain = {k: v for k, v in chains[0].items() if k not in {"handle"}}
    if table != {"family": "inet", "name": bound["table"]}:
        refuse("owned policy has the wrong family or table")
    expected_chain = {"family": "inet", "table": bound["table"], "name": "host_output",
                      "type": "filter", "hook": "output", "prio": -5, "policy": "accept"}
    if chain != expected_chain:
        refuse("owned policy has the wrong chain, hook, priority, or default policy")
    oifname = lambda x: _match(x, {"meta": {"key": "oifname"}}, bound["bridge"])
    l4proto = lambda x: _match(x, {"meta": {"key": "l4proto"}}, "tcp")
    dport = lambda x: _match(x, {"payload": {"protocol": "tcp", "field": "dport"}}, PORT)
    # nft_text writes an explicit "meta l4proto tcp", but nft (e.g. v1.0.9)
    # lists the rule without it: the tcp dport payload match carries that
    # protocol dependency implicitly.  Accept exactly these two listings.
    heads = [[oifname, l4proto, dport], [oifname, dport]]
    expected_tails = [
        [lambda x: _match(x, {"ct": {"key": "direction"}}, "reply"), lambda x: x == {"return": None}],
        [lambda x: x == {"counter": {"packets": x.get("counter", {}).get("packets", 0),
                                      "bytes": x.get("counter", {}).get("bytes", 0)}} if isinstance(x, dict) and "counter" in x else False,
         lambda x: x == {"drop": None}],
    ]
    for index, (rule, tail) in enumerate(zip(rules, expected_tails)):
        if rule.get("family") != "inet" or rule.get("table") != bound["table"] or rule.get("chain") != "host_output":
            refuse("owned policy rule is attached to the wrong chain")
        if set(rule) - {"family", "table", "chain", "handle", "expr"}:
            refuse("owned policy rule contains unexpected attributes")
        expressions = rule.get("expr")
        if not isinstance(expressions, list) or not any(
            len(expressions) == len(head + tail) and all(check(e) for check, e in zip(head + tail, expressions))
            for head in heads
        ):
            refuse(f"owned policy rule {index + 1} has changed semantics")


def transaction(bound: dict[str, str], *, old_exists: bool) -> str:
    prefix = f"delete table inet {bound['table']}\n" if old_exists else ""
    return prefix + nft_text(bound)


def owned_policy(bound: dict[str, str], existing: dict[str, Any] | None) -> bool:
    data = nft_json(bound["table"])
    if data is None: return False
    if existing is None: refuse("derived nft table exists without validated owned configuration")
    verify_semantics(data, bound)
    return True


def apply_policy(bound: dict[str, str], existing: dict[str, Any] | None) -> None:
    old_exists = owned_policy(bound, existing)
    script = transaction(bound, old_exists=old_exists)
    run(["nft", "-c", "-f", "-"], input_text=script)
    run(["nft", "-f", "-"], input_text=script)
    try:
        verify_semantics(nft_json(bound["table"]), bound)
    except Exception:
        # Only the exact fixed definition, proven owned above, can be restored.
        # Never replay arbitrary nft stdout or a global ruleset.
        restore = transaction(bound, old_exists=True) if old_exists else f"delete table inet {bound['table']}\n"
        run(["nft", "-c", "-f", "-"], input_text=restore)
        run(["nft", "-f", "-"], input_text=restore)
        raise


def canonical_config(bound: dict[str, str], daemon_id: str, host: str, persistent: bool) -> dict[str, Any]:
    return {"format": 1, **bound, "port": PORT, "docker_host": host,
            "daemon_id": daemon_id, "persistent": persistent,
            "specification": specification(bound)}


def atomic_write(path: Path, content: bytes, mode: int) -> None:
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o755)
    if path.exists() and path.read_bytes() == content:
        os.chmod(path, mode)
        return
    descriptor, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    try:
        with os.fdopen(descriptor, "wb") as stream:
            stream.write(content); stream.flush(); os.fsync(stream.fileno())
        os.chmod(temporary, mode)
        os.replace(temporary, path)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def unit_bytes() -> bytes:
    return ("[Unit]\nDescription=Forge publisher host policy %i\nBefore=docker.service\n\n"
            "[Service]\nType=oneshot\nExecStart=/usr/local/libexec/forge-publisher-host-policy load-static --config /etc/forge-publisher-policy/%i.json\nRemainAfterExit=yes\n\n[Install]\nWantedBy=multi-user.target\n").encode()


def dropin_bytes(suffix: str) -> bytes:
    name = f"forge-publisher-host-policy@{suffix}.service"
    return f"[Unit]\nRequires={name}\nAfter={name}\n".encode()


def trusted_path(path: Path, *, mode: int | None = None) -> bool:
    for parent in reversed(path.parents):
        if parent.exists():
            st = parent.lstat()
            if not stat.S_ISDIR(st.st_mode) or st.st_uid != 0 or st.st_mode & 0o022:
                refuse(f"artifact parent is not a trusted root-owned directory: {parent}")
    if not os.path.lexists(path): return False
    st = path.lstat()
    if not stat.S_ISREG(st.st_mode) or st.st_uid != 0 or st.st_nlink != 1 or st.st_mode & 0o022 or (mode is not None and stat.S_IMODE(st.st_mode) != mode):
        refuse(f"artifact is not a trusted root-owned regular file: {path}")
    return True


def preflight_artifact(path: Path, content: bytes, mode: int, *, required: bool = False) -> None:
    exists = trusted_path(path, mode=mode)
    if (required and not exists) or (exists and path.read_bytes() != content):
        refuse(f"owned/shared artifact {path} is missing or has different bytes; migration is outside this helper")


def systemd_paths() -> list[Path]:
    if os.environ.get("SYSTEMD_UNIT_PATH"): refuse("custom systemd unit search paths are not qualified")
    paths = run(["systemctl", "show", "--property=UnitPath", "--value"]).stdout.split()
    if not paths or any(not Path(x).is_absolute() for x in paths):
        refuse("systemd manager unit search paths are unreadable")
    return list(dict.fromkeys(Path(x) for x in paths))


def loader_files_preflight(bound: dict[str, str], paths: list[Path]) -> None:
    instance = f"forge-publisher-host-policy@{bound['suffix']}.service"
    drops = [instance+".d", UNIT.name+".d", "forge-.service.d", "forge-publisher-.service.d", "forge-publisher-host-.service.d", "service.d"]
    for directory in paths:
        for name in (instance, UNIT.name):
            candidate = directory / name
            if candidate != UNIT and os.path.lexists(candidate):
                refuse("foreign loader instance, alias, or alternate template exists")
        for name in drops:
            folder = directory / name
            if os.path.lexists(folder) and (folder.is_symlink() or not folder.is_dir() or any(folder.glob("*.conf"))):
                refuse("loader has an unsupported effective systemd drop-in")
        if directory.is_dir():
            for candidate in directory.glob("*.service"):
                if candidate.is_symlink():
                    target = candidate.resolve()
                    if target.name in (instance, UNIT.name): refuse("loader has a systemd alias")


def systemd_properties(unit: str, names: str) -> dict[str, str]:
    text = run(["systemctl", "show", unit, "--property="+names, "--no-pager"]).stdout
    result = dict(line.split("=", 1) for line in text.splitlines() if "=" in line)
    if set(result) != set(names.split(",")): refuse("effective systemd unit properties are unreadable")
    return result


def loader_effective(bound: dict[str, str], *, installed: bool) -> None:
    name = f"forge-publisher-host-policy@{bound['suffix']}.service"
    identity = systemd_properties(name, "Id,Names,FragmentPath,DropInPaths,LoadState")
    if identity["LoadState"] == "not-found":
        absent = {
            "Id": name,
            "Names": name,
            "FragmentPath": "",
            "DropInPaths": "",
            "LoadState": "not-found",
        }
        if not installed and identity == absent:
            return
        refuse("effective systemd loader has a conflicting absent identity")
    props = systemd_properties(name, "Id,Names,FragmentPath,DropInPaths,LoadState,Type,RemainAfterExit,ExecStart")
    expected = f"{HELPER} load-static --config {CONFIG_DIR}/{bound['suffix']}.json"
    argv = re.findall(r"argv\[\]=(.*?) ;", props["ExecStart"])
    if props["Id"] != name or props["Names"].split() != [name] or props["FragmentPath"] != str(UNIT) or props["DropInPaths"] or props["LoadState"] != "loaded" or props["Type"] != "oneshot" or props["RemainAfterExit"] != "yes" or argv != [expected]:
        refuse("effective systemd loader differs from the owned fixed definition")


def verify_docker_dependency(bound: dict[str, str]) -> None:
    props = systemd_properties("docker.service", "Requires,After")
    name = f"forge-publisher-host-policy@{bound['suffix']}.service"
    if any(name not in props[key].split() for key in ("Requires", "After")):
        refuse("effective Docker policy requirement or ordering is missing")


def persistence_preflight(bound: dict[str, str], persistent: bool, existing: dict[str, Any] | None) -> None:
    if existing and existing["persistent"] and not persistent:
        refuse("persistent to runtime-only transition requires explicit safe removal first")
    required = bool(existing and existing["persistent"])
    preflight_artifact(HELPER, Path(__file__).read_bytes(), 0o755, required=existing is not None)
    preflight_artifact(UNIT, unit_bytes(), 0o644, required=required)
    dropin = DROPIN_DIR / f"forge-publisher-host-policy-{bound['suffix']}.conf"
    preflight_artifact(dropin, dropin_bytes(bound["suffix"]), 0o644, required=required)
    if trusted_path(dropin) and not required:
        refuse("Docker dependency exists without a persistent owned binding")
    if persistent:
        # Check obvious local collisions before even querying the manager.
        loader_files_preflight(bound, [UNIT.parent])
        paths = systemd_paths()
        if UNIT.parent not in paths: refuse("owned loader directory is outside the manager search path")
        loader_files_preflight(bound, paths)
        loader_effective(bound, installed=required)
        if required: verify_docker_dependency(bound)


def lock(bound: dict[str, str]):
    directory = LOCK_DIR / "forge-publisher-policy"
    directory.mkdir(mode=0o700, exist_ok=True)
    st = directory.lstat()
    if not stat.S_ISDIR(st.st_mode) or st.st_uid != 0 or stat.S_IMODE(st.st_mode) != 0o700:
        refuse("policy lock directory is not exclusively root-owned")
    # One lock also serializes installation of the shared helper/template.
    descriptor = os.open(directory / "update.lock", os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)
    handle = os.fdopen(descriptor, "a", encoding="utf-8")
    fcntl.flock(handle, fcntl.LOCK_EX)
    return handle


def load_config(path: Path) -> tuple[dict[str, str], dict[str, Any]]:
    if not path.is_absolute() or not trusted_path(path, mode=0o600):
        refuse("static policy config must be an absolute root-owned mode 0600 regular file")
    try:
        config = json.loads(path.read_text(encoding="utf-8"))
    except json.JSONDecodeError:
        refuse("static policy config is not JSON")
    if not isinstance(config, dict) or config.get("format") != 1:
        refuse("static policy config has the wrong format")
    if config.get("docker_host") != DOCKER_HOST or not isinstance(config.get("daemon_id"), str) or not config["daemon_id"] or type(config.get("persistent")) is not bool:
        refuse("static policy config has invalid daemon or persistence identity")
    bound = binding(str(config.get("project", "")))
    expected = canonical_config(bound, str(config.get("daemon_id", "")), str(config.get("docker_host", "")), bool(config.get("persistent")))
    if config != expected or path != CONFIG_DIR / f"{bound['suffix']}.json":
        refuse("static policy config does not match its fixed project binding")
    return bound, config


def require_root() -> None:
    if os.geteuid() != 0:
        refuse("this operation requires root for the owned nftables table and boot files")


def cmd_describe(args: argparse.Namespace) -> None:
    bound = binding(args.project)
    if getattr(args, "compose_stdin", False):
        try: model = json.load(sys.stdin)
        except json.JSONDecodeError: refuse("rendered Compose JSON is unreadable")
        expected = None
        if getattr(args, "env_file", None):
            validate_env(args.env_file, bound)
            expected = Path(read_env(args.env_file)["FORGE_PUBLISHER_SETTINGS_FILE"])
        validate_declared(model, bound, expected)
    print(json.dumps({**bound, "FORGE_PUBLISHER_BRIDGE": bound["bridge"],
                      "port": PORT, "specification_sha256": specification(bound)["sha256"]}, sort_keys=True))


def cmd_install(args: argparse.Namespace) -> None:
    require_root()
    bound = binding(args.project); validate_env(args.env_file, bound)
    with lock(bound):
        daemon_id = daemon_identity(args.docker_host)
        topology = inspect_topology(args.docker_host, bound, require_members=False)
        config_path = CONFIG_DIR / f"{bound['suffix']}.json"
        existing = None
        if trusted_path(config_path, mode=0o600):
            _, existing = load_config(config_path)
            if existing["daemon_id"] != daemon_id or existing["docker_host"] != args.docker_host:
                refuse("existing policy is bound to a different Docker daemon")
        persistent = not args.runtime_only
        persistence_preflight(bound, persistent, existing)
        old_exists = owned_policy(bound, existing)
        publisher = topology["members"].get("forge-publisher")
        if publisher:
            if docker_json(args.docker_host, "inspect", publisher)[0].get("State", {}).get("Running") is not False:
                refuse("publisher must be stopped before policy install or replacement")
        if publisher:
            verify_publisher_settings(args.docker_host, publisher, Path(read_env(args.env_file)["FORGE_PUBLISHER_SETTINGS_FILE"]))
        config = canonical_config(bound, daemon_id, args.docker_host, persistent)
        # Stage canonical config before table mutation. On failure retain only
        # previously owned bytes; a successful table may safely remain protecting
        # a stopped publisher if later persistence installation fails.
        old_bytes = config_path.read_bytes() if existing else None
        atomic_write(config_path, (json.dumps(config, sort_keys=True, indent=2) + "\n").encode(), 0o600)
        applied = False
        try:
            apply_policy(bound, existing)
            applied = True
            atomic_write(HELPER, Path(__file__).read_bytes(), 0o755)
            if persistent:
                atomic_write(UNIT, unit_bytes(), 0o644)
                atomic_write(DROPIN_DIR / f"forge-publisher-host-policy-{bound['suffix']}.conf", dropin_bytes(bound["suffix"]), 0o644)
                run(["systemctl", "daemon-reload"])
                loader_effective(bound, installed=True)
                verify_docker_dependency(bound)
        except Exception:
            # Keep the staged binding if an installed dependency might load it.
            # Otherwise revert only our own config; the policy is never widened.
            dropin = DROPIN_DIR / f"forge-publisher-host-policy-{bound['suffix']}.conf"
            if not applied and not dropin.exists():
                if old_bytes is None: config_path.unlink()
                else: atomic_write(config_path, old_bytes, 0o600)
            raise
    print(f"INSTALLED project={bound['project']} daemon={daemon_id} bridge={bound['bridge']} policy={config['specification']['sha256']} boot={'PERSISTENT' if persistent else 'NOT CHECKED'}")


def verify_from_config(bound: dict[str, str], config: dict[str, Any], args: argparse.Namespace,
                       *, require_members: bool) -> dict[str, Any]:
    if args.docker_host != config["docker_host"] or daemon_identity(args.docker_host) != config["daemon_id"]:
        refuse("effective Docker endpoint or daemon ID differs from the installed binding")
    if getattr(args, "daemon_id", None) and args.daemon_id != config["daemon_id"]:
        refuse("caller's selected daemon differs from the installed daemon binding")
    validate_env(args.env_file, bound)
    topology = inspect_topology(args.docker_host, bound, require_members=require_members)
    if topology["members"].get("forge-publisher"):
        verify_publisher_settings(args.docker_host, topology["members"]["forge-publisher"], Path(read_env(args.env_file)["FORGE_PUBLISHER_SETTINGS_FILE"]))
    persistence_preflight(bound, config["persistent"], config)
    data = nft_json(bound["table"])
    verify_semantics(data, bound)
    return data


def cmd_verify(args: argparse.Namespace) -> None:
    bound = binding(args.project)
    loaded_bound, config = load_config(CONFIG_DIR / f"{bound['suffix']}.json")
    if loaded_bound != bound:
        refuse("installed project binding differs from the requested project")
    data = verify_from_config(bound, config, args, require_members=args.require_members)
    rules = [entry["rule"] for entry in data["nftables"] if "rule" in entry]
    counter = rules[1]["expr"][-2]["counter"]
    print(f"VERIFIED project={bound['project']} daemon={config['daemon_id']} bridge={bound['bridge']} policy={config['specification']['sha256']} drop_packets={counter.get('packets', 0)} drop_bytes={counter.get('bytes', 0)} boot={'PERSISTENT' if config['persistent'] else 'NOT CHECKED'}")


def cmd_load_static(args: argparse.Namespace) -> None:
    require_root()
    bound, config = load_config(args.config)
    with lock(bound):
        bound, config = load_config(args.config)
        if not config["persistent"]: refuse("runtime-only policy is not a boot installation")
        persistence_preflight(bound, True, config)
        # An already exact owned table needs no boot-time replacement. This also
        # makes an accidental repeated static load a read-only verification.
        if not owned_policy(bound, config):
            apply_policy(bound, config)
    print(f"LOADED project={bound['project']} bridge={bound['bridge']} policy={specification(bound)['sha256']}")


def cmd_remove(args: argparse.Namespace) -> None:
    require_root()
    bound = binding(args.project)
    with lock(bound):
        _, config = load_config(CONFIG_DIR / f"{bound['suffix']}.json")
        if args.docker_host != config["docker_host"] or daemon_identity(args.docker_host) != config["daemon_id"]:
            refuse("effective Docker endpoint or daemon ID differs from the installed binding")
        containers = docker_rows(args.docker_host, "ps", "-a", "--filter", f"label=com.docker.compose.project={bound['project']}", "--filter", "label=com.docker.compose.service=forge-publisher")
        if containers: refuse("publisher container still exists; remove the exact project before its protection")
        topology = inspect_topology(args.docker_host, bound, require_members=False)
        if topology["network_id"]: refuse("owned publisher network still exists; remove the exact project before its protection")
        persistence_preflight(bound, config["persistent"], config)
        verify_semantics(nft_json(bound["table"]), bound)
        if config["persistent"]:
            dropin = DROPIN_DIR / f"forge-publisher-host-policy-{bound['suffix']}.conf"
            dropin.unlink()
            try:
                run(["systemctl", "daemon-reload"])
                # Prove the requirement is gone. After= may still name the loader:
                # the loader's own Before=docker.service keeps that ordering while
                # it stays loaded, and ordering alone never requires the loader.
                properties = systemd_properties("docker.service", "Requires,DropInPaths")
                if f"forge-publisher-host-policy@{bound['suffix']}.service" in properties["Requires"].split() or str(dropin) in properties["DropInPaths"].split():
                    refuse("Docker reverse requirement removal is not proved")
            except Exception:
                atomic_write(dropin, dropin_bytes(bound["suffix"]), 0o644)
                run(["systemctl", "daemon-reload"])
                raise
            run(["systemctl", "reset-failed", f"forge-publisher-host-policy@{bound['suffix']}.service"], check=False)
        run(["nft", "delete", "table", "inet", bound["table"]])
        (CONFIG_DIR / f"{bound['suffix']}.json").unlink()
    print(f"REMOVED project={bound['project']}; shared helper and unit retained")


def parser() -> argparse.ArgumentParser:
    made = argparse.ArgumentParser(description=__doc__)
    sub = made.add_subparsers(dest="command", required=True)
    describe = sub.add_parser("describe"); describe.add_argument("--project", required=True); describe.add_argument("--compose-stdin", action="store_true", help="validate a rendered declaration from stdin without side effects"); describe.add_argument("--env-file", type=Path); describe.set_defaults(func=cmd_describe)
    for name, func in (("install", cmd_install), ("verify", cmd_verify), ("remove", cmd_remove)):
        item = sub.add_parser(name); item.add_argument("--project", required=True)
        item.add_argument("--docker-host", required=True); item.add_argument("--env-file", type=Path, required=name != "remove")
        if name == "install": item.add_argument("--runtime-only", action="store_true")
        if name == "verify":
            item.add_argument("--require-members", action="store_true")
            item.add_argument("--daemon-id")
        item.set_defaults(func=func)
    static = sub.add_parser("load-static"); static.add_argument("--config", type=Path, required=True); static.set_defaults(func=cmd_load_static)
    return made


def main() -> int:
    try:
        args = parser().parse_args(); args.func(args); return 0
    except Refusal as exc:
        print(f"publisher-host-policy: REFUSED — {exc}", file=sys.stderr); return 1


if __name__ == "__main__":
    raise SystemExit(main())
