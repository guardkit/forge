#!/usr/bin/env bash
# ---------------------------------------------------------------------------
# factory-hello — ask the coordinator, in its own container, what it can reach.
#
# One line each for the bus, the answer service, the memory service, the
# publisher, and the two addresses into a project's sandbox — the deploy helper
# and the build runner — with THE ADDRESS IT USED on every line. The sandbox addresses come from the
# coordinator's own settings file through its own loader, so what is printed is
# what the coordinator would really dial, not what this script guessed.
#
# A line may honestly say "not reachable": on a machine with no sandbox the two
# sandbox addresses are expected to, and that is printed rather than hidden.
# Nothing here is a gate; estate-check is the gate.
#
#   --env-file FILE   the estate's env file (default: .env beside this script)
#   --project NAME    the compose project name, if it is not the default
# ---------------------------------------------------------------------------
set -uo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ENV_FILE="${HERE}/.env"
PROJECT=""

while [ $# -gt 0 ]; do
    case "$1" in
        --env-file) ENV_FILE="${2:?--env-file needs a file}"; shift 2 ;;
        --project)  PROJECT="${2:?--project needs a name}"; shift 2 ;;
        --help|-h)  sed -n '2,16p' "${BASH_SOURCE[0]}"; exit 0 ;;
        *)          printf 'factory-hello: unknown argument "%s". Try --help.\n' "$1" >&2; exit 2 ;;
    esac
done

# ASKING COMPOSE CAN FAIL FOR TWO COMPLETELY DIFFERENT REASONS, and saying the
# wrong one sends somebody looking in the wrong place: the bundle may not
# render at all (a name with no value, a missing file), or it may render
# perfectly and the coordinator not be running. On 24 September's review this
# printed the second when it meant the first, against a healthy estate.
# The two streams are kept apart on purpose: compose writes warnings to its
# error stream even when it succeeds, and a clean shell produces one for every
# password name this bundle deliberately leaves unset. Folded in with 2>&1, a
# warning becomes the container id.
WHY="$(mktemp)"
SAID="$(docker compose --env-file "${ENV_FILE}" -f "${HERE}/compose.yaml" \
        ${PROJECT:+--project-name "${PROJECT}"} ps -q coordinator 2>"${WHY}")"
STATUS=$?

if [ "${STATUS}" -ne 0 ]; then
    printf 'factory-hello: this estate could not be read at all, so nothing was asked. Compose said: %s\n' \
        "$(grep -v '^[[:space:]]*$' "${WHY}" | grep -v 'level=warning' | head -2 | tr '\n' ' ')" >&2
    printf 'That is a problem with the files or the env file, not with any service.\n' >&2
    rm -f "${WHY}"
    exit 2
fi
rm -f "${WHY}"

CID="$(printf '%s' "${SAID}" | head -1)"

# THE MEMORY SERVICE'S ADDRESS, taken from the same env file compose was given,
# and from the shell if the shell has one — which is the order compose itself
# uses, so what is printed is the address the estate really uses. It is a
# service name on the factory network and carries no secret; the memory store's
# address, which does carry one, is never read here and never printed.
MEMORY_URL="${FLEET_MEMORY_URL:-$(sed -n 's/^[[:space:]]*FLEET_MEMORY_URL=//p' "${ENV_FILE}" 2>/dev/null | tail -1)}"

if [ -z "${CID}" ]; then
    printf 'factory-hello: the estate reads fine, and the coordinator is not running in it, so there is nobody to ask.\n' >&2
    exit 1
fi

docker exec -i -e "FACTORY_HELLO_MEMORY_URL=${MEMORY_URL}" "${CID}" python - <<'PY'
"""What the coordinator can reach, from inside the coordinator."""
from __future__ import annotations

import os
import re
import socket
import urllib.error
import urllib.parse
import urllib.request

TIMEOUT = 5.0

# The answer service's name and port inside the estate's own network. Both are
# the same on every machine: the service name is what the compose file calls
# it, and the port is the one it listens on INSIDE its container. The port a
# sandbox reaches it on is published separately, at the factory gateway
# address, and is a setting.
ANSWER_SERVICE = "http://answer-service:8126"


def said_safely(address: str) -> str:
    """An address with any password in it replaced, never printed."""
    return re.sub(r"(://[^:/@]+):[^@/]*@", r"\1:***@", address)


def line(what: str, verdict: str, address: str) -> None:
    print(f"{what:<44} {verdict:<30} at {said_safely(address)}")


def over_http(what: str, address: str, route: str = "/healthz") -> None:
    # An empty route means the address already carries its own, so it is used
    # exactly as the env file wrote it — trailing slash and all, which some
    # servers care about.
    url = address if not route else address.rstrip("/") + route
    try:
        with urllib.request.urlopen(url, timeout=TIMEOUT) as answer:
            line(what, f"reachable (HTTP {answer.status})", url)
    except urllib.error.HTTPError as answer:
        line(what, f"reachable (HTTP {answer.code})", url)
    except Exception as why:  # noqa: BLE001 - the reason is the message
        line(what, f"not reachable: {type(why).__name__}", url)


def over_the_bus(address: str) -> None:
    """The bus speaks first: a connection that is accepted says INFO."""
    parsed = urllib.parse.urlparse(address)
    host, port = parsed.hostname or "", parsed.port or 4222
    try:
        with socket.create_connection((host, port), timeout=TIMEOUT) as connected:
            connected.settimeout(TIMEOUT)
            greeting = connected.recv(64)
        if greeting.startswith(b"INFO"):
            line("the bus", "reachable (it said INFO)", address)
        else:
            line("the bus", "answered, but not as a bus does", address)
    except Exception as why:  # noqa: BLE001
        line("the bus", f"not reachable: {type(why).__name__}", address)


print("The coordinator, from inside its own container:\n")

over_the_bus(os.environ.get("FORGE_NATS_URL", ""))
over_http("the answer service", ANSWER_SERVICE)

# THE MEMORY SERVICE, at the address the estate's env file gives — printed
# whether or not it answers, because "which address did you use" is the
# question this command exists to answer. The route is already on the end of
# that address (the MCP transport serves /mcp/), so nothing is added to it.
memory = os.environ.get("FACTORY_HELLO_MEMORY_URL", "").strip()
if memory:
    over_http("the memory service", memory, route="")
else:
    print(
        f"{'the memory service':<44} no address in the estate's env file "
        "(FLEET_MEMORY_URL)"
    )

over_http("the publisher", os.environ.get("FORGE_PUBLISHER_URL", ""))

# The two addresses into a project's sandbox, resolved the way the coordinator
# resolves them: its own settings file, through its own loader, which fills in
# a ${NAME} from this container's environment and refuses by name if nothing
# set one.
try:
    from forge.config.loader import load_config
    from pathlib import Path

    settings = load_config(Path("/etc/forge/forge.yaml"))
    sandboxes = getattr(settings.planning, "sandboxes", {}) or {}
    if not sandboxes:
        print(
            f"{'a sandbox':<44} none in the settings file, so no project has one here"
        )
    for project, entry in sandboxes.items():
        over_http(f"helper [{entry.name}]", entry.sidecar_url)
        over_http(f"runner [{entry.name}]", entry.runner_url)
except Exception as why:  # noqa: BLE001
    print(f"{'the sandbox addresses':<22} could not be read from the settings file: {why}")

print(
    "\n'not reachable' for a sandbox address is the honest answer on a machine "
    "that looks after no sandbox."
)
PY
