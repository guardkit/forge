#!/usr/bin/env bash
# ---------------------------------------------------------------------------
# estate-check — is this machine fit to run the estate, and is the estate
# running properly once it has started.
#
# FOUR MODES, because some things must be true BEFORE anything starts, others
# can only be true after, and one phase of a rollout has to be checked with the
# door deliberately SHUT:
#
#   estate-check host              run it before 'docker compose up'
#   estate-check services         run it after
#   estate-check --pre-resume     the CLOSED-DOOR check: the estate up, and the
#                                 two things that can bring work in deliberately
#                                 NOT running. It writes down what it found so
#                                 the rollout's resume step can read it back
#   estate-check --read-pre-resume  read that record and say whether it may be
#                                 acted on: this estate, this image, recent
#                                 enough, and a pass
#
# Each item prints ONE plain sentence saying what was looked for, where, and
# what to do about it. Anything that is not a pass — a failure, or an item this
# machine could not check — makes the whole run NOT PASSED and the exit code
# non-zero, because a gate that has not been met is not met.
#
# It never prints the value of a secret. Where an address carries a password it
# is printed with the password replaced by '***'.
#
# The items are the ones in section 3 of
# docs/factory-containerisation-design-pass-2026-09-23.md, numbered as that
# section numbers them. 'estate-check --items' prints the list, and a test
# holds the list to the design so nobody drops one quietly.
#
# IT KNOWS WHOSE BUS IT IS (26 September 2026, build item E1). BUS_MODE in the
# env file says 'local' or 'external'. In local mode nothing below behaves any
# differently from the way it did before. In external mode the bus belongs to
# somebody else, is not a service of this project, and is therefore asked BY
# ADDRESS from inside the estate rather than by stepping into a container this
# project does not own.
#
#   --env-file FILE   the estate's env file (default: .env beside this script)
#   --project NAME    the compose project name, if it is not the default
#   --for-image NAME  the image this rollout is FOR — a tag or an image id. The
#                     closed-door check refuses unless that is what is really
#                     running. Left out, the env file's FORGE_IMAGE is taken as
#                     the image the rollout names, because that is the line the
#                     estate was started from
#   --items           print the item list and stop
# ---------------------------------------------------------------------------
set -uo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

ENV_FILE="${HERE}/.env"
PROJECT=""
MODE=""
EXPECT_IMAGE=""

while [ $# -gt 0 ]; do
    case "$1" in
        host|services)      MODE="$1"; shift ;;
        --pre-resume)       MODE="pre-resume"; shift ;;
        --read-pre-resume)  MODE="read-pre-resume"; shift ;;
        --env-file)    ENV_FILE="${2:?--env-file needs a file}"; shift 2 ;;
        --project)     PROJECT="${2:?--project needs a name}"; shift 2 ;;
        --for-image)   EXPECT_IMAGE="${2:?--for-image needs a tag or an image id}"; shift 2 ;;
        --items)       MODE="items"; shift ;;
        --help|-h)     sed -n '2,47p' "${BASH_SOURCE[0]}"; exit 0 ;;
        *)             printf 'estate-check: unknown argument "%s". Try --help.\n' "$1" >&2; exit 2 ;;
    esac
done

# ---------------------------------------------------------------------------
# THE ITEM LIST. One line each: mode, number, name, and the sentence from the
# design that the item comes from. This is the list --items prints and the list
# the test holds to the design.
# ---------------------------------------------------------------------------
ITEMS=(
"host|1|machine-qualifies-for-a-sandbox|a supported operating system and processor architecture, and hardware virtualisation available to this user"
"host|2|docker-is-here-and-answering|Docker is installed and its daemon answers, docker compose is present, and a Docker sign-in is reported present or absent"
"host|3|sandbox-tool-and-its-daemon|the sbx tool is installed, its version matches the one the release was proven against, and its daemon answers on its socket"
"host|4|release-images-present-or-fetchable|the release images are present, or can be fetched, at the TAGS the env file names - the design asks for digests, which this bundle does not do yet (README.md, the rollout preconditions)"
"host|5|volumes-and-disk-room|the declared volumes exist or can be created, and the disk has room"
"host|6|secret-files-present-and-private|every secret file the env file names exists and is readable by its own service's user and by nobody else"
"host|7|every-setting-name-has-a-value|every setting name the composed files require has a value"
"host|7b|bus-mode-and-the-files-agree|BUS_MODE says whose bus this estate runs against, and the compose profiles and files in force say the same thing - a half-set mode is the one state that could start a second bus beside a bus that is being kept"
"services|8|the-bus-answers|the bus answers at the address the env file gives"
"services|8b|the-buses-storage-is-provisioned|the bus's key-value buckets and streams exist, asked of the bus itself"
"services|8c|the-memory-service-answers|the memory service answers at the address the env file gives"
"services|8c-relay|the-memory-relay-is-running|the memory relay is running and has written its progress marker into its own volume"
"services|8c-forge|the-coordinator-reads-memory-itself|the coordinator says in its own log that its memory is on - the memory service answering proves the service, not that anything in the estate uses memory"
"services|8d|the-model-seat-answers|the model seat answers at the address the env file gives"
"services|8e|the-coordinator-answers|the coordinator answers on its own health route"
"services|8f|the-answer-service-answers|the answer service answers for a build nobody wrote down"
"services|8g|the-publisher-is-reachable-from-the-coordinator-only|the publisher answers the coordinator and refuses everything else"
"services|8h|the-front-door-answers|the Slack front door answers its own health route inside the estate, and the threads it saves are in a volume it can write rather than in the container - it publishes no port, because Slack is dialled out to and never heard from"
"services|8i|the-bus-gateway-is-on-the-bus|the bus gateway holds a live connection to the bus, asked of the BUS itself rather than of the gateway"
"services|9|the-answer-service-from-inside-a-sandbox|the coordinator's answer service answers FROM INSIDE a sandbox at the address the sandbox profile allows"
"pre-resume|10|the-producers-are-stopped|the two things that can bring work in are really stopped - no front-door and no bus-gateway container in this estate, the legacy host units inactive if they are on this machine, and nothing waiting or unconfirmed on the bus's two durable readers"
"pre-resume|10b|the-running-release-is-the-one-this-rollout-names|what is running is the release this rollout is FOR - the image the rollout names is resolved to an image id and compared with the image id the coordinator is really running, and a difference refuses the phase by name"
)

if [ "${MODE}" = "items" ]; then
    for row in "${ITEMS[@]}"; do
        IFS='|' read -r m n name sentence <<< "${row}"
        printf '%-8s %-3s %-46s %s\n' "${m}" "${n}" "${name}" "${sentence}"
    done
    exit 0
fi

[ -n "${MODE}" ] || { printf 'estate-check: say which check — "host" before starting, "services" after. Try --help.\n' >&2; exit 2; }

# ---------------------------------------------------------------------------
# The env file, read the way compose reads it: KEY=VALUE, '#' comments, and a
# ${NAME} in a value filled in from the environment or from a line above it.
# The shell's own environment wins, exactly as it does for compose — which is
# worth knowing, because that is how a stray exported name silently replaces a
# line in this file.
# ---------------------------------------------------------------------------
declare -A ENVV=()

value_of() {
    local name="$1"
    if [ -n "${!name:-}" ]; then printf '%s' "${!name}"; return; fi
    printf '%s' "${ENVV[$name]:-}"
}

expand() {
    local s="$1" out="" name v
    while [[ "${s}" =~ ^([^\$]*)\$\{([A-Za-z_][A-Za-z0-9_]*)(:\-([^}]*))?\}(.*)$ ]]; do
        out+="${BASH_REMATCH[1]}"
        name="${BASH_REMATCH[2]}"
        v="$(value_of "${name}")"
        if [ -z "${v}" ] && [ -n "${BASH_REMATCH[3]}" ]; then v="${BASH_REMATCH[4]}"; fi
        out+="${v}"
        s="${BASH_REMATCH[5]}"
    done
    printf '%s' "${out}${s}"
}

read_env_file() {
    local file="$1" line name value
    [ -f "${file}" ] || return 1
    while IFS= read -r line || [ -n "${line}" ]; do
        case "${line}" in ''|'#'*) continue ;; esac
        case "${line}" in *=*) ;; *) continue ;; esac
        name="${line%%=*}"
        value="${line#*=}"
        name="${name#"${name%%[![:space:]]*}"}"
        name="${name%"${name##*[![:space:]]}"}"
        case "${name}" in export\ *) name="${name#export }" ;; esac
        [[ "${name}" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]] || continue
        # surrounding quotes, as compose strips them
        if [ "${value:0:1}" = '"' ] && [ "${value: -1}" = '"' ] && [ ${#value} -ge 2 ]; then
            value="${value:1:${#value}-2}"
        elif [ "${value:0:1}" = "'" ] && [ "${value: -1}" = "'" ] && [ ${#value} -ge 2 ]; then
            value="${value:1:${#value}-2}"
        fi
        ENVV["${name}"]="$(expand "${value}")"
    done < "${file}"
}

if ! read_env_file "${ENV_FILE}"; then
    printf 'estate-check: there is no env file at %s. Copy .env.example to .env and fill in the lines marked CHANGE THIS.\n' "${ENV_FILE}" >&2
    exit 2
fi

get() { value_of "$1"; }

# An address with a password in it, said out loud safely.
redact() {
    printf '%s' "$1" | sed -E 's#(://[^:/@]+):[^@/]*@#\1:***@#'
}

# The host out of an address, whatever it carries: a scheme, a credential, a
# port and a path all come off.
# One sentence of trouble, or nothing: does the coordinator talk to the same
# bus host this check asks about? Used at the door and by the closed-door check.
the_same_bus_or_trouble() {
    local talked asked
    talked="$(host_of "$(get FORGE_NATS_URL)")"
    asked="$(host_of "$(the_buss_monitoring_address)")"
    if [ -n "${talked}" ] && [ -n "${asked}" ] && [ "${talked}" != "${asked}" ]; then
        printf ' the coordinator talks to the bus at %s and this check would ask about the bus at %s, which are two different hosts;' "'${talked}'" "'${asked}'"
    fi
}

host_of() {
    printf '%s' "$1" | sed -E 's#^[a-z]+://##; s#^[^@]*@##; s#[:/].*$##'
}

# ---------------------------------------------------------------------------
# WHOSE BUS IS IT (26 September 2026, build item E1).
#
#   local      this bundle's own bus, started and provisioned by this project.
#              Everything below behaves exactly as it did before this was added
#   external   a bus that is already running and belongs to somebody else. It is
#              NOT a service of this project, so 'docker compose ps -q nats'
#              finds nothing and every question to the bus goes BY ADDRESS from
#              inside the estate
#
# An env file that says nothing is read as 'local', because that is the
# clean-machine path and the one this bundle has always taken. A half-set
# external mode is what item 7b refuses.
# ---------------------------------------------------------------------------
BUS_MODE_IN_FORCE="$(get BUS_MODE)"
[ -n "${BUS_MODE_IN_FORCE}" ] || BUS_MODE_IN_FORCE="local"
EXTERNAL_BUS_FILE="${HERE}/compose.external-bus.yaml"

the_bus_is_external() { [ "${BUS_MODE_IN_FORCE}" = "external" ]; }

# THE BUS'S MONITORING ADDRESS, which takes no credential — that is the whole
# reason the estate's bus questions can be asked from an ordinary shell. Used in
# both modes: in local mode it is the bus service's own name and port.
the_buss_monitoring_address() {
    local address
    address="$(get BUS_MONITORING_ADDRESS)"
    if [ -z "${address}" ]; then
        # An env file written before this setting existed. The bus's monitoring
        # port is the bus repository's own, and the host is the one the
        # provisioning address names.
        address="$(host_of "$(get NATS_PROVISION_ADDRESS)")"
        [ -n "${address}" ] || address="nats"
        address="${address}:8222"
    fi
    printf '%s' "${address}"
}

# Ask the bus one of its own monitoring routes FROM INSIDE THE ESTATE, at the
# address the env file gives. This is how external mode asks: the bus is not a
# container of this project, so there is nothing of ours to step into, and the
# route is not published outside the estate, so it cannot be asked from here.
ask_the_bus_from() {
    local from="$1" route="$2" address
    [ -n "${from}" ] || return 2
    address="$(the_buss_monitoring_address)"
    docker exec "${from}" curl -sf --max-time 8 "http://${address}/${route}" 2>/dev/null
}

# ---------------------------------------------------------------------------
# Reporting
# ---------------------------------------------------------------------------
PASSES=0
FAILURES=0
UNCHECKED=0
# Items this MODE deliberately leaves out, which is a different thing from an
# item that could not be checked. Only the closed-door mode has any, and it has
# exactly two: the items that ask a producer, while the producers are
# deliberately stopped. They are never reported as passed and never as failed.
DELIBERATE=0

#: Every item's verdict, in order: number|verdict|sentence. The closed-door
#: mode writes these into its record so that what it found can be read back
#: rather than inferred from an exit code.
RESULTS=()

_record() { RESULTS+=("$1|$2|$3"); }

ok()        { PASSES=$((PASSES+1));     printf '  ok            %-4s %s\n' "$1" "$2"; _record "$1" ok "$2"; }
fail()      { FAILURES=$((FAILURES+1)); printf '  NOT PASSED    %-4s %s\n' "$1" "$2"; _record "$1" failed "$2"; }
unchecked() { UNCHECKED=$((UNCHECKED+1)); printf '  not checked   %-4s not checked here: %s\n' "$1" "$2"; _record "$1" not-checked "$2"; }

# NOT CHECKED ON PURPOSE, BY THIS MODE. Said differently from 'not checked',
# because the two mean opposite things: one is an unknown, and this is a
# deliberate exclusion with a stated place where the item IS checked.
not_checked_on_purpose() {
    DELIBERATE=$((DELIBERATE+1))
    printf '  NOT CHECKED   %-4s not checked in this mode: %s\n' "$1" "$2"
    _record "$1" not-checked-on-purpose "$2"
}

finish() {
    printf '\n'
    if [ "${FAILURES}" -eq 0 ] && [ "${UNCHECKED}" -eq 0 ]; then
        printf 'PASSED — %s items, all of them, and every one of them asked something.\n' "${PASSES}"
        [ "${DELIBERATE}" -eq 0 ] || printf '%s item(s) were left out of this mode on purpose, and are listed above with where they are checked instead.\n' "${DELIBERATE}"
        exit 0
    fi
    printf 'NOT PASSED — %s items asked something and passed, %s failed, %s could not be checked on this machine.\n' \
        "${PASSES}" "${FAILURES}" "${UNCHECKED}"
    [ "${DELIBERATE}" -eq 0 ] || printf '%s item(s) were left out of this mode on purpose, and are not counted either way.\n' "${DELIBERATE}"
    printf 'An item that could not be checked is not a pass: the gate is met when every item runs for real.\n'
    exit 1
}

# ---------------------------------------------------------------------------
# THE CHECK BEFORE ANYTHING STARTS
# ---------------------------------------------------------------------------
check_host() {
    printf 'estate-check host — this machine, before anything starts (env file: %s)\n\n' "${ENV_FILE}"

    # --- 1 -----------------------------------------------------------------
    local system arch platform supported found
    system="$(uname -s)"; arch="$(uname -m)"; platform="${system}/${arch}"
    supported="$(get ESTATE_SUPPORTED_PLATFORMS)"
    found="no"
    for candidate in ${supported}; do [ "${candidate}" = "${platform}" ] && found="yes"; done
    if [ "${found}" != "yes" ]; then
        fail 1 "this machine is ${platform}, and the release was proven on: ${supported:-nothing named in the env file}. A sandbox cannot be relied on here."
    elif [ "${system}" != "Linux" ]; then
        unchecked 1 "${platform} is supported, but this script only knows how to look for hardware virtualisation on Linux (/dev/kvm). Check the sandbox tool's own requirements for ${system}."
    elif [ -r /dev/kvm ]; then
        ok 1 "${platform} is supported and hardware virtualisation is available to this user (/dev/kvm is readable), so a sandbox can run here."
    else
        fail 1 "${platform} is supported, but /dev/kvm is not readable by this user, so a SANDBOX CANNOT RUN HERE. On a cloud machine that usually means nested virtualisation is switched off; on a local one, that this user is not in the kvm group."
    fi

    # --- 2 -----------------------------------------------------------------
    local docker_ok="yes" detail=""
    if ! command -v docker >/dev/null 2>&1; then
        fail 2 "docker is not on this machine's PATH, so nothing can start."
        docker_ok="no"
    elif ! docker version --format '{{.Server.Version}}' >/dev/null 2>&1; then
        fail 2 "docker is installed but its daemon does not answer, so nothing can start."
        docker_ok="no"
    elif ! docker compose version >/dev/null 2>&1; then
        fail 2 "docker is answering but 'docker compose' is not present, and the estate is compose files."
        docker_ok="no"
    else
        detail="docker $(docker version --format '{{.Server.Version}}'), $(docker compose version --short 2>/dev/null)"
        if [ -n "$(docker system info --format '{{.Username}}' 2>/dev/null)" ]; then
            detail="${detail}, a Docker sign-in is present"
        else
            detail="${detail}, no Docker sign-in (needed only if the sandbox tool asks for one)"
        fi
        ok 2 "Docker is installed and its daemon answers, and compose is here: ${detail}."
    fi

    # --- 3 -----------------------------------------------------------------
    local want_sbx have_sbx
    want_sbx="$(get ESTATE_SBX_VERSION)"
    if ! command -v sbx >/dev/null 2>&1; then
        fail 3 "the sandbox tool 'sbx' is not on this machine's PATH; a project with a sandbox cannot be built here."
    else
        have_sbx="$(sbx version 2>/dev/null | sed -n 's/.*version:[[:space:]]*\([^[:space:]]*\).*/\1/p' | head -1)"
        [ -n "${have_sbx}" ] || have_sbx="unreadable"
        if sbx daemon status 2>/dev/null | grep -qi '^Status:[[:space:]]*running'; then
            if [ "${have_sbx}" = "${want_sbx}" ]; then
                ok 3 "the sandbox tool is ${have_sbx}, which is the version this release was proven against, and its daemon answers on its socket."
            else
                fail 3 "the sandbox tool here is ${have_sbx} and this release was proven against ${want_sbx}. Its daemon answers, but this check does not guess whether a different version behaves the same; either match it or prove the estate against this one and change ESTATE_SBX_VERSION."
            fi
        else
            fail 3 "the sandbox tool is installed (${have_sbx}) but its daemon does not answer on its socket, so no sandbox can be started, held awake or reached."
        fi
    fi

    # --- 4 -----------------------------------------------------------------
    if [ "${docker_ok}" = "yes" ]; then
        local missing="" fetchable="" image
        for name in FORGE_IMAGE FORGE_PUBLISHER_IMAGE FLEET_MEMORY_MCP_IMAGE \
                    FLEET_MEMORY_RELAY_IMAGE NATS_IMAGE NATS_PROVISION_IMAGE; do
            image="$(get "${name}")"
            if [ -z "${image}" ]; then
                missing="${missing} ${name}=<nothing set>"
            elif docker image inspect "${image}" >/dev/null 2>&1; then
                :
            elif docker manifest inspect "${image}" >/dev/null 2>&1; then
                fetchable="${fetchable} ${image}"
            else
                missing="${missing} ${image}"
            fi
        done
        local volume
        volume="$(get BUS_SOURCE_VOLUME)"
        if [ -n "${volume}" ] && ! docker volume inspect "${volume}" >/dev/null 2>&1; then
            missing="${missing} the-volume-${volume}"
        fi
        if [ -n "${missing}" ]; then
            fail 4 "these are not on this machine and cannot be fetched:${missing}. Build the release with scripts/build-release-image.sh and the estate's own two with ./build-estate-images.sh, or point the env file at tags that exist."
        elif [ -n "${fetchable}" ]; then
            ok 4 "every image the env file names is here or can be fetched; these would be fetched on first start:${fetchable}. Checked by TAG: the design asks for digests and this bundle does not name them yet, which README.md records as a rollout precondition."
        else
            ok 4 "all six images the env file names are on this machine, and so is the volume holding the bus's own config. Checked by TAG: the design asks for digests and this bundle does not name them yet, which README.md records as a rollout precondition."
        fi
    else
        unchecked 4 "docker does not answer, so the images could not be looked for."
    fi

    # --- 5 -----------------------------------------------------------------
    #
    # THE VOLUMES ARE COUNTED OUT OF THE RENDERED BUNDLE, so a render that did
    # not happen must not be counted as no volumes. Before 24 September's
    # review this item printed "0 volumes are declared" and called itself ok
    # whenever the render had failed — a true-sounding sentence about nothing.
    if [ "${docker_ok}" = "yes" ]; then
        local root free_gb want_gb existing=0 declared=0 names why
        want_gb="$(get ESTATE_DISK_FREE_GB)"; want_gb="${want_gb:-0}"
        root="$(docker system info --format '{{.DockerRootDir}}' 2>/dev/null)"
        # Rendered HERE, in this shell, so that why-it-failed survives.
        compose_says config
        why="${COMPOSE_RENDER_PROBLEM}"
        names="$(volume_names_of "${COMPOSE_SAID}")"
        for v in ${names}; do
            declared=$((declared+1))
            docker volume inspect "${v}" >/dev/null 2>&1 && existing=$((existing+1))
        done
        free_gb="$(df -BG --output=avail "${root}" 2>/dev/null | tail -1 | tr -dc '0-9')"
        if [ -n "${why}" ]; then
            fail 5 "the volumes could not be counted, because this bundle would not render here: ${why}. Nothing was checked; the free space is a separate question and there is ${free_gb:-an unreadable amount}GB of it."
        elif [ "${declared}" -eq 0 ]; then
            fail 5 "the bundle rendered but declares no volumes at all, and this estate has at least the record, the settings, the evidence, the coordinator's own state, the publisher's and the bus's store. Something is wrong with the files this check read, not with this machine."
        elif [ -z "${free_gb}" ]; then
            unchecked 5 "the free space where Docker keeps its storage could not be read (${declared} volumes are declared, ${existing} of them already exist)."
        elif [ "${free_gb}" -lt "${want_gb}" ]; then
            fail 5 "${declared} volumes are declared (${existing} already exist, the rest are created at first start), but where Docker keeps its storage there is ${free_gb}GB free and this release asks for ${want_gb}GB."
        else
            ok 5 "${declared} volumes are declared (${existing} already exist, the rest are created at first start), and there is ${free_gb}GB free where Docker keeps its storage, above the ${want_gb}GB this release asks for."
        fi
    else
        unchecked 5 "docker does not answer, so the volumes and the disk could not be looked at."
    fi

    # --- 6 -----------------------------------------------------------------
    #
    # EACH FILE AGAINST ITS OWN SERVICE'S USER, which is what the design asks
    # for and what the env file now says: entries are 'path:uid'. The bus's
    # accounts file is never mounted into a container — the operator decrypts
    # it here — while the publisher's credential is mounted into the publisher
    # and must belong to the user that image runs as. On a single-user machine
    # those are the same number today, which is exactly why one number for all
    # of them looked fine until the estate met a machine where they differ.
    local files fallback bad="" absent="" guessed="" mode uid want entry path checked=0
    files="$(get ESTATE_SECRET_FILES)"
    fallback="$(get ESTATE_OPERATOR_UID)"
    [ -n "${fallback}" ] || fallback="$(get ESTATE_SECRET_OWNER_UID)"
    if [ -z "${files}" ]; then
        fail 6 "the env file names no secret files at all (ESTATE_SECRET_FILES is empty), and the estate needs at least the bus's accounts and the publisher's credential."
    else
        for entry in ${files}; do
            path="${entry%:*}"
            want="${entry##*:}"
            # 'path' alone, or 'path:' with nothing after it (which is what a
            # user id name with no value leaves behind), is checked against the
            # operator's and says so.
            if [ "${want}" = "${entry}" ] || [ -z "${want}" ]; then
                path="${entry%:}"
                want="${fallback}"
                guessed="${guessed} ${path}"
            fi
            checked=$((checked+1))
            if [ ! -e "${path}" ]; then absent="${absent} ${path}"; continue; fi
            mode="$(stat -c '%a' "${path}" 2>/dev/null || stat -f '%Lp' "${path}" 2>/dev/null)"
            uid="$(stat -c '%u' "${path}" 2>/dev/null || stat -f '%u' "${path}" 2>/dev/null)"
            [ "${uid}" = "${want}" ] || bad="${bad} ${path}(owned by uid ${uid}, and the service that reads it runs as ${want})"
            case "${mode}" in
                *[1-7][0-7]|*[0-7][1-7]) bad="${bad} ${path}(mode ${mode}: others can read it)" ;;
            esac
        done
        if [ -n "${absent}" ] || [ -n "${bad}" ]; then
            fail 6 "secret files:${absent:+ missing:${absent}}${bad:+ wrong:${bad}}. Nothing here opened a file or printed anything out of one."
        else
            local note=""
            [ -z "${guessed}" ] || note=" — and these were checked against the operator user id ${fallback}, because the env file named no user id for them:${guessed}"
            ok 6 "all ${checked} secret files the env file names are present, and each is readable only by the user id the env file gives for it${note}. Nothing here opened one or printed anything out of one."
        fi
    fi

    # --- 7 -----------------------------------------------------------------
    local required unset_names="" v
    required="$(required_setting_names)"
    for name in ${required}; do
        v="$(value_of "${name}")"
        [ -n "${v}" ] || unset_names="${unset_names} ${name}"
    done
    # THE GATEWAY ADDRESS IS A VALUE THIS CHECK JUDGES, not merely counts
    # (the stage 4a reviewer, 24 September 2026: a gateway of 0.0.0.0 rendered,
    # published both ports on every interface, and this check said PASSED).
    # The compose file's own words: it is never 0.0.0.0 and never blank, because
    # either puts the estate on the local network, which the per-route policy
    # forbids. So a gateway that is blank, all-interfaces, or not an address at
    # all fails item 7 by name.
    local gateway_value
    gateway_value="$(value_of FACTORY_GATEWAY_ADDRESS)"
    case "${gateway_value}" in
        ""|0.0.0.0|::|"[::]") unset_names="${unset_names} FACTORY_GATEWAY_ADDRESS(is '${gateway_value:-blank}': it must be one private address of this machine, never blank and never every interface)" ;;
    esac
    if [ -n "${unset_names}" ]; then
        fail 7 "the composed files require these setting names and nothing set them, or set them to a value that cannot be used:${unset_names}. A password name among them means the command was not run the way README.md says, with the values passed in from a child process."
    else
        ok 7 "every setting name the composed files require has a value ($(printf '%s' "${required}" | wc -w) of them), including the ones whose values are passed in rather than written down, and the gateway address is a single address rather than every interface."
    fi

    # --- 7b ----------------------------------------------------------------
    check_the_bus_mode_and_the_files_agree

    finish
}

# ---------------------------------------------------------------------------
# ITEM 7b — BUS_MODE, AND THE TWO SETTINGS THAT CARRY IT INTO COMPOSE
# (26 September 2026, build item E1).
#
# WHY THIS IS AN ITEM AND NOT A COMMENT. BUS_MODE is a word in the env file and
# it does nothing on its own: what actually decides whether this estate starts a
# bus of its own are two settings compose reads for itself, COMPOSE_PROFILES and
# COMPOSE_FILE. A half-set mode — 'external' with the local profile still asked
# for — renders perfectly well and starts a SECOND BUS beside the one that was
# being kept, which is the one mistake this whole mode exists to stop. So the
# word and the two settings are checked against each other, before anything
# starts, and any disagreement is a refusal that names both sides.
#
# Checked offline on this machine's Compose (v5.2.0): an explicit '-f' on the
# command line wins over COMPOSE_FILE, and '--profile' on the command line
# REPLACES COMPOSE_PROFILES rather than adding to it. Both are why this reads the
# values in force rather than trusting the file.
# ---------------------------------------------------------------------------
check_the_bus_mode_and_the_files_agree() {
    local mode profiles files trouble="" said
    mode="$(get BUS_MODE)"
    profiles="$(get COMPOSE_PROFILES)"
    files="$(get COMPOSE_FILE)"
    said="BUS_MODE='${mode:-nothing set, so this reads as local}', COMPOSE_PROFILES='${profiles}', COMPOSE_FILE='${files}'"

    case "${mode}" in
        ""|local|external) ;;
        *)
            fail 7b "BUS_MODE is '${mode}' and it has to say local or external. Local means this bundle starts its own bus; external means the bus is already running and belongs to somebody else."
            return
            ;;
    esac

    local has_local_profile="no" has_external_file="no"
    case ",${profiles}," in *,local-bus,*) has_local_profile="yes" ;; esac
    case "${files}" in *compose.external-bus.yaml*) has_external_file="yes" ;; esac

    if the_bus_is_external; then
        [ "${has_local_profile}" = "no" ] || trouble="${trouble} the local-bus profile is still asked for, so this project would START ITS OWN BUS beside the one being kept;"
        [ "${has_external_file}" = "yes" ] || trouble="${trouble} COMPOSE_FILE does not name compose.external-bus.yaml, so nothing joins the retained bus's network and the project would not render;"
        [ -f "${EXTERNAL_BUS_FILE}" ] || trouble="${trouble} there is no compose.external-bus.yaml beside this script;"
        [ -n "$(get BUS_EXTERNAL_NETWORK)" ] || trouble="${trouble} BUS_EXTERNAL_NETWORK names no network, and external mode joins a network that already exists rather than making one;"
        local network
        network="$(get BUS_EXTERNAL_NETWORK)"
        if [ -n "${network}" ] && command -v docker >/dev/null 2>&1; then
            docker network inspect "${network}" >/dev/null 2>&1 \
                || trouble="${trouble} there is no docker network called '${network}' on this machine, and external mode joins one that already exists;"
        fi
    else
        [ "${has_local_profile}" = "yes" ] || trouble="${trouble} local mode needs COMPOSE_PROFILES to include local-bus, and it does not — without it the bus and the provisioner are not in the project at all;"
        [ "${has_external_file}" = "no" ] || trouble="${trouble} COMPOSE_FILE names compose.external-bus.yaml while BUS_MODE says local, which would start this estate's own bus AND join somebody else's;"
    fi

    # THE ADDRESS THE BUS IS TALKED TO AND THE ADDRESS IT IS ASKED ABOUT MUST BE
    # THE SAME BUS. Two different hosts would mean the estate checked one bus and
    # used another, and every item below would be true about the wrong one.
    # Asked here at the door AND again by the closed-door check (the E1/E2
    # review of 26 September 2026: it was host-only, and a closed-door record
    # could describe a bus the coordinator does not use).
    local same_bus_trouble
    same_bus_trouble="$(the_same_bus_or_trouble)"
    [ -z "${same_bus_trouble}" ] || trouble="${trouble}${same_bus_trouble}"
    case "$(the_buss_monitoring_address)" in
        *@*) trouble="${trouble} BUS_MONITORING_ADDRESS carries a credential, and that route takes none;" ;;
    esac

    if [ -n "${trouble}" ]; then
        fail 7b "the bus mode and the settings that carry it disagree (${said}):${trouble}"
    else
        ok 7b "this estate runs against ${BUS_MODE_IN_FORCE} bus mode, and the settings in force say the same thing (${said}). The bus's monitoring address is ${asked}, which is the same host the coordinator talks to."
    fi
}

# Every ${NAME:?...} in the files the estate composes: the names that have no
# default and that compose refuses to render without. Also every ${NAME} the
# env file's own values are built out of, and every name a SECRET is read from
# — which is where the bus's eight account passwords come in. A secret names an
# environment variable rather than interpolating one, so it is deliberately
# invisible to the first rule: compose renders the bundle without it and
# refuses to START without it, which is why this check is the place the
# operator finds out before starting.
required_setting_names() {
    local indirect=""
    local files=(
        "${HERE}/compose.yaml"
        "${HERE}/../compose/compose.yaml"
        "${HERE}/../compose/compose.sandbox-runner.yaml"
        "${HERE}/../../src/forge/publisher/compose-fragment.yml"
    )
    # THE EXTERNAL-BUS OVERLAY IS ONE OF THE COMPOSED FILES WHEN IT IS IN FORCE,
    # and it requires a name of its own — the retained bus's network. In local
    # mode it is not part of the project, so requiring its name would refuse a
    # perfectly good clean machine.
    if the_bus_is_external; then
        files+=("${EXTERNAL_BUS_FILE}")
    fi
    local present=()
    for f in "${files[@]}"; do [ -f "${f}" ] && present+=("${f}"); done
    # A comment is not a setting. These files explain themselves at length and
    # write names in their prose; only the lines that compose acts on count.
    {
        if [ ${#present[@]} -gt 0 ]; then
            /bin/grep -hv '^[[:space:]]*#' "${present[@]}" 2>/dev/null \
                | /bin/grep -o '\${[A-Za-z_][A-Za-z0-9_]*:?' \
                | sed 's/^\${//; s/:?$//'
            # A secret's source: 'environment: NAME' on a line of its own. A
            # service's own environment block is never written that way.
            /bin/grep -hE '^[[:space:]]+environment:[[:space:]]+[A-Za-z_][A-Za-z0-9_]*[[:space:]]*$' "${present[@]}" 2>/dev/null \
                | awk '{print $2}'
        fi
        /bin/grep -hv '^[[:space:]]*#' "${ENV_FILE}" 2>/dev/null \
            | /bin/grep -o '\${[A-Za-z_][A-Za-z0-9_]*}' \
            | sed 's/^\${//; s/}$//'
        # And the one a secret's source is named INDIRECTLY by: the env file
        # says which password name the provisioning account uses, so that name
        # has to have a value too.
        indirect="$(value_of NATS_PROVISION_PASSWORD_NAME)"
        [ -n "${indirect}" ] && printf '%s\n' "${indirect}"
    } | sort -u
}

# ---------------------------------------------------------------------------
# RENDERING THE BUNDLE. Everything that has to know what is in the estate —
# which volumes it declares, which container a service is — asks compose, and
# compose can refuse: a missing name, a file that is not there, a syntax error.
# "It would not render" and "that service is not running" are completely
# different sentences and this check must never print the second when it means
# the first. (On 24 September's review it did, four times in one run, against a
# perfectly healthy estate.) So every render goes through here, and the reason
# it failed is kept for whoever asks.
# ---------------------------------------------------------------------------
COMPOSE_RENDER_PROBLEM=""
COMPOSE_SAID=""

# EVERY COMPOSE COMMAND THIS SCRIPT MAKES, WITH THE FILES THE MODE IN FORCE
# REALLY HAS. An explicit '-f' wins over COMPOSE_FILE (checked on Compose
# v5.2.0), and this names its files explicitly so that it reads the same bundle
# wherever it is run from — so in external mode it has to add the overlay
# itself, or it would render a project with a bus in it that is not there.
dc() {
    local files=(-f "${HERE}/compose.yaml")
    if the_bus_is_external; then
        files+=(-f "${EXTERNAL_BUS_FILE}")
    fi
    docker compose --env-file "${ENV_FILE}" "${files[@]}" \
        ${PROJECT:+--project-name "${PROJECT}"} "$@"
}

# Run a compose command and put what it said in COMPOSE_SAID, and why it failed
# (if it did) in COMPOSE_RENDER_PROBLEM. Returns compose's own exit code.
#
# TWO THINGS THIS HAS TO GET RIGHT, both met on 24 September 2026:
#
#   * IT KEEPS THE TWO STREAMS APART. Compose writes warnings to its error
#     stream even when it succeeds — "the FORGE_NATS_PASSWORD variable is not
#     set", which is exactly what a clean shell produces and exactly what this
#     bundle now intends. Folded in with 2>&1, a warning became the container
#     id, every 'docker exec' was handed a sentence instead of a container, and
#     a perfectly healthy estate was reported dead;
#   * IT IS CALLED IN THIS SHELL, never inside "$( )" or on the left of a pipe.
#     A variable set in a subshell is lost when it ends, and the whole point of
#     these two is to be read afterwards.
compose_says() {
    local err status
    err="$(mktemp)"
    COMPOSE_SAID="$(dc "$@" 2>"${err}")"
    status=$?
    COMPOSE_RENDER_PROBLEM=""
    if [ "${status}" -ne 0 ]; then
        COMPOSE_RENDER_PROBLEM="$(/bin/grep -v '^[[:space:]]*$' "${err}" | /bin/grep -v 'level=warning' | head -2 | tr '\n' ' ')"
        [ -n "${COMPOSE_RENDER_PROBLEM}" ] || COMPOSE_RENDER_PROBLEM="docker compose exited ${status} without saying why"
    fi
    rm -f "${err}"
    return "${status}"
}

# The volumes as DOCKER will know them, not as the compose file keys them: a
# compose-managed volume is named after the project, and an external one keeps
# its own name. 'config --volumes' prints the keys, so this reads the rendered
# document instead and takes each volume's real name.
volume_names_of() {
    printf '%s' "$1" \
    | awk '
        /^volumes:$/ { inside = 1; next }
        /^[a-z]/     { inside = 0 }
        inside && $1 == "name:" { print $2 }
    '
}

# ---------------------------------------------------------------------------
# THE CHECK AFTER IT HAS STARTED
# ---------------------------------------------------------------------------
container_of() { dc ps -q "$1" 2>/dev/null | head -1; }

check_services() {
    printf 'estate-check services — the estate, after it has started (env file: %s, %s bus mode)\n\n' "${ENV_FILE}" "${BUS_MODE_IN_FORCE}"
    run_the_services_items full
    finish
}

# ---------------------------------------------------------------------------
# THE SERVICE ITEMS, IN ONE PLACE, ASKED BY TWO MODES.
#
#   full          every item, including the two that ask a producer
#   closed-door   the same estate with the two producers deliberately STOPPED:
#                 the producer items are not checked, and a producer that IS
#                 running is the failure (26 September 2026, build item E2)
#
# One list of items and two readings of it, rather than two lists that can
# drift apart.
# ---------------------------------------------------------------------------
run_the_services_items() {
    local phase="$1"
    local coordinator answer bus
    # THE ONE RENDER THAT DECIDES WHETHER THERE IS ANYTHING TO ASK, made in
    # this shell so that its reason survives (see compose_says above).
    compose_says ps -q coordinator
    coordinator="$(printf '%s' "${COMPOSE_SAID}" | head -1)"
    answer="$(container_of answer-service)"
    # In external bus mode the bus is not a service of this project, so there is
    # no container of ours to find and none is looked for. Every question to the
    # bus then goes by address, from inside the estate.
    bus=""
    the_bus_is_external || bus="$(container_of nats)"

    # THE BUNDLE ITSELF WOULD NOT RENDER. Nothing below could have found a
    # container, so say that once, plainly, instead of reporting five services
    # as down. Every one of these items is then unchecked, not failed, because
    # nothing was asked of the estate at all.
    if [ -n "${COMPOSE_RENDER_PROBLEM}" ]; then
        printf '  This estate could not be read at all: %s\n\n' "${COMPOSE_RENDER_PROBLEM}"
        for row in "${ITEMS[@]}"; do
            IFS='|' read -r m n name sentence <<< "${row}"
            case "${m}" in
                services) ;;
                pre-resume) [ "${phase}" = "closed-door" ] || continue ;;
                *) continue ;;
            esac
            unchecked "${n}" "the estate bundle would not render here, so nothing could be asked of it. This is a problem with the files or the env file, not with any service."
        done
        return 1
    fi

    # --- 10 and 10b --------------------------------------------------------
    # THE CLOSED DOOR ITSELF, and WHICH RELEASE this phase is about. Both only
    # in the closed-door mode, and both before anything else is asked: a record
    # about the wrong release is worse than no record.
    if [ "${phase}" = "closed-door" ]; then
        check_the_producers_are_stopped "${coordinator}"
        check_the_release_is_the_one_this_rollout_names "${coordinator}"
    fi

    # --- 8 -----------------------------------------------------------------
    local bus_url address
    bus_url="$(get FORGE_NATS_URL)"
    address="$(the_buss_monitoring_address)"
    if the_bus_is_external; then
        if [ -z "${coordinator}" ]; then
            fail 8 "the bus is not this project's — it is the one that was already running — so it is asked at ${address} from inside the estate, and the coordinator is not running to ask from."
        elif ask_the_bus_from "${coordinator}" healthz >/dev/null 2>&1; then
            ok 8 "the bus answers its monitoring health route at ${address}, asked from inside the coordinator (this estate did not start that bus and holds no container of it; the estate reaches it for work at $(redact "${bus_url}"), which item 8e proves separately through the coordinator's live subscription)."
        else
            fail 8 "the bus does not answer its monitoring health route at ${address}, asked from inside the coordinator. In external bus mode that usually means BUS_EXTERNAL_NETWORK does not name the network that bus is really on, or BUS_MONITORING_ADDRESS does not name it on that network."
        fi
    elif [ -z "${bus}" ]; then
        fail 8 "the bus is not running in this estate, so nothing could ask it anything."
    elif docker exec "${bus}" wget --spider -q "http://localhost:8222/healthz" >/dev/null 2>&1; then
        ok 8 "the bus answers its own health route inside its container (what was asked: localhost:8222/healthz there; the estate reaches it at $(redact "${bus_url}"), which item 8e proves separately through the coordinator's live subscription)."
    else
        fail 8 "the bus is running but does not answer its own health route, so nothing on the estate can use it."
    fi

    # --- 8b ----------------------------------------------------------------
    check_bus_storage

    # --- 8c / 8c-relay / 8c-forge / 8d --------------------------------------
    check_named_address 8c "the memory service" "$(get FLEET_MEMORY_URL)" "${coordinator}"
    check_the_memory_relay
    check_the_coordinators_own_memory "${coordinator}"
    check_named_address 8d "the model seat"     "$(get MODEL_SEAT_URL)"   "${coordinator}"

    # --- 8e ----------------------------------------------------------------
    local code
    if [ -z "${coordinator}" ]; then
        fail 8e "the coordinator is not running in this estate."
    else
        code="$(docker exec "${coordinator}" curl -s -o /dev/null -w '%{http_code}' http://localhost:8080/healthz 2>/dev/null)"
        if [ "${code}" = "200" ]; then
            ok 8e "the coordinator answers its own health route with 200, which it only does once its subscription to the bus is live."
        else
            fail 8e "the coordinator answered its health route with ${code:-nothing}. It answers 503 until its subscription to the bus is live, so this usually means the bus."
        fi
    fi

    # --- 8f ----------------------------------------------------------------
    local port answer_url body
    port="$(get FORGE_ANSWER_PORT)"
    answer_url="http://answer-service:8126/recorded?build=a-build-nobody-ever-queued"
    if [ -z "${answer}" ] || [ -z "${coordinator}" ]; then
        fail 8f "the answer service or the coordinator is not running, so the read-only answer could not be asked for."
    else
        body="$(docker exec "${coordinator}" curl -s -w ' HTTP %{http_code}' "${answer_url}" 2>/dev/null)"
        if printf '%s' "${body}" | grep -q 'HTTP 200' && printf '%s' "${body}" | grep -qi 'false'; then
            ok 8f "the answer service answers for a build nobody wrote down — it says so rather than failing (asked at ${answer_url}, published for a sandbox at $(get FACTORY_GATEWAY_ADDRESS):${port})."
        else
            fail 8f "the answer service did not give a plain answer for an unknown build; it said: ${body:-nothing}."
        fi
    fi

    # --- 8g ----------------------------------------------------------------
    local publisher_url from_coordinator from_elsewhere
    publisher_url="$(get FORGE_PUBLISHER_URL)"
    if [ -z "${coordinator}" ] || [ -z "${answer}" ]; then
        fail 8g "the coordinator or the answer service is not running, so who can reach the publisher could not be established."
    else
        from_coordinator="$(docker exec "${coordinator}" curl -s -o /dev/null --max-time 8 -w '%{http_code}' "${publisher_url}/healthz" 2>/dev/null)"
        from_elsewhere="$(docker exec "${answer}" curl -s -o /dev/null --max-time 8 -w '%{http_code}' "${publisher_url}/healthz" 2>/dev/null)"
        if [ "${from_coordinator}" = "200" ] && [ "${from_elsewhere}" != "200" ]; then
            ok 8g "the publisher answers the coordinator (200 at ${publisher_url}) and refuses the answer service, which is on the factory network only — the coordinator is the only thing on both networks, and that is the whole route to the publisher. This is ONE forbidden direction; the design asks for every one of them, including from the local network and repeated after a restart, and README.md records that as a rollout precondition this check does not meet."
        elif [ "${from_coordinator}" != "200" ]; then
            fail 8g "the coordinator could not reach the publisher at ${publisher_url} (it said ${from_coordinator:-nothing}), so the merge word would have nothing to hand a joined commit to."
        else
            fail 8g "the answer service CAN reach the publisher at ${publisher_url}, and nothing but the coordinator should be able to. The publisher holds the one credential that can write to a project's remote."
        fi
    fi

    # --- 8h / 8i -----------------------------------------------------------
    #
    # THE TWO PRODUCER ITEMS. In the ordinary mode a stopped front door is the
    # failure. In the closed-door mode a RUNNING one is the failure, and item 10
    # above is what says so — so these two are not asked here at all, and are
    # never reported as passed. The same fact, read opposite ways, which is why
    # one reading cannot serve both.
    if [ "${phase}" = "closed-door" ]; then
        not_checked_on_purpose 8h "this item asks a producer, and the producers are deliberately stopped; it is checked after the door opens, by the full 'estate-check services'."
        not_checked_on_purpose 8i "this item asks a producer, and the producers are deliberately stopped; it is checked after the door opens, by the full 'estate-check services'."
    else
        check_the_front_door
        check_the_bus_gateway "${bus}" "${coordinator}"
    fi

    # --- 9 -----------------------------------------------------------------
    check_from_inside_a_sandbox
    return 0
}

# THE SLACK FRONT DOOR. Where Rich approves a spec, taps a build gate and says
# merge. Added 25 September 2026, stage 4c.
#
# IT PUBLISHES NO PORT, so this is asked INSIDE its own container — and that is
# not a weaker question than it looks. Slack pushes nothing to this estate: the
# front door dials out to Slack over a WebSocket, so there is no inbound route
# to open and nothing outside this estate should be able to reach it at all.
# What its own health route answers is whether the server is up and its graphs
# loaded, which is the whole of what this service being "up" means.
#
# WHAT THIS ITEM DOES NOT PROVE, said here rather than left to be assumed: that
# Slack is reachable, that the token works, or that a message would arrive.
# Those need the real workspace, and no check in this bundle touches it.
#
# IT ALSO ASKS WHERE THE SAVED THREADS GO (26 September 2026), because a review
# of release 2026.09.26-1 found the answering half of this item true and the
# other half missing: the server answered this route perfectly while its threads
# sat in the container's own writable layer, so a replacement container answered
# 404 for a thread its predecessor had — and replacing a container is how this
# estate takes a new release. It is part of this item rather than an item of its
# own because it is the same question, whether the front door can do its job.
THE_FRONT_DOORS_STATE_PATH=/app/.langgraph_api

# Asked of the RUNNING CONTAINER, not of the compose file: the file is what
# should be true and the container is what is. Writable as well as mounted,
# because a fresh named volume takes its ownership from the image and on an image
# that does not create that directory it comes up root-owned — where the server
# would answer this route and then lose every approval.
#
# WHAT THIS DOES NOT PROVE, plainly: it does not replace the container and read a
# thread back. That is a drive rather than a check, and the release's own
# evidence carries it.
the_front_doors_state() {
    local door="$1" path="$2" mounted
    mounted="$(docker inspect --format \
        "{{range .Mounts}}{{if eq .Destination \"${path}\"}}{{.Name}}{{end}}{{end}}" \
        "${door}" 2>/dev/null | tr -d '\r')"
    if [ -z "${mounted}" ]; then
        printf 'nothing-mounted'
        return
    fi
    if docker exec "${door}" sh -c "touch '${path}/.estate-check' && rm -f '${path}/.estate-check'" >/dev/null 2>&1; then
        printf 'kept|%s' "${mounted}"
    else
        printf 'not-writable|%s' "${mounted}"
    fi
}

check_the_front_door() {
    local door code state volume
    door="$(container_of front-door)"
    if [ -z "${door}" ]; then
        fail 8h "the Slack front door is not running in this estate, so Rich has nowhere to approve a spec or say merge."
        return
    fi
    code="$(docker exec "${door}" python -c "
import sys, urllib.request
try:
    print(urllib.request.urlopen('http://localhost:2024/ok', timeout=8).status)
except Exception as why:
    print(type(why).__name__); sys.exit(1)
" 2>/dev/null | tr -d '\r')"
    state="$(the_front_doors_state "${door}" "${THE_FRONT_DOORS_STATE_PATH}")"
    volume="${state#*|}"
    if [ "${code}" != "200" ]; then
        fail 8h "the Slack front door is running but did not answer its own health route; it said ${code:-nothing}. It answers once both its graphs have loaded, so look at its log for the model seat address or its key."
    elif [ "${state}" = "nothing-mounted" ]; then
        fail 8h "the Slack front door answers its own health route, and nothing is mounted at ${THE_FRONT_DOORS_STATE_PATH}, where it writes the threads Rich approves a spec and says merge in. This container keeps them in its own writable layer, so replacing it — which is how this estate takes a new release — deletes them. Start it from this bundle, which gives it the front-door-state volume."
    elif [ "${state%%|*}" = "not-writable" ]; then
        fail 8h "the Slack front door answers its own health route, and it cannot write ${THE_FRONT_DOORS_STATE_PATH} inside the volume ${volume} — so it would take an approval and lose it. A fresh volume takes its ownership from the image: this needs a jarvis image whose own user owns that directory."
    else
        ok 8h "the Slack front door answers its own health route with 200 inside its container (localhost:2024/ok there), which it only does once both its graphs have loaded, and the threads it saves go into the volume ${volume} at ${THE_FRONT_DOORS_STATE_PATH}, which it can write — so replacing this container does not delete them. It publishes no port on purpose: Slack is dialled out to over a WebSocket and never heard from, so there is no inbound route for this machine to open. Whether Slack itself answers is not asked here, nothing in this bundle touches that workspace, and this item does not itself replace the container and read a thread back."
    fi
}

# THE BUS GATEWAY, asked of the BUS rather than of the gateway.
#
# There is nothing to ask this service over a network: it publishes no port,
# talks outbound to the bus and to Slack, and answers nobody. Asking whether
# its container is running would prove only that a process exists — and this
# command treats the broker as a hard dependency and exits rather than running
# on without it, so "running" and "connected" are nearly the same thing and
# neither is evidence of the other.
#
# So the question goes to the bus, over the bus's own monitoring route, which
# takes no credential: does the bus hold a live connection from the jarvis
# account? That route is not published outside the estate, so it is asked from
# inside the bus's own container. Account names are printed; no password is
# read, and none is printable this way.
check_the_bus_gateway() {
    local bus="$1" coordinator="${2:-}" account seen answer asked_at
    account="$(get JARVIS_NATS_USER)"
    if [ -z "${account}" ]; then
        unchecked 8i "the env file names no bus account for the front door (JARVIS_NATS_USER), so the bus could not be asked whether that account is connected."
        return
    fi
    # The bus pretty-prints this answer and calls the field 'authorized_user',
    # so the spaces and newlines come out before the field is looked for.
    #
    # WHERE IT IS ASKED FROM depends on whose bus it is. Our own bus is stepped
    # into; a bus that is already running and belongs to somebody else is asked
    # BY ADDRESS from inside the coordinator, because this project holds no
    # container of it and that route is not published outside the estate.
    if the_bus_is_external; then
        asked_at="$(the_buss_monitoring_address)"
        if [ -z "${coordinator}" ]; then
            fail 8i "the bus is not this project's, so it is asked at ${asked_at} from inside the estate, and the coordinator is not running to ask from."
            return
        fi
        answer="$(ask_the_bus_from "${coordinator}" 'connz?auth=1')"
        if [ -z "${answer}" ]; then
            fail 8i "the bus did not answer connz at ${asked_at}, asked from inside the coordinator, so who is connected to it could not be read at all."
            return
        fi
    else
        asked_at="its own container (localhost:8222)"
        if [ -z "${bus}" ]; then
            fail 8i "the bus is not running in this estate, so it could not be asked who is connected to it."
            return
        fi
        answer="$(docker exec "${bus}" wget -qO- "http://localhost:8222/connz?auth=1" 2>/dev/null)"
    fi
    seen="$(printf '%s' "${answer}" | tr -d ' \n' | /bin/grep -o "\"authorized_user\":\"${account}\"" | wc -l)"
    if [ "${seen:-0}" -gt 0 ]; then
        ok 8i "the bus itself reports ${seen} live connection(s) from the '${account}' account, which is the bus gateway holding the bus open — asked of the bus, not of the gateway, because the gateway publishes nothing and answers nobody. No password was read and none is printable this way."
    else
        fail 8i "the bus reports no connection from the '${account}' account, so Slack traffic has no way onto the bus and the factory's answers have no way back. The gateway refuses to start at all without the bus, so look at its log: usually the account's password, or the address."
    fi
}

# THE MEMORY RELAY. There is nothing to ask it over a network: it listens on
# the bus and answers nobody, and it publishes no port on purpose. What it does
# emit is one small file — when it started, when it last wrote something to
# memory, how many of each — and it writes that file after every message
# BECAUSE a clean ingest is otherwise completely silent, which is how the
# memory flywheel once went dark for a month with nothing saying so.
#
# So that file is what this item asks for, INSIDE the relay's own volume. A
# marker that is there says the relay got all the way up: it is written in the
# relay's start-up, after the store is open. A relay that is running but has
# never written one has not finished starting, and this says which.
check_the_memory_relay() {
    local relay marker
    relay="$(container_of memory-relay)"
    marker="/var/lib/fleet-memory/relay-progress.json"
    if [ -z "${relay}" ]; then
        fail 8c-relay "the memory relay is not running in this estate, so nothing is writing what the factory hears on the bus into memory."
    elif docker exec "${relay}" test -f "${marker}" >/dev/null 2>&1; then
        ok 8c-relay "the memory relay is running and has written its progress marker at ${marker}, inside its own volume rather than a folder under anybody's home directory — which is the relay's only sign of life, because a clean ingest is silent."
    else
        fail 8c-relay "the memory relay is running but has not written its progress marker at ${marker}. It writes that file as it starts, after the store is open, so this usually means it has not got that far: look at its log for the store or the bus."
    fi
}

# THE COORDINATOR'S OWN MEMORY, which is not the same question as item 8c.
#
# WHY THIS ITEM EXISTS (added 25 September 2026, after the review of this
# stage). Item 8c asks the memory SERVICE, and the memory service's caller is a
# Claude session talking MCP from outside the estate. The coordinator does not
# use it: Forge reads the factory's memory itself, at gate time, straight out of
# the store. So item 8c passing says nothing at all about whether anything IN
# the estate is using memory — and the bundle used to give the coordinator none
# of Forge's five memory settings, which Forge does not refuse: it logs one
# line, hands the gate an empty reader, and looks perfectly healthy. Every other
# item in this list still passed. That is how the memory flywheel goes dark
# without anything saying so, which has happened here before and cost a month.
#
# WHAT IS ASKED. The coordinator's own words, in its own log, at its own boot:
# Forge writes "memory: ON", "memory: OFF" or "memory: DEGRADED" and there is
# no fourth answer. Nothing here reads a setting or a secret; it reads what the
# program said about itself.
check_the_coordinators_own_memory() {
    local coordinator="$1" line
    if [ -z "${coordinator}" ]; then
        fail 8c-forge "the coordinator is not running in this estate, so it could not be asked whether its own memory is on."
        return
    fi
    line="$(docker logs "${coordinator}" 2>&1 | /bin/grep -E 'memory: (ON|OFF|DEGRADED)' | tail -1)"
    case "${line}" in
        *"memory: ON"*)
            ok 8c-forge "the coordinator says its own memory is ON — its own words at its own boot: \"$(redact "${line#*memory: }")\". This is the coordinator reading the STORE at gate time, which is a different path from the memory service item 8c asks; the memory service's caller is a Claude session over MCP."
            ;;
        *"memory: DEGRADED"*)
            fail 8c-forge "the coordinator says its memory is DEGRADED: \"$(redact "${line#*memory: }")\". It was told memory is on and cannot load what it needs to read the store, so its gates run with no priors while everything else here looks healthy."
            ;;
        *"memory: OFF"*)
            unchecked 8c-forge "the coordinator says its memory is OFF, which the env file asked for (FLEET_MEMORY_ENABLED=false). That is a decision and not a fault, but it is not a pass either: this estate's gates read no priors, and nothing else in this check would have told you."
            ;;
        *)
            fail 8c-forge "the coordinator has said nothing about memory in its log, and it says one of ON, OFF or DEGRADED at every boot. Either it has not finished starting or this is not the coordinator's log."
            ;;
    esac
}

# A part of the design's item 8 that the estate does not carry yet.
#
# WITH NO ADDRESS NAMED THIS IS NOT A PASS. It used to be: the item printed
# "there is nothing to ask" and counted itself ok, so a run could report seven
# passes of which two had asked nothing. That is the same situation as item 9 —
# a thing never asked — and item 9 has always counted as not passed. The design
# names the memory service and the model seat in item 8; until they are in the
# bundle and answering, that item has not run.
check_named_address() {
    local number="$1" what="$2" url="$3" from="$4" code
    if [ -z "${url}" ]; then
        unchecked "${number}" "${what} has no address in the env file, so nothing was asked. It is not in this bundle yet — README.md says which parts are still to come — and the design's item 8 names it, so this is an item that has not run rather than one that passed."
        return
    fi
    if [ -z "${from}" ]; then
        fail "${number}" "${what} is named (${url}) but the coordinator is not running, so nothing could ask it."
        return
    fi
    code="$(docker exec "${from}" curl -s -o /dev/null --max-time 8 -w '%{http_code}' "${url}" 2>/dev/null)"
    if [ -n "${code}" ] && [ "${code}" != "000" ]; then
        ok "${number}" "${what} answers at the address the env file gives (${url}, HTTP ${code})."
    else
        fail "${number}" "${what} does not answer at ${url}, which is the address the env file gives."
    fi
}

# Ask the BUS what buckets and streams it has, and compare that with what the
# bus repository's own definitions say it should have. Both sides come from
# somewhere other than this script: the factory does not keep its own list.
#
# IT ASKS OVER THE BUS'S OWN MONITORING ROUTE, which takes no credential — so
# reading the estate needs no password anywhere, and this check runs from an
# ordinary shell. That route is not published outside the estate; the question
# is asked from a throwaway container on the estate's own network. A key-value
# bucket is a stream named KV_<bucket>, which is how the bus reports it.
check_bus_storage() {
    local image volume network coordinator
    image="$(get NATS_PROVISION_IMAGE)"
    volume="$(get BUS_SOURCE_VOLUME)"
    coordinator="$(container_of coordinator)"
    the_bus_is_external || [ -n "${coordinator}" ] || coordinator="$(container_of nats)"
    if [ -z "${image}" ] || [ -z "${volume}" ] || [ -z "${coordinator}" ]; then
        unchecked 8b "the estate is not running, or the env file names no provisioning image, so the bus could not be asked what it holds."
        return
    fi
    # WHICH NETWORK THE QUESTION IS ASKED ON. In external bus mode the retained
    # bus is not on any network of this project's making, so the network comes
    # from the env file — the same name the overlay joins — rather than from the
    # coordinator's own networks. In local mode nothing changes.
    if the_bus_is_external; then
        network="$(get BUS_EXTERNAL_NETWORK)"
        if [ -z "${network}" ]; then
            unchecked 8b "external bus mode is in force and BUS_EXTERNAL_NETWORK names no network, so there was nowhere to ask the retained bus from."
            return
        fi
        if ! docker network inspect "${network}" >/dev/null 2>&1; then
            unchecked 8b "external bus mode is in force and there is no docker network called '${network}' on this machine, so the retained bus could not be asked what it holds."
            return
        fi
    else
        network="$(docker inspect "${coordinator}" --format '{{range $k,$v := .NetworkSettings.Networks}}{{$k}}{{"\n"}}{{end}}' 2>/dev/null | grep -- '_factory$\|^factory$' | head -1)"
        if [ -z "${network}" ]; then
            unchecked 8b "the factory network could not be identified, so the bus could not be asked what it holds."
            return
        fi
    fi
    local address out
    # The bus's monitoring address — a name and a port, and no credential,
    # because that route takes none. The same address in both modes.
    address="$(the_buss_monitoring_address)"
    out="$(docker run --rm --network "${network}" \
            -e "BUS=${address}" \
            -e "ACCOUNT=$(get BUS_STREAMS_ACCOUNT)" \
            -v "${volume}:/bus:ro" "${image}" '
        set -euo pipefail
        # Within ONE account (the third E1/E2 review): a name held by some other
        # account is not a stream of the coordinator account.
        # ONE RULE FOR CHOOSING THE ACCOUNT, the same as the comparison and
        # the closed-door check: the account named in BUS_STREAMS_ACCOUNT, else
        # the single account holding ANY stream by a pinned name (the fourth
        # E1/E2 review: three items had three rules, and a bus could pass two
        # and fail the third). Two such accounts, or none, is unknown.
        pinned="$(jq -r ".streams[].name" /bus/streams/stream-definitions.json | paste -sd" " -)"
        held="$(curl -sf "http://$BUS/jsz?accounts=true&streams=true" \
                | jq -r --arg a "${ACCOUNT:-}" --arg pinned "$pinned" "
                    (\$pinned | split(\" \")) as \$p
                    | ([.account_details[]? | select(\$a == \"\" or .name == \$a)
                        | select(any((.stream_detail // [])[]?.name; . as \$n | \$p | index(\$n)))]) as \$c
                    | if (\$c | length) == 1 then (\$c[0].stream_detail[]?.name)
                      elif (\$c | length) == 0 then \"NO-ACCOUNT\"
                      else (\"AMBIGUOUS-ACCOUNTS:\" + (\$c | map(.name) | join(\",\"))) end")"
        case "$held" in
            AMBIGUOUS-ACCOUNTS:*) printf "more than one account on this bus (%s) holds streams by the pinned names; one must be chosen, in BUS_STREAMS_ACCOUNT, before what the bus holds can be read\n" "${held#AMBIGUOUS-ACCOUNTS:}"; exit 0 ;;
            NO-ACCOUNT)           printf "no account on this bus holds any stream by the pinned names (if BUS_STREAMS_ACCOUNT is set, check its spelling)\n"; exit 0 ;;
        esac
        missing=""
        for want in $(jq -r ".streams[].name" /bus/streams/stream-definitions.json); do
            printf "%s\n" "$held" | grep -qx "$want" || missing="$missing stream:$want"
        done
        for want in $(jq -r ".kv_buckets[].name" /bus/kv/kv-definitions.json); do
            printf "%s\n" "$held" | grep -qx "KV_$want" || missing="$missing bucket:$want"
        done
        n_s=$(printf "%s\n" "$held" | grep -c . || true)
        n_k=$(printf "%s\n" "$held" | grep -c "^KV_" || true)
        n_s=$((n_s - n_k))
        if [ -n "$missing" ]; then
            printf "MISSING %s | the bus holds %s streams and %s buckets\n" "$missing" "$n_s" "$n_k"
        else
            printf "ALL %s streams and %s key-value buckets\n" "$n_s" "$n_k"
        fi
    ' 2>&1 | tail -1)"
    case "${out}" in
        ALL*)
            ok 8b "the bus's storage is provisioned — ${out#ALL } — every one the bus repository's own definitions name, asked of the bus itself and not of the one-shot's exit code (those scripts exit 0 whatever they print)."
            ;;
        MISSING*)
            fail 8b "the bus is missing storage the bus repository's definitions name: ${out#MISSING }. The coordinator needs its agent-registry bucket and its PIPELINE stream to register at all, which is why the estate provisions the bus before the coordinator starts."
            ;;
        *)
            fail 8b "the bus could not be asked what it holds: ${out}"
            ;;
    esac
}

# ---------------------------------------------------------------------------
# ITEM 9 — the one this bundle cannot yet prove.
#
# The design's ninth item is the answer service reached FROM INSIDE a sandbox,
# at the factory gateway address the sandbox's own profile allows. It is the
# check that proves the route, and without it a project's deploy helper refuses
# every deploy that names a commit.
#
# The probe below is real: it asks the sandbox named in the env file to fetch
# the answer service at the gateway address. What it will not do is invent a
# pass. With no sandbox named, or none of that name on this machine, it says so
# and counts as NOT PASSED — the gate is met when this runs for real.
# ---------------------------------------------------------------------------
check_from_inside_a_sandbox() {
    local name gateway port url out
    name="$(get SANDBOX_NAME)"
    gateway="$(get FACTORY_GATEWAY_ADDRESS)"
    port="$(get FORGE_ANSWER_PORT)"
    url="http://${gateway}:${port}/recorded?build=a-build-nobody-ever-queued"

    if [ -z "${name}" ]; then
        unchecked 9 "the env file names no sandbox (SANDBOX_NAME is empty), so nothing could be asked from inside one. Until this runs for real the route from a sandbox to the answer service is unproven, and a deploy helper inside a sandbox refuses every deploy that names a commit."
        return
    fi
    if ! command -v sbx >/dev/null 2>&1; then
        unchecked 9 "the sandbox tool is not on this machine, so nothing could be asked from inside the sandbox '${name}'."
        return
    fi
    if ! sbx ls 2>/dev/null | grep -qw -- "${name}"; then
        unchecked 9 "there is no sandbox called '${name}' on this machine, so the route from inside one to the answer service at ${url} was not tried."
        return
    fi
    out="$(sbx exec "${name}" -- curl -s -o /dev/null --max-time 10 -w '%{http_code}' "${url}" 2>/dev/null | tail -1)"
    if [ "${out}" = "200" ]; then
        ok 9 "the answer service answers from inside the sandbox '${name}', at ${url} — the one route across the sandbox boundary that every planned deploy depends on."
    else
        fail 9 "the answer service did NOT answer from inside the sandbox '${name}' at ${url} (it said ${out:-nothing}). A deploy helper in there will refuse every deploy that names a commit, which is the safe side and which stops the factory deploying."
    fi
}

# ---------------------------------------------------------------------------
# WHICH NETWORK A QUESTION TO THE BUS IS ASKED ON. In local mode the estate's
# own factory network, found from the coordinator. In external mode the
# retained bus's network, named in the env file — because the retained bus is
# not on a network of this project's making.
# ---------------------------------------------------------------------------
the_buss_network() {
    local coordinator
    if the_bus_is_external; then
        get BUS_EXTERNAL_NETWORK
        return
    fi
    coordinator="$(container_of coordinator)"
    [ -n "${coordinator}" ] || coordinator="$(container_of nats)"
    [ -n "${coordinator}" ] || return 1
    docker inspect "${coordinator}" \
        --format '{{range $k,$v := .NetworkSettings.Networks}}{{$k}}{{"\n"}}{{end}}' 2>/dev/null \
        | grep -- '_factory$\|^factory$' | head -1
}

# ---------------------------------------------------------------------------
# ITEM 10 — ARE THE TWO THINGS THAT CAN BRING WORK IN REALLY STOPPED?
# (26 September 2026, build item E2.)
#
# THIS IS THE INVERSION THAT MATTERS. Everywhere else in this script a stopped
# front door is the failure. Here a RUNNING one is, and it is named. The rollout
# has a phase where the door is deliberately shut and everything that can be
# checked with it shut is checked — and a check that could not tell the
# difference between "shut on purpose" and "broken" would be no use in it.
#
# FOUR QUESTIONS, and an unknown is never read as a nought:
#
#   * no front-door container in this estate;
#   * no bus-gateway container in this estate;
#   * the legacy host units inactive, IF they are on this machine at all. They
#     are read with 'systemctl show', which only reads;
#   * nothing waiting and nothing unconfirmed on the bus's two durable readers.
#     Read from the bus's own monitoring route, which takes no credential. If
#     that route cannot be read this item FAILS: "could not be read" is not
#     "nought", and the whole point of the phase is that nothing is in flight.
# ---------------------------------------------------------------------------
check_the_producers_are_stopped() {
    local coordinator="$1" trouble="" said="" door gateway
    door="$(container_of front-door)"
    gateway="$(container_of bus-gateway)"
    if [ -n "${door}" ]; then
        trouble="${trouble} the front-door container is RUNNING (${door});"
    else
        said="${said} no front-door container;"
    fi
    if [ -n "${gateway}" ]; then
        trouble="${trouble} the bus-gateway container is RUNNING (${gateway});"
    else
        said="${said} no bus-gateway container;"
    fi

    # THE LEGACY HOST UNITS, read-only. A unit that is not on this machine is
    # not a failure — a cloud machine has never had them — and it is said so
    # rather than counted as stopped.
    local units unit state
    units="$(get ROLLOUT_LEGACY_PRODUCER_UNITS)"
    if [ -z "${units}" ]; then
        said="${said} the env file names no legacy producer units, so none were looked for;"
    elif ! command -v systemctl >/dev/null 2>&1; then
        said="${said} this machine has no systemctl, so the legacy units were not looked for;"
    else
        # BOTH MANAGERS ARE ASKED, AND ONLY A READ ANSWER COUNTS (the E1/E2
        # review of 26 September 2026: this asked the user manager alone and
        # read an empty answer as "not on this machine" — so with no session
        # bus it passed while both live front-door units were running, and a
        # running SYSTEM unit passed too). Now: the user manager and the
        # system manager are each asked; a manager that cannot be reached or
        # answers nothing is UNKNOWN, and unknown refuses; a unit passes only
        # when every manager that answered read it as inactive or failed, or
        # as not loaded (LoadState not-found) — a positive answer, not a
        # missing one.
        for unit in ${units}; do
            local verdicts="" unknown="" mgr load
            for mgr in "--user" "--system"; do
                local out rc
                out="$(systemctl ${mgr} show -p LoadState -p ActiveState --value "${unit}" 2>/dev/null)"; rc=$?
                if [ "${rc}" -ne 0 ] || [ -z "${out}" ]; then
                    unknown="${unknown} ${mgr#--}-manager:unreachable-or-silent"
                    continue
                fi
                load="$(printf '%s\n' "${out}" | sed -n 1p)"
                state="$(printf '%s\n' "${out}" | sed -n 2p)"
                case "${load}:${state}" in
                    not-found:*|masked:inactive)      verdicts="${verdicts} ${mgr#--}:not-loaded" ;;
                    *:inactive|*:failed)               verdicts="${verdicts} ${mgr#--}:${state}" ;;
                    *)                                 trouble="${trouble} the legacy unit ${unit} is ${state} in the ${mgr#--} manager;" ;;
                esac
            done
            if [ -n "${unknown}" ]; then
                trouble="${trouble} the legacy unit ${unit} could not be read (${unknown# }) — could not be read is not stopped, and work may still be running;"
            elif [ -n "${verdicts}" ]; then
                said="${said} ${unit}:${verdicts# };"
            fi
        done
    fi

    # THE SAME BUS, RE-ASKED HERE: the closed-door record describes the bus the
    # coordinator talks to, so the two hosts must agree at this moment, not
    # only at the door (item 7b of the host check; the E1/E2 review).
    local same_bus_trouble
    same_bus_trouble="$(the_same_bus_or_trouble)"
    [ -z "${same_bus_trouble}" ] || trouble="${trouble}${same_bus_trouble}"

    # THE TWO WAITING COUNTS, off the bus's own monitoring route.
    local stream consumers network image counts
    stream="$(get ROLLOUT_BUS_STREAM)"
    consumers="$(get ROLLOUT_BUS_CONSUMERS)"
    image="$(get NATS_PROVISION_IMAGE)"
    network="$(the_buss_network)"
    if [ -z "${stream}" ] || [ -z "${consumers}" ]; then
        trouble="${trouble} the env file does not say which stream and which durable readers to read the waiting counts from (ROLLOUT_BUS_STREAM, ROLLOUT_BUS_CONSUMERS), so nothing was read and nothing may be assumed;"
    elif [ -z "${image}" ] || [ -z "${network}" ]; then
        trouble="${trouble} the bus could not be asked for its waiting counts (no provisioning image named, or the bus's network could not be identified), and an unknown is not a nought;"
    else
        counts="$(docker run --rm --network "${network}" \
                    -e "BUS=$(the_buss_monitoring_address)" \
                    -e "STREAM=${stream}" \
                    -e "WANTED=${consumers}" \
                    -e "ACCOUNT=$(get BUS_STREAMS_ACCOUNT)" \
                    "${image}" '
            set -euo pipefail
            answer="$(curl -sf --max-time 8 "http://$BUS/jsz?accounts=true&streams=true&consumers=true")" || {
                printf "UNREADABLE the bus did not answer its monitoring route at %s\n" "$BUS"; exit 0; }
            # ONE ACCOUNT, CHOSEN, NEVER "THE FIRST THAT ANSWERED" (the third
            # E1/E2 review, 26 September 2026: this read the first account
            # holding a stream of that name and called the bus quiet while
            # four messages waited on the same stream in another account).
            # The account named in BUS_STREAMS_ACCOUNT if given; else the one
            # account holding the stream; two or none is UNREADABLE.
            holders="$(printf "%s" "$answer" | jq -r --arg s "$STREAM" --arg a "$ACCOUNT" "
                [ .account_details[]? | select(any(.stream_detail[]?; .name == \$s))
                  | select(\$a == \"\" or .name == \$a) | .name ] | join(\" \")")"
            set -- $holders
            if [ "$#" -ne 1 ]; then
                printf "UNREADABLE %s account(s) on this bus hold a stream named %s (%s); one must be chosen, in BUS_STREAMS_ACCOUNT, before its waiting counts mean anything\n" "$#" "$STREAM" "${holders:-none}"; exit 0
            fi
            chosen="$1"
            trouble=""
            for want in $WANTED; do
                row="$(printf "%s" "$answer" | jq -r --arg acct "$chosen" --arg s "$STREAM" --arg c "$want" "
                    [ .account_details[]? | select(.name == \$acct) | .stream_detail[]?
                      | select(.name == \$s)
                      | .consumer_detail[]?
                      | select(.name == \$c)
                      | \"\\(.num_pending) \\(.num_ack_pending)\" ] | first // \"absent\"")"
                case "$row" in
                    absent) trouble="$trouble $want:not-on-the-bus" ;;
                    "0 0")  ;;
                    *)      trouble="$trouble $want:waiting-and-unconfirmed($row)" ;;
                esac
            done
            if [ -n "$trouble" ]; then printf "WAITING%s\n" "$trouble"; else printf "QUIET in account %s\n" "$chosen"; fi
        ' 2>&1 | tail -1)"
        case "${counts}" in
            QUIET*)     said="${said} nothing waiting and nothing unconfirmed on ${consumers} (stream ${stream}, ${counts#QUIET });" ;;
            WAITING*)   trouble="${trouble} the bus still holds work for:${counts#WAITING};" ;;
            *)          trouble="${trouble} the bus's waiting counts could not be read (${counts}), and an unknown is not a nought;" ;;
        esac
    fi

    if [ -n "${trouble}" ]; then
        fail 10 "the door is not shut:${trouble} The closed-door check is for a phase where nothing can bring work in, so a running producer or unread waiting counts refuse it, and no record of this phase is written."
    else
        ok 10 "the two things that can bring work in are stopped and the bus is quiet —${said} so everything below was asked of an estate nothing can arrive at."
    fi
}

# ---------------------------------------------------------------------------
# ITEM 10b — IS WHAT IS RUNNING THE RELEASE THIS ROLLOUT IS FOR?
# (26 September 2026, the first of the three conditions Codex's third read put
# on build item E2, and the one the first implementation did not meet.)
#
# WHAT WAS WRONG. The first version read FORGE_IMAGE out of the env file, wrote
# it into the record as the release this phase was about, ALSO wrote the image id
# the coordinator was really running, and never compared the two. So an env file
# naming forge:2026.09.26-1 while the estate ran 2026.09.26-2's image produced a
# record that said "release_version": "2026.09.26-1" without a word, and reading
# it back answered MAY BE ACTED ON — because the read compared the recorded id
# with the running id, which is the same number twice. A record that names the
# wrong release is worse than no record: the resume step is the point of no
# return and it is entitled to believe what the record says.
#
# WHAT IT DOES NOW. The image the rollout is FOR — '--for-image', or the env
# file's FORGE_IMAGE, which is the line the estate was started from — is
# RESOLVED TO AN IMAGE ID on this machine and compared with the image id the
# coordinator is really running. A difference names both sides and refuses, so
# no record is written at all. An identity that could not be read is not an
# identity that matches: a tag that is not on this machine, or a container whose
# image cannot be read, refuses in the same way and says which it was.
# ---------------------------------------------------------------------------
the_image_this_rollout_names() {
    if [ -n "${EXPECT_IMAGE}" ]; then printf '%s' "${EXPECT_IMAGE}"; return; fi
    printf '%s' "$(get FORGE_IMAGE)"
}

# The image id a name resolves to on this machine, tag or id alike. Nothing is
# pulled: a name that is not here is an unknown, and this says so by printing
# nothing.
image_id_of() {
    docker image inspect "$1" --format '{{.Id}}' 2>/dev/null | head -1
}

check_the_release_is_the_one_this_rollout_names() {
    local coordinator="$1" named named_id running_id tags
    named="$(the_image_this_rollout_names)"

    if [ -z "${named}" ]; then
        fail 10b "this rollout does not say which release it is for: there is no --for-image and the env file names no FORGE_IMAGE. The closed-door record would then be a pass about an unnamed release, which the resume step cannot act on, so nothing is written."
        return
    fi
    if [ -z "${coordinator}" ]; then
        fail 10b "the coordinator is not running here, so there is nothing to compare the release this rollout names (${named}) against. A closed-door record is a statement about a RUNNING estate."
        return
    fi

    named_id="$(image_id_of "${named}")"
    running_id="$(docker inspect "${coordinator}" --format '{{.Image}}' 2>/dev/null)"

    if [ -z "${named_id}" ]; then
        fail 10b "the release this rollout names, ${named}, is not an image on this machine, so it could not be turned into an image id and nothing could be compared. An identity that cannot be read is not an identity that matches, and no record of this phase is written."
        return
    fi
    if [ -z "${running_id}" ]; then
        fail 10b "the coordinator's own image id could not be read from ${coordinator}, so what is running could not be compared with the release this rollout names (${named}). An unknown is not a match."
        return
    fi
    if [ "${named_id}" != "${running_id}" ]; then
        tags="$(docker image inspect "${running_id}" --format '{{join .RepoTags ", "}}' 2>/dev/null)"
        fail 10b "this rollout is for ${named} (image ${named_id}) and the coordinator is really running ${running_id}${tags:+, which carries the tag(s) ${tags}}. The record this phase would write would name the wrong release, so NOTHING is written: either start the estate from ${named}, or run the rollout for the release that is actually up."
        return
    fi
    ok 10b "what is running is the release this rollout is for — ${named} resolves to ${named_id} on this machine and that is the image id the coordinator is running, so the record this phase writes names the release it is really about."
}

# ---------------------------------------------------------------------------
# THE CLOSED-DOOR CHECK, AND THE RECORD IT LEAVES (build item E2).
#
# WHY A RECORD AT ALL. The rollout's resume step is the point of no return, and
# it must not be taken on an exit code somebody saw an hour ago on a different
# estate. So this writes down WHAT was checked, on WHICH estate, against WHICH
# image, and WHEN — and '--read-pre-resume' is what says whether that record may
# be acted on now.
#
# AND THE RECORD IS ABOUT THE RELEASE THE ROLLOUT NAMES, not merely about
# whatever happened to be running: item 10b resolves the named release to an
# image id and refuses the whole phase if that is not what the coordinator is
# running, so a record naming the wrong release is never written.
#
# THREE VERDICTS, and only one of them may be acted on:
#
#   passed                          every item asked something and passed, and
#                                   the only items not checked are the two that
#                                   ask a producer
#   passed-with-items-not-checked   nothing failed, but an item could not be
#                                   asked on this machine — item 9 with no
#                                   sandbox is the one that happens. The record
#                                   is written, the run is NOT PASSED, and
#                                   '--read-pre-resume' REFUSES it. An unknown
#                                   stays an unknown all the way through
#   (nothing)                       something failed. NO record is written, and
#                                   any record already there is INVALIDATED —
#                                   renamed out of the way — because a later
#                                   failed check must never leave an earlier
#                                   success sitting where the resume step reads
# ---------------------------------------------------------------------------
check_pre_resume() {
    printf 'estate-check --pre-resume — the CLOSED-DOOR check (env file: %s, %s bus mode)\n' "${ENV_FILE}" "${BUS_MODE_IN_FORCE}"
    printf 'The two things that can bring work in must be STOPPED for this one. A running producer is the failure here.\n\n'

    local state_dir receipt
    state_dir="$(get ROLLOUT_STATE_DIR)"
    if [ -z "${state_dir}" ]; then
        printf 'estate-check: the env file names no ROLLOUT_STATE_DIR, and the closed-door phase has to be written down somewhere the resume step can read it.\n' >&2
        exit 2
    fi
    receipt="${state_dir}/pre-resume.json"

    run_the_services_items closed-door

    # --- what this run is about, so the record names it --------------------
    # The named image and the running image id are the SAME image here, and
    # item 10b is what makes that true: it refuses the phase when they differ,
    # so nothing below is reached with a name and an id that disagree.
    local coordinator project image_id image_named image_named_id started_at now verdict
    coordinator="$(container_of coordinator)"
    project="$(docker inspect "${coordinator}" --format '{{index .Config.Labels "com.docker.compose.project"}}' 2>/dev/null)"
    image_id="$(docker inspect "${coordinator}" --format '{{.Image}}' 2>/dev/null)"
    started_at="$(docker inspect "${coordinator}" --format '{{.State.StartedAt}}' 2>/dev/null)"
    image_named="$(the_image_this_rollout_names)"
    image_named_id="$(image_id_of "${image_named}")"
    now="$(date -u +%s)"

    printf '\n'
    if [ "${FAILURES}" -gt 0 ]; then
        if [ -e "${receipt}" ]; then
            mv -f "${receipt}" "${receipt}.invalidated" 2>/dev/null \
                && printf 'The record that was here has been INVALIDATED (moved to %s.invalidated): a check that has just failed must never leave an earlier pass where the resume step reads.\n' "${receipt}"
        fi
        printf 'NOT PASSED — %s items passed, %s failed, %s could not be checked. NO closed-door record has been written, so the resume step has nothing to act on.\n' \
            "${PASSES}" "${FAILURES}" "${UNCHECKED}"
        exit 1
    fi

    if [ "${UNCHECKED}" -gt 0 ]; then
        verdict="passed-with-items-not-checked"
    else
        verdict="passed"
    fi

    mkdir -p "${state_dir}" || {
        printf 'estate-check: could not make %s, and the closed-door phase has to be written down.\n' "${state_dir}" >&2
        exit 2
    }

    {
        printf '{\n'
        printf '  "what_this_is": "the closed-door check of a rollout: the estate up, the producers deliberately stopped, everything that can be checked with the door shut checked",\n'
        printf '  "written_at": "%s",\n'            "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
        printf '  "written_at_epoch": %s,\n'        "${now}"
        printf '  "verdict": "%s",\n'               "${verdict}"
        printf '  "bus_mode": "%s",\n'              "${BUS_MODE_IN_FORCE}"
        printf '  "compose_project": "%s",\n'       "${project}"
        printf '  "coordinator_image_id": "%s",\n'  "${image_id}"
        printf '  "coordinator_image_named": "%s",\n' "${image_named}"
        printf '  "coordinator_image_named_id": "%s",\n' "${image_named_id}"
        printf '  "release_version": "%s",\n'       "${image_named##*:}"
        printf '  "coordinator_started_at": "%s",\n' "${started_at}"
        printf '  "the_bus": {"monitoring_address": "%s", "network": "%s"},\n' \
               "$(the_buss_monitoring_address)" "$(the_buss_network)"
        printf '  "items": [\n'
        local first=1 row number vd sentence
        for row in "${RESULTS[@]}"; do
            IFS='|' read -r number vd sentence <<< "${row}"
            [ "${first}" -eq 1 ] || printf ',\n'
            first=0
            printf '    {"item": "%s", "verdict": "%s", "said": "%s"}' \
                "${number}" "${vd}" "$(printf '%s' "${sentence}" | sed 's/\\/\\\\/g; s/"/\\"/g')"
        done
        printf '\n  ]\n}\n'
    } > "${receipt}" || {
        printf 'estate-check: could not write %s.\n' "${receipt}" >&2
        exit 2
    }

    printf 'The closed-door phase is written down at %s — this estate (%s), the release this rollout is for (%s), which is the image this coordinator is running (%s), at %s.\n' \
        "${receipt}" "${project:-unnamed}" "${image_named:-unnamed}" "${image_id:-unreadable}" "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    if [ "${verdict}" = "passed" ]; then
        printf 'PASSED — %s items asked something and passed; the %s producer items are not checked in this mode and are recorded as such, never as passed.\n' \
            "${PASSES}" "${DELIBERATE}"
        exit 0
    fi
    printf 'NOT PASSED — %s items passed and %s could not be checked on this machine. The record says so item by item, and "estate-check --read-pre-resume" REFUSES it: an unknown is not a pass, and the resume step is the point of no return.\n' \
        "${PASSES}" "${UNCHECKED}"
    exit 1
}

# ---------------------------------------------------------------------------
# READING THE CLOSED-DOOR RECORD BACK, which is the only way it may be used.
#
# SIX REASONS TO REFUSE, and each is said by name:
#
#   * there is no record, or it cannot be read;
#   * it is not a pass — including a pass with something not checked;
#   * it belongs to a different estate (a different compose project);
#   * it names a different coordinator image than the one running now;
#   * it was written about a different RELEASE than this rollout is for, or the
#     name it gives that release now points at a different image, or the record
#     disagrees with itself about the two. Comparing the recorded id with the
#     running id alone is the same number twice whenever the record was written
#     here, which is why the release it NAMES is resolved again (26 September
#     2026, the first condition of Codex's third read);
#   * it is older than the coordinator's own start, or older than the age the
#     env file allows. A pass from before the estate started says nothing about
#     the estate that is running.
# ---------------------------------------------------------------------------
_read_the_record() {   # <file> — prints shell assignments, one per line
    local file="$1" program
    program='
      "R_VERDICT=" + (.verdict // "") ,
      "R_PROJECT=" + (.compose_project // "") ,
      "R_IMAGE=" + (.coordinator_image_id // "") ,
      "R_NAMED=" + (.coordinator_image_named // "") ,
      "R_NAMED_ID=" + (.coordinator_image_named_id // "") ,
      "R_BUS_MODE=" + (.bus_mode // "") ,
      "R_EPOCH=" + ((.written_at_epoch // 0) | tostring) ,
      "R_WRITTEN=" + (.written_at // "") ,
      "R_NOT_CHECKED=" + ([.items[]? | select(.verdict == "not-checked") | .item] | join(" "))
    '
    if command -v jq >/dev/null 2>&1; then
        jq -r "${program}" < "${file}" 2>/dev/null
        return
    fi
    # NO jq ON THIS MACHINE. The estate already reads the bus's JSON with the
    # provisioning image rather than asking a machine to carry a tool, and this
    # does the same rather than parsing JSON with a regular expression.
    local image
    image="$(get NATS_PROVISION_IMAGE)"
    [ -n "${image}" ] || return 1
    docker run --rm -i --entrypoint jq "${image}" -r "${program}" < "${file}" 2>/dev/null
}

check_read_pre_resume() {
    local state_dir receipt
    state_dir="$(get ROLLOUT_STATE_DIR)"
    receipt="${state_dir}/pre-resume.json"
    printf 'estate-check --read-pre-resume — may the closed-door record at %s be acted on?\n\n' "${receipt}"

    if [ -z "${state_dir}" ]; then
        printf 'REFUSED — the env file names no ROLLOUT_STATE_DIR, so there is nowhere a closed-door record could be.\n'
        exit 1
    fi
    if [ ! -f "${receipt}" ]; then
        printf 'REFUSED — there is no closed-door record at %s. Run "estate-check --pre-resume" with the producers stopped.\n' "${receipt}"
        exit 1
    fi

    local R_VERDICT="" R_PROJECT="" R_IMAGE="" R_NAMED="" R_NAMED_ID="" R_BUS_MODE="" R_EPOCH=0 R_WRITTEN="" R_NOT_CHECKED=""
    local key val
    while IFS='=' read -r key val; do
        case "${key}" in
            R_VERDICT|R_PROJECT|R_IMAGE|R_NAMED|R_NAMED_ID|R_BUS_MODE|R_EPOCH|R_WRITTEN|R_NOT_CHECKED)
                printf -v "${key}" '%s' "${val}" ;;
        esac
    done < <(_read_the_record "${receipt}")
    case "${R_EPOCH}" in ''|*[!0-9]*) R_EPOCH=0 ;; esac

    if [ -z "${R_VERDICT}" ]; then
        printf 'REFUSED — the closed-door record at %s could not be read as the record it should be. It is JSON; this machine has no jq and the provisioning image could not read it either.\n' "${receipt}"
        exit 1
    fi

    local coordinator project image_id started_epoch now age max_age trouble=""
    coordinator="$(container_of coordinator)"
    project="$(docker inspect "${coordinator}" --format '{{index .Config.Labels "com.docker.compose.project"}}' 2>/dev/null)"
    image_id="$(docker inspect "${coordinator}" --format '{{.Image}}' 2>/dev/null)"
    started_epoch="$(docker inspect "${coordinator}" --format '{{.State.StartedAt}}' 2>/dev/null)"
    started_epoch="$(date -u -d "${started_epoch}" +%s 2>/dev/null || printf '0')"
    now="$(date -u +%s)"
    age=$(( now - R_EPOCH ))
    max_age="$(get ROLLOUT_PRE_RESUME_MAX_AGE_S)"
    [ -n "${max_age}" ] || max_age=3600

    case "${R_VERDICT}" in
        passed) ;;
        passed-with-items-not-checked)
            trouble="${trouble} it is not a pass: these items could not be checked when it was written: ${R_NOT_CHECKED:-unnamed}. An unknown is not a pass;" ;;
        *)
            trouble="${trouble} its verdict is '${R_VERDICT}', and only 'passed' may be acted on;" ;;
    esac
    if [ -z "${coordinator}" ]; then
        trouble="${trouble} the coordinator is not running here, so there is no estate to check this record against;"
    else
        [ "${R_PROJECT}" = "${project}" ] || trouble="${trouble} it was written for the estate '${R_PROJECT}' and this one is '${project}';"
        [ "${R_IMAGE}" = "${image_id}" ]  || trouble="${trouble} it names the coordinator image ${R_IMAGE:-none} and this estate is running ${image_id:-unreadable};"
        # AND THE RELEASE IT SAYS IT IS ABOUT. The line above compares the id
        # the record carries with the id that is running, which on its own is
        # the same number twice whenever the record was written here. So the
        # NAME the record gives the release is resolved again, now, and has to
        # be the release this rollout names and the image that is running.
        # This is what catches a record written for one release and read during
        # another, and a tag that has been moved onto a different image since.
        local wanted named_now
        wanted="$(the_image_this_rollout_names)"
        if [ -z "${R_NAMED}" ]; then
            trouble="${trouble} it does not say which release it was written about, only an image id, so it cannot be shown to be about this rollout's release (${wanted:-unnamed}); it was written by a version of this check that did not compare the two;"
        else
            [ -z "${wanted}" ] || [ "${R_NAMED}" = "${wanted}" ] \
                || trouble="${trouble} it was written for the release ${R_NAMED} and this rollout is for ${wanted};"
            named_now="$(image_id_of "${R_NAMED}")"
            if [ -z "${named_now}" ]; then
                trouble="${trouble} the release it names, ${R_NAMED}, is no longer an image on this machine, so what it was written about cannot be read back;"
            elif [ "${named_now}" != "${image_id}" ]; then
                # The same name and a different image is a tag that has MOVED.
                # A different name is simply another release, and saying "moved"
                # about that would be a lie about this machine.
                if [ "${R_NAMED}" = "${wanted}" ]; then
                    trouble="${trouble} it was written for ${R_NAMED}, and that name now points at ${named_now} while this estate runs ${image_id:-unreadable} — the tag has been moved since the record was written;"
                else
                    trouble="${trouble} the release it names, ${R_NAMED}, is image ${named_now} on this machine and this estate runs ${image_id:-unreadable};"
                fi
            fi
            [ -z "${R_NAMED_ID}" ] || [ "${R_NAMED_ID}" = "${R_IMAGE}" ] \
                || trouble="${trouble} the record disagrees with itself: it says ${R_NAMED} is image ${R_NAMED_ID} and that the estate ran ${R_IMAGE};"
        fi
        if [ "${started_epoch}" -gt 0 ] && [ "${R_EPOCH}" -le "${started_epoch}" ]; then
            trouble="${trouble} it was written at ${R_WRITTEN}, before or when this coordinator started, so it says nothing about the estate that is running now;"
        fi
    fi
    [ "${R_BUS_MODE}" = "${BUS_MODE_IN_FORCE}" ] || trouble="${trouble} it was written in ${R_BUS_MODE:-an unrecorded} bus mode and this estate is in ${BUS_MODE_IN_FORCE} bus mode;"
    if [ "${age}" -lt 0 ]; then
        # A record from the future is not fresh; it is a clock nobody trusts
        # (the E1/E2 review of 26 September 2026: a negative age passed).
        trouble="${trouble} it is dated ${R_WRITTEN}, which is $(( -age )) seconds in the future of this machine's clock, so its age cannot be trusted;"
    elif [ "${age}" -gt "${max_age}" ]; then
        trouble="${trouble} it is ${age} seconds old and this env file allows ${max_age};"
    fi

    if [ -n "${trouble}" ]; then
        printf 'REFUSED —%s\n' "${trouble}"
        printf '\nA closed-door record is a statement about ONE estate, ONE image and ONE moment. Run "estate-check --pre-resume" again on the estate that is running.\n'
        exit 1
    fi
    printf 'MAY BE ACTED ON — written %s (%s seconds ago, and this env file allows %s), for this estate (%s), for the release %s, which is the image this coordinator is running (%s), in %s bus mode, and every item it names passed.\n' \
        "${R_WRITTEN}" "${age}" "${max_age}" "${project}" "${R_NAMED:-unnamed}" "${image_id}" "${R_BUS_MODE}"
    exit 0
}

case "${MODE}" in
    host)            check_host ;;
    services)        check_services ;;
    pre-resume)      check_pre_resume ;;
    read-pre-resume) check_read_pre_resume ;;
esac
