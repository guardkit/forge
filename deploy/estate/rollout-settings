    return parser.parse_args()


def canonical_host_path(value: Path | str, label: str) -> Path:
    text = str(value)
    if not text.startswith("/") or os.path.normpath(text) != text or str(Path(text)) != text:
        refuse(f"{label} is not a canonical absolute path")
    return Path(text)


def mount_field(mount: dict, names: tuple[str, ...], label: str) -> object:
    values = [mount[name] for name in names if name in mount and mount[name] is not None]
    if not values:
        refuse(f"a previous-runtime mount has no {label}")
    if any(value != values[0] for value in values[1:]):
        refuse(f"a previous-runtime mount has conflicting {label} fields")
    return values[0]


def safe_directory_identity(path: Path, label: str) -> dict[str, int]:
    path = canonical_host_path(path, label)
    current = Path(path.anchor)
    try:
        for part in path.parts[1:]:
            current /= part
            status = os.lstat(current)
            if stat.S_ISLNK(status.st_mode):
                refuse(f"{label} has symbolic-link component {current}")
            if current != path and not stat.S_ISDIR(status.st_mode):
                refuse(f"{label} has non-directory ancestor {current}")
        final = os.lstat(path)
    except FileNotFoundError:
        refuse(f"{label} does not exist on the host")
    except OSError as exc:
        refuse(f"cannot inspect {label} ({type(exc).__name__}); prove a stable host path")
    if not stat.S_ISDIR(final.st_mode):
        refuse(f"{label} is not a host directory")
    return {"device": final.st_dev, "inode": final.st_ino, "mode": stat.S_IFMT(final.st_mode)}


def prove_evidence_mapping(evidence_source: Path, mounts: list[dict]) -> dict:
    evidence_source = canonical_host_path(evidence_source, "the declared evidence source path")
    parsed_mounts: list[tuple[int, str, Path, Path | None]] = []
    candidates: list[tuple[int, Path, Path, Path]] = []
    for index, mount in enumerate(mounts):
        mount_type = str(mount_field(mount, ("Type", "type"), "type")).lower()
        destination = canonical_host_path(
            mount_field(mount, ("Destination", "destination", "target"), "destination"),
            "a previous-runtime mount destination",
        )
        source_path = None
        if mount_type == "bind":
            source_path = canonical_host_path(
                mount_field(mount, ("Source", "source"), "bind source"),
                "a previous-runtime bind source",
            )
            try:
                relative = evidence_source.relative_to(source_path)
            except ValueError:
                pass
            else:
                candidates.append((index, source_path, destination, destination / relative))
        parsed_mounts.append((index, mount_type, destination, source_path))
    if len(candidates) != 1:
        refuse("the declared evidence source must be beneath exactly one previous-runtime bind")
    selected_index, bind_source, bind_destination, container_evidence = candidates[0]
    for index, _mount_type, destination, _source in parsed_mounts:
        if index == selected_index:
            continue
        overlaps_evidence = (
            destination == container_evidence
            or destination in container_evidence.parents
            or container_evidence in destination.parents
        )
        at_or_below_selected_bind = (
            destination == bind_destination or bind_destination in destination.parents
        )
        if overlaps_evidence and at_or_below_selected_bind:
            refuse(
                f"previous-runtime mount destination {destination} shadows the mapped evidence path"
            )
    return {
        "bind_source": str(bind_source),
        "bind_destination": str(bind_destination),
        "container_evidence": str(container_evidence),
        "evidence_source": str(evidence_source),
        "bind_source_identity": safe_directory_identity(bind_source, "the selected bind source"),
        "evidence_source_identity": safe_directory_identity(evidence_source, "the declared evidence source path"),
    }


def verify_evidence_mapping_identity(proof: dict) -> None:
    checks = (
        ("bind_source", "bind_source_identity", "the selected bind source"),
        ("evidence_source", "evidence_source_identity", "the declared evidence source path"),
    )
    for path_key, identity_key, label in checks:
        current = safe_directory_identity(Path(proof[path_key]), label)
        if current != proof[identity_key]:
            refuse(f"{label} changed identity while settings were being transformed")


def read_env(path: Path) -> tuple[dict[str, str], bytes]:
    try:
        raw = path.read_bytes()
        text = raw.decode("utf-8")
    except Exception as exc:
        refuse(f"cannot read env file {path} ({type(exc).__name__}); provide a readable UTF-8 file")
    values: dict[str, str] = {}
    for number, source_line in enumerate(text.splitlines(), 1):
        line = source_line.strip()
        if not line or line.startswith("#"):
            continue
        if line.startswith("export "):
            line = line[7:].lstrip()
        if "=" not in line:
            refuse(f"env file {path} line {number} is not NAME=VALUE; correct that line")
        key, value = line.split("=", 1)
        key, value = key.strip(), value.strip()
        if not NAME.fullmatch(key):
            refuse(f"env file {path} line {number} has an invalid name; correct that line")
        if key in values:
            refuse(f"env file {path} defines {key} twice; keep one explicit value")
        if len(value) >= 2 and value[0] == value[-1] and value[0] in "\"'":
            quote = value[0]
            value = value[1:-1]
            if quote == "'" and REFERENCE.search(value):
                refuse(
                    f"env file {path} line {number} single-quotes an env reference; "
                    "Compose treats that reference as literal, so use an unquoted or double-quoted value"
                )
        values[key] = value
    return values, raw


def paths_alias(left: Path, right: Path) -> bool:
    """Return whether two names identify the same destination, including links."""
    try:
        if left.exists() and right.exists() and os.path.samefile(left, right):
            return True
    except OSError:
        # resolve() below is still useful for a broken or temporarily unreadable link.
        pass
    return left.resolve(strict=False) == right.resolve(strict=False)


def validate_path_boundaries(inputs: tuple[Path, ...], outputs: tuple[Path, ...]) -> None:
    """Keep every generated artifact disjoint from every input and other output."""
    resolved_outputs = tuple(output.resolve(strict=False) for output in outputs)
    for index, output in enumerate(outputs):
        if output.is_symlink():
            refuse(f"output {output} is a symbolic link; choose a plain output path")
        if output.exists() and not output.is_file():
            refuse(f"output {output} is not a regular file; choose a plain output path")
        for source in inputs:
            if paths_alias(output, source):
                refuse(f"output {output} aliases input {source}; choose disjoint paths so inputs stay unchanged")
        for prior in outputs[:index]:
            if paths_alias(output, prior):
                refuse(f"output {output} aliases output {prior}; choose a distinct path for every artifact")
        for other in resolved_outputs:
            resolved = resolved_outputs[index]
            if resolved != other and (resolved in other.parents or other in resolved.parents):
                refuse(f"output {output} is an ancestor or child of another output; choose disjoint artifact paths")
        parent = output.parent
        while True:
            if parent.is_symlink():
                refuse(f"output parent {parent} is a symbolic link; choose a stable plain directory")
            if parent.exists():
                if not parent.is_dir():
                    refuse(f"output parent {parent} is not a directory; correct every destination before writing")
                break
            if parent == parent.parent:
                refuse(f"output parent {parent} cannot be created as a directory; correct the destination")
            parent = parent.parent


def expand(values: dict[str, str]) -> dict[str, str]:
    resolved: dict[str, str] = {}
    active: set[str] = set()

    def one(name: str) -> str:
        if name in resolved:
            return resolved[name]
        if name in active:
            refuse(f"env values contain a reference cycle at {name}; break the cycle")
        if name not in values:
            refuse(f"env value references unset {name}; set it in an explicit env input")
        active.add(name)
        value = REFERENCE.sub(lambda match: one(match.group(1)), values[name])
        active.remove(name)
        resolved[name] = value
        return value

    for key in values:
        one(key)
    return resolved


def require(values: dict[str, str], name: str) -> str:
    value = values.get(name, "").strip()
    if not value:
        refuse(f"required env name {name} is empty; set it in the explicit env input")
    return value


def endpoint(value: str, name: str, schemes: tuple[str, ...]) -> tuple[str, int, str]:
    parsed = urlparse(value if "://" in value else f"//{value}")
    if "://" in value and parsed.scheme not in schemes:
        refuse(f"{name} has the wrong scheme; use one of {', '.join(schemes)}")
    try:
        port = parsed.port
    except ValueError:
        refuse(f"{name} has an invalid port; correct the explicit env value")
    host = (parsed.hostname or "").lower()
    if not host or port is None:
        refuse(f"{name} must carry an explicit host and port; correct the env value")
    if host in {"localhost", "0.0.0.0", "127.0.0.1", "::1"}:
        refuse(f"{name} points at {host}; use the documented service or gateway route")
    return host, port, parsed.path


def validate_routes(env: dict[str, str], metadata: dict) -> dict:
    gateway = require(env, "FACTORY_GATEWAY_ADDRESS")
    if gateway in {"0.0.0.0", "127.0.0.1", "localhost"}:
        refuse("FACTORY_GATEWAY_ADDRESS is not a private boundary address; set the proven gateway")
    sidecar_host, sidecar_port, _ = endpoint(require(env, "FORGE_SANDBOX_SIDECAR_URL"), "FORGE_SANDBOX_SIDECAR_URL", ("http", "https"))
    runner_host, runner_port, _ = endpoint(require(env, "FORGE_SANDBOX_RUNNER_URL"), "FORGE_SANDBOX_RUNNER_URL", ("http", "https"))
    if sidecar_host != gateway.lower() or runner_host != gateway.lower():
        refuse("sandbox helper and runner routes do not use FACTORY_GATEWAY_ADDRESS; correct the env file")
    if sidecar_port != int(require(env, "FORGE_SANDBOX_SIDECAR_PORT")) or runner_port != int(require(env, "FORGE_SANDBOX_RUNNER_PORT")):
        refuse("sandbox helper or runner URL disagrees with its declared port; correct the env file")
    if require(env, "FORGE_AUTOBUILD_RUNNER_URL") != require(env, "FORGE_SANDBOX_RUNNER_URL"):
        refuse("FORGE_AUTOBUILD_RUNNER_URL is not the documented sandbox runner route; make them equal")
    pub_host, pub_port, _ = endpoint(require(env, "FORGE_PUBLISHER_URL"), "FORGE_PUBLISHER_URL", ("http", "https"))
    if (pub_host, pub_port) != ("forge-publisher", 8711):
        refuse("FORGE_PUBLISHER_URL is not the publisher service on its private network; use http://forge-publisher:8711")
    answer_host, answer_port, answer_path = endpoint(require(env, "FORGE_TARGET_OWNER_URL"), "FORGE_TARGET_OWNER_URL", ("http", "https"))
    if answer_host != gateway.lower() or answer_port != int(require(env, "FORGE_ANSWER_PORT")) or answer_path != "/recorded":
        refuse("FORGE_TARGET_OWNER_URL is not the gateway answer-service route ending /recorded; correct it")
    internal_names = ("FORGE_NATS_URL", "FLEET_MEMORY_BUS_ADDRESS", "JARVIS_NATS_URL")
    internal_routes = {name: endpoint(require(env, name), name, ("nats",)) for name in internal_names}
    provision_route = endpoint(require(env, "NATS_PROVISION_ADDRESS"), "NATS_PROVISION_ADDRESS", ("nats",))
    if provision_route[2] or any(route != provision_route for route in internal_routes.values()):
        refuse("estate bus clients do not all use the declared internal bus host and client port; correct the env inputs")
    monitor_route = endpoint(require(env, "BUS_MONITORING_ADDRESS"), "BUS_MONITORING_ADDRESS", ())
    if monitor_route[0] != provision_route[0] or monitor_route[2]:
        refuse("BUS_MONITORING_ADDRESS does not name the declared internal bus host; correct the env input")
    sandbox_bus = endpoint(require(env, "FLEET_MEMORY_NATS_URL"), "FLEET_MEMORY_NATS_URL", ("nats",))
    if sandbox_bus != (gateway.lower(), int(require(env, "NATS_CLIENT_PORT")), ""):
        refuse("FLEET_MEMORY_NATS_URL is not the sandbox-to-bus gateway route; correct the private env input")
    memory_host, memory_port, memory_path = endpoint(require(env, "FLEET_MEMORY_URL"), "FLEET_MEMORY_URL", ("http", "https"))
    if (memory_host, memory_port, memory_path.rstrip("/")) != ("memory", 8005, "/mcp"):
        refuse("FLEET_MEMORY_URL is not the memory service route on the factory network; use http://memory:8005/mcp/")
    allowed_memory_hosts = {item.strip() for item in require(env, "FLEET_MEMORY_ALLOWED_HOSTS").split(",") if item.strip()}
    expected_memory_hosts = {"memory:8005", f"{gateway}:{int(require(env, 'FLEET_MEMORY_PORT'))}"}
    if allowed_memory_hosts != expected_memory_hosts:
        refuse("FLEET_MEMORY_ALLOWED_HOSTS does not name exactly the factory service and gateway routes; correct it")
    model_names = ("OPENAI_BASE_URL", "JARVIS_MODEL_SEAT_URL", "FLEET_MEMORY_EMBED_URL")
    model_routes = {name: endpoint(require(env, name), name, ("http", "https")) for name in model_names}
    if any(route[0] != gateway.lower() for route in model_routes.values()):
        refuse("model and embedding routes do not use FACTORY_GATEWAY_ADDRESS; correct the env inputs")
    pg_host, _, _ = endpoint(require(env, "FLEET_MEMORY_PG_DSN"), "FLEET_MEMORY_PG_DSN", ("postgresql", "postgres"))
    if not pg_host:
        refuse("FLEET_MEMORY_PG_DSN has no private-store host; correct the private env input")
    if require(env, "FLEET_MEMORY_ENABLED") not in {"true", "false"}:
        refuse("FLEET_MEMORY_ENABLED must explicitly say true or false; correct the public env input")
    for name in ("FLEET_MEMORY_EMBED_MODEL", "FLEET_MEMORY_EMBED_DIMS"):
        require(env, name)
    expected_sidecar = require(env, "FORGE_SANDBOX_SIDECAR_URL")
    expected_runner = require(env, "FORGE_SANDBOX_RUNNER_URL")
    for project, routes in metadata["routes"]["sandboxes"].items():
        if routes != {"sidecar_url": expected_sidecar, "runner_url": expected_runner}:
            refuse(f"resolved sandbox routes for {project} differ from the section 7 routes; correct the settings")
    if metadata["routes"]["deploy_sidecar"] != expected_sidecar or metadata["routes"]["publisher"] != require(env, "FORGE_PUBLISHER_URL"):
        refuse("resolved deploy or publisher route differs from the section 7 route; correct the settings")
    return {
        "gateway_routes_match": True,
        "sandbox_sidecar_port": sidecar_port,
        "sandbox_runner_port": runner_port,
        "publisher_private_service_match": True,
        "answer_port": answer_port,
        "bus_routes_match": True,
        "memory_factory_service_match": True,
        "model_gateway_routes_match": True,
        "memory_store_route_valid": True,
    }


def previous_runtime(path: Path) -> tuple[dict, list[str], list[dict]]:
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except Exception as exc:
        refuse(f"cannot read previous runtime {path} ({type(exc).__name__}); use rollout-snapshot output")
    if not isinstance(data, dict):
        refuse(f"previous runtime {path} is not a JSON object; recreate it with rollout-snapshot")
    names = data.get("environment_names", data.get("env_names"))
    if not isinstance(names, list) or not all(isinstance(item, str) and NAME.fullmatch(item) for item in names):
        refuse(f"previous runtime {path} lacks environment_names as names only; recreate it with rollout-snapshot")
    if any("=" in item for item in names) or "environment" in data:
        refuse(f"previous runtime {path} carries environment values; recreate it with names only")
    mounts = data.get("mounts")
    if not isinstance(mounts, list) or not all(isinstance(item, dict) for item in mounts):
        refuse(f"previous runtime {path} lacks its full mount list; recreate it with rollout-snapshot")
    return data, names, mounts


def docker_env(values: dict[str, str]) -> dict[str, str]:
    base = {"PATH": os.environ.get("PATH", "/usr/bin:/bin")}
    if "DOCKER_CONFIG" in os.environ:
        base["DOCKER_CONFIG"] = os.environ["DOCKER_CONFIG"]
    base.update(values)
    return base


def run(command: list[str], *, env: dict[str, str], input_bytes: bytes | None = None) -> bytes:
    try:
        result = subprocess.run(command, input=input_bytes, stdout=subprocess.PIPE, stderr=subprocess.PIPE, env=env, check=False)
    except OSError as exc:
        refuse(f"cannot run {command[0]} ({type(exc).__name__}); install it and retry")
    if result.returncode:
        refuse(f"{command[0]} refused the settings preparation with exit {result.returncode}; correct the named input and retry")
    return result.stdout


def install_artifacts(artifacts: tuple[tuple[Path, bytes], ...], mode: int = 0o600) -> tuple[str, ...]:
    """Stage the complete output set before replacing any destination."""
    staged: list[tuple[Path, str | None]] = []
    statuses: list[str] = []
    try:
        for path, content in artifacts:
            path.parent.mkdir(parents=True, exist_ok=True)
            if path.exists() and path.read_bytes() == content:
                staged.append((path, None))
                statuses.append("unchanged")
                continue
            descriptor, temporary = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
            with os.fdopen(descriptor, "wb") as stream:
                stream.write(content)
                stream.flush()
                os.fsync(stream.fileno())
            os.chmod(temporary, mode)
            staged.append((path, temporary))
            statuses.append("written")
        for path, temporary in staged:
            if temporary is None:
                os.chmod(path, mode)
            else:
                os.replace(temporary, path)
        return tuple(statuses)
    except (Exception, KeyboardInterrupt) as exc:
        refuse(
            f"could not install the staged output set ({type(exc).__name__}); "
            "one or more destinations may already have been replaced, so inspect all three outputs"
        )
    finally:
        for _, temporary in staged:
            if temporary is not None and os.path.exists(temporary):
                os.unlink(temporary)


def service_environment(service: dict, service_name: str) -> dict[str, str]:
    declared = service.get("environment", {})
    if isinstance(declared, list):
        declared = dict(item.split("=", 1) for item in declared if isinstance(item, str) and "=" in item)
    if not isinstance(declared, dict):
        refuse(f"rendered service {service_name} has an unreadable environment; correct the project")
    return {str(key): str(value) for key, value in declared.items()}


def validate_compose(
    rendered: dict, env: dict[str, str], old_paths: list[str], images: dict[str, str]
) -> dict[str, str]:
    services = rendered.get("services", {})
    for name in ("coordinator", "answer-service", "forge-publisher"):
        if name not in services:
            refuse(f"rendered project lacks service {name}; correct --compose-file and env inputs")
    expected_images = {
        "coordinator": "FORGE_IMAGE",
        "answer-service": "FORGE_IMAGE",
        "forge-publisher": "FORGE_PUBLISHER_IMAGE",
        "memory": "FLEET_MEMORY_MCP_IMAGE",
        "memory-relay": "FLEET_MEMORY_RELAY_IMAGE",
        "front-door": "JARVIS_IMAGE",
        "bus-gateway": "JARVIS_IMAGE",
        "nats": "NATS_IMAGE",
    }
    for service_name, image_name in expected_images.items():
        if service_name in services and services[service_name].get("image") != images[image_name]:
            refuse(f"rendered service {service_name} does not use immutable {image_name}; correct the env or project")
    for service_name, service in services.items():
        if service.get("build"):
            refuse(f"rendered service {service_name} would build instead of use a tested image; remove its build rule")
        image = service.get("image")
        if image and not IMAGE_ID.fullmatch(str(image)):
            refuse(f"rendered service {service_name} does not use an immutable image ID; correct the env or project")
    expected_consumers = {
        "coordinator": {
            "FORGE_NATS_URL": env["FORGE_NATS_URL"],
            "FORGE_AUTOBUILD_RUNNER_URL": env["FORGE_AUTOBUILD_RUNNER_URL"],
            "FORGE_SANDBOX_SIDECAR_URL": env["FORGE_SANDBOX_SIDECAR_URL"],
            "FORGE_SANDBOX_RUNNER_URL": env["FORGE_SANDBOX_RUNNER_URL"],
            "FORGE_PUBLISHER_URL": env["FORGE_PUBLISHER_URL"],
            "FLEET_MEMORY_EMBED_URL": env["FLEET_MEMORY_EMBED_URL"],
        },
        "memory": {
            "FLEET_MEMORY_MCP_ALLOWED_HOSTS": env["FLEET_MEMORY_ALLOWED_HOSTS"],
            "FLEET_MEMORY_EMBED_URL": env["FLEET_MEMORY_EMBED_URL"],
        },
        "memory-relay": {
            "FLEET_MEMORY_BUS_ADDRESS": env["FLEET_MEMORY_BUS_ADDRESS"],
            "FLEET_MEMORY_EMBED_URL": env["FLEET_MEMORY_EMBED_URL"],
        },
        "front-door": {
            "JARVIS_NATS_URL": env["JARVIS_NATS_URL"],
            "JARVIS_LLAMA_SWAP_BASE_URL": env["JARVIS_MODEL_SEAT_URL"],
        },
        "bus-gateway": {
            "JARVIS_NATS_URL": env["JARVIS_NATS_URL"],
            "JARVIS_LLAMA_SWAP_BASE_URL": env["JARVIS_MODEL_SEAT_URL"],
        },
        "bus-ready": {"BUS_MONITORING_ADDRESS": env["BUS_MONITORING_ADDRESS"]},
        "nats-provision": {"NATS_URL": env["NATS_PROVISION_ADDRESS"]},
    }
    for service_name, expected in expected_consumers.items():
        if service_name not in services:
            continue
        declared = service_environment(services[service_name], service_name)
        for name, value in expected.items():
            if declared.get(name, "") != value:
                refuse(f"rendered service {service_name} does not consume the validated {name}; correct the project")
    coordinator_networks = set(services["coordinator"].get("networks", {}))
    publisher_networks = set(services["forge-publisher"].get("networks", {}))
    if not {"factory", "forge-publisher-net"}.issubset(coordinator_networks) or publisher_networks != {"forge-publisher-net"}:
        refuse("rendered coordinator/publisher networks do not enforce the private publisher route; correct the project")
    members = {name for name, service in services.items() if "forge-publisher-net" in set(service.get("networks", {}))}
    if members != {"coordinator", "forge-publisher"} or services["forge-publisher"].get("ports"):
        refuse("rendered publisher network or ports expose more than coordinator-to-publisher; correct the project")
    gateway = env["FACTORY_GATEWAY_ADDRESS"]
    for name, service in services.items():
        for port in service.get("ports", []) or []:
            host_ip = str(port.get("host_ip", "")) if isinstance(port, dict) else ""
            if host_ip != gateway:
                refuse(f"rendered service {name} publishes outside FACTORY_GATEWAY_ADDRESS; correct the project")
        for mount in service.get("volumes", []) or []:
            if isinstance(mount, dict) and mount.get("type") == "bind" and str(mount.get("source")) in old_paths:
                refuse(f"rendered service {name} binds an old registered project path; remove that bind")
    published = services["answer-service"].get("ports", []) or []
    expected_answer_port = int(require(env, "FORGE_ANSWER_PORT"))
    answer_mapping_matches = (
        len(published) == 1
        and isinstance(published[0], dict)
        and str(published[0].get("host_ip")) == gateway
        and int(published[0].get("target", 0)) == 8126
        and int(published[0].get("published", 0)) == expected_answer_port
        and str(published[0].get("protocol", "tcp")).lower() == "tcp"
    )
    if not answer_mapping_matches:
        refuse(
            "rendered answer service TCP publication does not match "
            "FACTORY_GATEWAY_ADDRESS and the declared callback port; correct the project"
        )
    return service_environment(services["coordinator"], "coordinator")


def main() -> int:
    args = parse_args()
    retire_permissions = [
        str(canonical_host_path(item, "a retired permission choice"))
        for item in args.retire_permission
    ]
    if len(retire_permissions) != len(set(retire_permissions)):
        refuse("a retired permission choice was supplied more than once")
    for index, left in enumerate(map(Path, retire_permissions)):
        for right in map(Path, retire_permissions[index + 1:]):
            if left in right.parents or right in left.parents:
                refuse("retired permission choices overlap and are ambiguous")
    args.evidence_source_path = canonical_host_path(
        args.evidence_source_path, "the declared evidence source path"
    )
    inputs = (args.env_file, args.settings_input, *args.compose_file, args.previous_runtime, *args.secret_env_file)
    for path in inputs:
        if not path.is_file():
            refuse(f"required input {path} is not a readable file; provide its explicit path")
    outputs = (args.env_output, args.settings_output, args.receipt)
    validate_path_boundaries(inputs, outputs)
    if args.plan:
        print(f"PLAN 1 read public env as data from {args.env_file} and private names from {len(args.secret_env_file)} secret file(s)")
        print(f"PLAN 2 rewrite {args.settings_input} to {args.settings_output} with planning disabled and documented names/container paths")
        print(f"PLAN 3 validate with the immutable FORGE_IMAGE, the real loader, and {len(args.compose_file)} ordered Compose file(s)")
        print(
            f"PLAN 4 compare registrations with {args.previous_runtime}, require exact drift acknowledgements, "
            f"add evidence permission={args.add_evidence_permission}, retire permissions={retire_permissions}"
        )
        print(f"PLAN 5 stage the complete output set, then replace {args.env_output}, {args.settings_output}, and {args.receipt}")
        return 0

    public, public_bytes = read_env(args.env_file)
    combined = dict(public)
    secret_values: dict[str, str] = {}
    for secret_path in args.secret_env_file:
        secrets, _ = read_env(secret_path)
        overlap = set(combined) & set(secrets)
        if overlap and any(combined[name].strip() for name in overlap):
            refuse(f"public and private env inputs both define {sorted(overlap)[0]}; keep the value in one explicit input")
        secret_values.update(secrets)
        combined.update(secrets)
    resolved = expand(combined)
    declared_compose = public.get("COMPOSE_FILE", "").strip()
    if declared_compose:
        declared_files = tuple(Path(item) for item in declared_compose.split(os.pathsep) if item)
        explicit_files = tuple(item.resolve() for item in args.compose_file)
        same_graph = len(declared_files) == len(explicit_files) and all(
            declared.resolve() == explicit if declared.is_absolute() else declared.name == explicit.name
            for declared, explicit in zip(declared_files, explicit_files)
        )
        if not same_graph:
            refuse("ordered --compose-file inputs differ from COMPOSE_FILE in --env-file; pass the same project graph explicitly")
    for secret in (value for value in secret_values.values() if len(value) >= 4):
        if secret.encode() in public_bytes:
            refuse(f"public env input {args.env_file} contains a private value; replace it with its env name")

    docker = shutil.which("docker")
    if not docker:
        refuse("docker is not on PATH; install the operational Docker CLI and retry")
    process_env = docker_env(resolved)
    image_ids: dict[str, str] = {}
    for name in IMAGE_NAMES:
        image = require(resolved, name)
        if not IMAGE_ID.fullmatch(image):
            refuse(f"{name} is not an immutable local sha256 image ID; choose the tested image explicitly")
        actual = run([docker, "image", "inspect", "--format", "{{.Id}}", image], env=process_env).decode().strip()
        if actual != image:
            refuse(f"{name} does not resolve to its declared image ID locally; load the exact tested image")
        image_ids[name] = image

    runtime, env_names, mounts = previous_runtime(args.previous_runtime)
    if runtime.get("format_version") != 1:
        refuse(f"previous runtime {args.previous_runtime} is not format_version 1; recreate it with rollout-snapshot")
    if runtime.get("release_image_id") != resolved["FORGE_IMAGE"]:
        refuse("previous runtime release_image_id differs from immutable FORGE_IMAGE; use artifacts from the same rollout")
    mapping_proof = (
        prove_evidence_mapping(args.evidence_source_path, mounts)
        if args.add_evidence_permission
        else None
    )
    operation = {
        "add_evidence_permission": args.add_evidence_permission,
        "retire_permissions": retire_permissions,
        "evidence_mapping_proof": mapping_proof,
    }
    protected_input_hashes = {
        path: hashlib.sha256(path.read_bytes()).hexdigest() for path in inputs
    }
    with tempfile.TemporaryDirectory(prefix="rollout-settings-") as workspace:
        work = Path(workspace)
        transformed = work / "forge.yaml"
        metadata_path = work / "metadata.json"
        command = [
            docker, "run", "--rm", "--network", "none", "--read-only",
            "--user", f"{os.getuid()}:{os.getgid()}", "--tmpfs", "/tmp",
            "--entrypoint", "python",
        ]
        for name in ROUTE_NAMES:
            command.extend(["-e", f"{name}={require(resolved, name)}"])
        command.extend([
            "-v", f"{args.settings_input.resolve()}:/input/forge.yaml:ro",
            "-v", f"{args.previous_runtime.resolve()}:/input/previous-runtime.json:ro",
            "-v", f"{work}:/output", resolved["FORGE_IMAGE"], "-c", TRANSFORMER,
            "/input/forge.yaml", "/output/forge.yaml", "/output/metadata.json", "/input/previous-runtime.json",
            str(args.evidence_source_path), json.dumps(operation, sort_keys=True, separators=(",", ":")),
        ])
        run(command, env=process_env)
        for path, expected_hash in protected_input_hashes.items():
            if hashlib.sha256(path.read_bytes()).hexdigest() != expected_hash:
                refuse(f"input {path} changed while settings were being transformed")
        if mapping_proof is not None:
            verify_evidence_mapping_identity(mapping_proof)
        try:
            metadata = json.loads(metadata_path.read_text(encoding="utf-8"))
            settings_bytes = transformed.read_bytes()
            expected_permission_choices = {
                "add_evidence_permission": operation["add_evidence_permission"],
                "retired_permissions": operation["retire_permissions"],
                "evidence_mapping_proof": operation["evidence_mapping_proof"],
            }
            if metadata.get("permission_choices") != expected_permission_choices:
                refuse("the schema container returned different permission dispositions")
        except Refusal:
            raise
        except Exception as exc:
            refuse(f"the schema container did not produce complete output ({type(exc).__name__}); inspect the chosen image")

        # Reject malformed declared routes before rendering; the generated artifact is
        # checked again below with the environment Compose gives the coordinator.
        route_receipt = validate_routes(resolved, metadata)
        registrations = metadata["registrations"]
        destinations = {
            str(item.get("Destination", item.get("destination", item.get("target", ""))))
            for item in mounts
        }
        drift = sorted(project for project, path in registrations.items() if path not in destinations)
        acknowledged = sorted(set(args.ack_registration_drift))
        if acknowledged != drift:
            refuse(f"registration drift is {drift} but acknowledgements are {acknowledged}; acknowledge each exact project and no other")
        for project in sorted(registrations):
            state = "sandbox configured" if project in metadata["sandbox_projects"] else "retained; unbuildable until sandbox"
            prior = "bound" if registrations[project] in destinations else "not bound (acknowledged)"
            print(f"registration {project}: {state}; previous runtime {prior}; new path {metadata['new_paths'][project]}")

        sweep_terms = list(args.machine_term)
        sweep_terms.extend(part for part in public.get("RELEASE_SWEEP_TERMS", "").split() if part)
        forbidden = ["127.0.0.1", "0.0.0.0", "172.30.1.", "/home/"] + sweep_terms
        decoded_settings = settings_bytes.decode("utf-8")
        found = next((term for term in forbidden if term and term in decoded_settings), None)
        if found:
            refuse(f"rendered settings still contain machine term {found!r}; correct the input or explicit mapping")
        if REFERENCE.search(decoded_settings):
            known = set(REFERENCE.findall(decoded_settings))
            unknown = known - set(ROUTE_NAMES)
            if unknown:
                refuse(f"rendered settings retain unsupported name {sorted(unknown)[0]}; add an explicit documented mapping")

        compose_command = [docker, "compose", "--project-name", args.project, "--env-file", str(args.env_file.resolve())]
        for compose_file in args.compose_file:
            compose_command.extend(["-f", str(compose_file.resolve())])
        compose_command.extend(["config", "--format", "json"])
        private_process_env = docker_env({name: resolved[name] for name in secret_values})
        compose_bytes = run(compose_command, env=private_process_env)
        try:
            rendered = json.loads(compose_bytes)
        except Exception as exc:
            refuse(f"Compose did not return JSON ({type(exc).__name__}); use a supported Docker Compose and retry")
        coordinator_env = validate_compose(rendered, resolved, list(registrations.values()), image_ids)

        loader_command = [
            docker, "run", "--rm", "--network", "none", "--read-only",
            "--user", f"{os.getuid()}:{os.getgid()}", "--tmpfs", "/tmp",
            "--entrypoint", "python",
        ]
        for name in ROUTE_NAMES:
            loader_command.extend(["-e", f"{name}={require(coordinator_env, name)}"])
        loader_command.extend([
            "-v", f"{transformed}:/input/forge.yaml:ro",
            resolved["FORGE_IMAGE"], "-c", LOADER_CHECKER, "/input/forge.yaml",
        ])
        try:
            metadata["routes"] = json.loads(run(loader_command, env=process_env))
        except Exception as exc:
            if isinstance(exc, Refusal):
                raise
            refuse(f"the rendered coordinator could not resolve generated settings ({type(exc).__name__}); correct the project")
        effective_routes = dict(resolved)
        effective_routes.update({name: coordinator_env[name] for name in ROUTE_NAMES})
        route_receipt = validate_routes(effective_routes, metadata)

        receipt = {
            "schema": 1,
            "env_input_sha256": hashlib.sha256(public_bytes).hexdigest(),
            "env_output_sha256": hashlib.sha256(public_bytes).hexdigest(),
            "settings_input_sha256": metadata["input_sha256"],
            "settings_output_sha256": metadata["output_sha256"],
            "project_files": [
                {"path": str(path.resolve()), "sha256": hashlib.sha256(path.read_bytes()).hexdigest()}
                for path in args.compose_file
            ],
            "previous_runtime_sha256": hashlib.sha256(args.previous_runtime.read_bytes()).hexdigest(),
            "images": image_ids,
            "routes": route_receipt,
            "registrations": {
                project: {
                    "new_path": metadata["new_paths"][project],
                    "previously_bound": registrations[project] in destinations,
                    "sandbox_configured": project in metadata["sandbox_projects"],
                    **metadata["registration_permission_coverage"][project],
                }
                for project in sorted(registrations)
            },
            "permission_choices": metadata["permission_choices"],
            "registration_permission_coverage": metadata["registration_permission_coverage"],
            "registration_drift_acknowledged": acknowledged,
            "previous_runtime_environment_names": sorted(env_names),
            "checks": ["forge.config.loader.load_config", "section-7-routes", "docker-compose-config", "machine-value-sweep"],
        }
        receipt_bytes = (json.dumps(receipt, indent=2, sort_keys=True) + "\n").encode()
        env_status, settings_status, receipt_status = install_artifacts((
            (args.env_output, public_bytes),
            (args.settings_output, settings_bytes),
            (args.receipt, receipt_bytes),
        ))
    print(f"settings preparation complete: env {env_status}; settings {settings_status}; receipt {receipt_status}")
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except Refusal as exc:
        print(f"REFUSED: {exc}", file=sys.stderr)
        raise SystemExit(2)
    except KeyboardInterrupt:
        print(
            "REFUSED: settings preparation was interrupted; inspect all three outputs before retrying.",
            file=sys.stderr,
        )
        raise SystemExit(2)
    except Exception as exc:
        print(f"REFUSED: settings preparation hit {type(exc).__name__}; inspect the explicit inputs and retry.", file=sys.stderr)
        raise SystemExit(2)
