    def upgrade_markers(self):
        """The switch's two resume markers, read from its own snapshot and never written.

        They are checked against the release they name, not this inventory's: they
        say which release the estate was resumed on, which an upgrade does not change."""
        try:host_record=marker_file(private_path(self.authority/'resumed.json'))
        except Exception:r.refuse('the switch\'s host resume marker is present but unsafe or unreadable; preserve it and reconcile before an upgrade')
        ledger_record={'present':False}
        if self.volume_exists():
            code="import json\n"+inspect_source.getsource(marker_file)+"\nprint(json.dumps(marker_file('/state/ROLLOUT-RESUMED')))"
            try:ledger_record=json.loads(self.volume('ledger',code))
