    def ready_budget(self,cap=r.TIMEOUT_SECONDS):
        """Subprocess keywords for a call inside the readiness wait: its own cap or
        what remains of the wait's one deadline, whichever is less. Outside the
        wait there is no deadline and the call keeps rollout_support's default."""
