        text=re.sub(r'(?i)(https?://)[^\s/@:]+:[^\s/@]+@',r'\1[REDACTED]@',text)
        text=re.sub(r'(?im)^([^\n]*(?:authorization|password|access.token|api.key|secret)\s*[:=]\s*).+$',r'\1[REDACTED]',text)
        return text[-32768:]
