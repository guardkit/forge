        r.run([HERE/'estate-check','--read-pre-resume','--env-file',self.args.env_file,'--project',self.c['project'],'--for-image',self.entry['runtime']],env=self.env)
        need(self.values.get('ROLLOUT_STATE_DIR')==str(self.closed_door),'the closed-door receipt is not in this release\'s own folder; bind ROLLOUT_STATE_DIR to closed_door_dir')
        result={'format_version':1,'release':self.release,'started_at':now(),'services_check':None,'factory_hello':None,'passed':False,'commands':[],'markers':'untouched'}
        destination=private_path(self.snapshot/('opened-'+self.release+'.json'))
