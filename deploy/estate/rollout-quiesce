            self._diagnostic_stage='producer-open';self.compose('up','--no-deps','-d',*PRODUCERS)
            self._diagnostic_stage='readiness-wait';self.wait_ready(result['commands'])
            self.captured([HERE/'estate-check','services','--env-file',self.args.env_file,'--project',self.c['project']],'estate-check services',result['commands'],env=self.env);result['services_check']='passed'
            self.captured([HERE/'factory-hello','--env-file',self.args.env_file,'--project',self.c['project']],'factory-hello',result['commands'],env=self.env);result['factory_hello']='completed'
            self._diagnostic_stage='gateway-watch-start';self.compose('--profile','watch','up','--no-deps','-d','gateway-watch');result['passed']=True
        except Exception as exc:
            result['failure']={'stage':result['commands'][-1]['stage'] if result['commands'] else self._diagnostic_stage,'reason':self.sanitize(str(exc))}
            self._diagnostic_events=None;result['cleanup']=self.shut_again()
            raise
        finally:
            self._diagnostic_events=None;result['finished_at']=now();r.atomic_json(destination,result)
        return result

    def shut_again(self):
        """After a failed open: producers and watch stopped, planning off, each said separately."""
        cleanup={}
        for name,step in (('producers_stopped',lambda:self.stop_current(PRODUCERS)),('watch_stopped',lambda:self.watch_closed(stop=True)),('planning_enabled_false',lambda:self.planning(False))):
            try:step();cleanup[name]=True
            except Exception as exc:cleanup[name]=False;cleanup[name+'_reason']=self.sanitize(str(exc))
        return cleanup

    def open(self):return self.open_door()
    def plan(self,mode):
        # Do not create helper containers, SQLite sidecars, or E2 probe files.
        # Facts needing an execution namespace are explicitly unknown in preview.
        observations={'markers':{'status':'UNKNOWN','action':'read both actual marker locations during execution'},'readers':{'status':'UNKNOWN','action':'read live monitoring twice and after stopping writers during execution'}}
        try:
            if self.phase=='original':
                p=r.path(self.c['source_db']);wal=Path(str(p)+'-wal')
                need(not wal.exists() or wal.stat().st_size==0,'committed WAL requires the actual readonly observation')
                observations['work']=r.ledger_state(p,consolidated=True)
            else:
                metadata=r.read_json(self.snapshot/'metadata.json')
                observations['historical_snapshot_work']=metadata['work_state']
                observations['work']={'status':'UNKNOWN','action':'read current volume during execution; snapshot facts are historical only'}
        except Exception:observations['work']={'status':'UNKNOWN','action':'inspect the declared phase input before execution'}
        result={'plan':True,'mode':mode,'phase':self.phase,'observations':observations,'notice':'No state, helper container, receipt-store probe, marker, unit or application changed; no session may run forge queue.'}
        if self.upgrade:
            result['upgrade']={'release':self.release,'side':self.side,'from':self.upgrade['from']['release'],'to':self.upgrade['to']['release'],
                               'receipt':str(self.receipt),'closed_door_dir':str(self.closed_door),'markers':'read from '+str(self.authority)+', never written'}
        return result

def arguments(argv=None,back=False):
    p=r.Parser(description=__doc__);p.add_argument('--config',required=True);p.add_argument('--env-file',required=True);p.add_argument('--project',required=True);p.add_argument('--snapshot',required=True);p.add_argument('--secret-env-file',action='append',default=[]);p.add_argument('--plan',action='store_true')
    if not back:
        modes=p.add_mutually_exclusive_group(required=True)
        for mode in ('close','settle','final','switch','open','resume','reopen'):modes.add_argument('--'+mode,action='store_const',const=mode,dest='mode')
    return p

def main(argv=None):
    args=arguments().parse_args(argv)
    return r.main_guard(lambda: Estate(args).plan(args.mode) if args.plan else getattr(Estate(args),args.mode)())
if __name__=='__main__':raise SystemExit(main())
