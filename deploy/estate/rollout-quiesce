def stable_runtime(item):
    # Runtime endpoint IDs and assigned IPs disappear on stop. Only declarative
    # network identity/aliases/IPAM options participate in the reconstruction seal.
    identity={k:v for k,v in item['service_identity'].items() if k!='container_id'}
    networks={k:{f:v.get(f) for f in ('Aliases','Links','IPAMConfig','DriverOpts')} for k,v in item['networks'].items()}
    for network in networks.values():
        network['Aliases']=sorted(a for a in network['Aliases'] or [] if a not in (item['service_identity']['container_id'],item['service_identity']['container_id'][:12]))
    return {k:item[k] for k in ('image_id','repo_tags','mounts','port_bindings','restart_policy','network_mode','env_names')} | {'service_identity':identity,'networks':networks}

def work_problems(state):
    result=[];work=state['work_state']
    for table,record in work.items():
        if record.get('status')=='NOT-YET':continue
        for row in record['rows']:
            active = (table=='builds' and (row['status'] in ACTIVE_BUILDS or row.get('pending_approval_request_id'))
                or table=='planning_runs' and (row['state'] in ACTIVE_PLANS or row.get('pending_approval_request_id'))
                or table=='work_queue'
                or table=='publication_records' and row.get('result')!='merged into the remote and running'
                or table=='deployment_targets' and bool(row.get('holder_build')))
            if active:result.append({'table':table,'row':row})
    return result

def reader_counts(doc, account=''):
    need(isinstance(doc,dict) and isinstance(doc.get('account_details'),list),'monitoring response is unknown; restore its complete account details before proceeding')
    holders=[]
    for a in doc['account_details']:
        if account and a.get('name')!=account:continue
        for stream in a.get('stream_detail',[]):
            if stream.get('name')=='PIPELINE':holders.append((a.get('name'),stream))
    need(len(holders)==1,'PIPELINE account is absent or ambiguous; explicitly select its real account before proceeding')
    name,stream=holders[0];result={}
    for wanted in ('forge-serve','forge-serve-planning'):
        rows=[x for x in stream.get('consumer_detail',[]) if x.get('name')==wanted]
        need(len(rows)==1,f'reader {wanted} is absent or ambiguous; restore its monitoring identity before proceeding')
        row=rows[0]
        need(all(type(row.get(k)) is int and row[k]>=0 for k in ('num_pending','num_ack_pending')),f'reader {wanted} has unknown counts; restore readable integer observations before proceeding')
        result[wanted]={k:row.get(k) for k in ('num_pending','num_ack_pending','delivered','ack_floor')}
    return {'account':name,'stream':'PIPELINE','readers':result}

def quiet_counts(counts):
    for name,values in counts['readers'].items():
        need(values['num_pending']==values['num_ack_pending']==0,f'reader {name} still has pending or unacknowledged work; leave admissions closed and let it settle')

