    def side_hashes(self,side):
        """The env and compose files of one side, hashed now; refuses when they differ from the block."""
        s=self.upgrade[side]
        actual={'release':s['release'],'env_file':s['env_file'],'env_sha256':r.sha256(r.path(s['env_file'])),
