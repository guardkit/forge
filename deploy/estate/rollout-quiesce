        need(actual['env_sha256']==s['env_sha256'] and actual['compose_files']==[{'path':x['path'],'sha256':x['sha256']} for x in s['compose_files']],
             f'release {s["release"]}\'s env or compose files no longer have the SHA-256 the upgrade recorded; put them back as they were reviewed, or review and record the change, before going on')
        return actual

