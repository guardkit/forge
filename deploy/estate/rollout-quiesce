def effective_argv(identity):
    """Return the process argv independent of Docker's CLI-only split point."""
    entry=identity.get('entrypoint') or [];command=identity.get('command') or []
    if isinstance(entry,str):entry=[entry]
    need(isinstance(entry,list) and all(isinstance(x,str) for x in entry),'old entrypoint is not an explicit string argument list; reconcile its recorded runtime')
    need(isinstance(command,list) and all(isinstance(x,str) for x in command),'old command is not an explicit string argument list; reconcile its recorded runtime')
    return entry+command

def stable_mount(mount):
    """Canonicalize only Docker's two spellings of a plain bind ro/rw mode."""
    result=dict(mount)
    if result.get('Type')!='bind':return result
    allowed={'Type','Source','Destination','Mode','RW','Propagation'}
    required={'Type','Source','Destination','RW','Propagation'}
    need(required<=set(result)<=allowed,'saved bind mount carries unsupported options; reconcile its exact semantics before recovery')
    need(type(result['RW']) is bool and all(isinstance(result[k],str) and result[k] for k in ('Source','Destination')),'saved bind mount identity is incomplete; reconcile its exact semantics before recovery')
    need(not any(x in result[k] for k in ('Source','Destination') for x in (',','\n','\r')),'saved bind mount path cannot be represented safely by Docker --mount; reconcile it before recovery')
    expected='rw' if result['RW'] else 'ro';mode=result.get('Mode','')
    need(mode in ('',expected),'saved bind mount mode contains unsupported or contradictory options; reconcile its exact semantics before recovery')
    need(result['Propagation'] in ('','private','rprivate','shared','rshared','slave','rslave'),'saved bind propagation cannot be represented by Docker --mount; reconcile it before recovery')
    result['Mode']=expected
    return result


def stable_mount_inventory(mounts):
    """Return the complete mount inventory in deterministic destination order."""
    need(isinstance(mounts,list),'saved mount inventory is malformed; reconcile its exact semantics before recovery')
    result=[];destinations=set()
    for mount in mounts:
        need(isinstance(mount,dict),'saved mount inventory contains a malformed entry; reconcile its exact semantics before recovery')
        destination=mount.get('Destination')
        need(isinstance(destination,str) and destination.startswith('/') and not destination.startswith('//')
             and '\x00' not in destination and posixpath.normpath(destination)==destination,
             'saved mount destination is not one canonical absolute path; reconcile its exact semantics before recovery')
        need(destination not in destinations,'saved mount destinations are ambiguous; reconcile duplicate destinations before recovery')
        destinations.add(destination);result.append(stable_mount(mount))
    return sorted(result,key=lambda mount:mount['Destination'])


def stable_runtime(item):
    # Runtime endpoint IDs and assigned IPs disappear on stop. Only declarative
    # network identity/aliases/IPAM options participate in the reconstruction seal.
    # Docker create accepts one --entrypoint value, so a saved multi-element
    # Entrypoint is reconstructed as that value plus Cmd. The engine launches the
    # same concatenated argv; seal that argv while retaining every other identity.
    identity={k:v for k,v in item['service_identity'].items() if k not in ('container_id','entrypoint','command')}
    identity['effective_argv']=effective_argv(item['service_identity'])
    networks={k:{f:v.get(f) for f in ('Aliases','Links','IPAMConfig','DriverOpts')} for k,v in item['networks'].items()}
    for network in networks.values():
        network['Aliases']=sorted(a for a in network['Aliases'] or [] if a not in (item['service_identity']['container_id'],item['service_identity']['container_id'][:12]))
    stable={k:item[k] for k in ('image_id','repo_tags','port_bindings','restart_policy','network_mode','env_names')}
    return stable | {'mounts':stable_mount_inventory(item['mounts']),'service_identity':identity,'networks':networks}

def canonical_approval_component(value):
    try:decoded=unquote_to_bytes(value).decode('utf-8','strict')
    except UnicodeDecodeError:return False
    encoded=quote(decoded,safe='').replace('.','%2E').replace('~','%7E')
    return encoded==value

def completed_terminal_planning_approval(row):
    """Recognize only the exact completed history written by planning."""
    request_id=row.get('pending_approval_request_id')
    if (row.get('state') not in TERMINAL_PLANS or not isinstance(request_id,str)
            or not APPROVAL_REFERENCE.fullmatch(request_id)):
        return False
    encoded_build,encoded_stage,_attempt=request_id.split(':')
    if not (canonical_approval_component(encoded_build)
            and canonical_approval_component(encoded_stage)):
        return False
    value=row.get('completed_at')
    if not isinstance(value,str):return False
    try:completed=datetime.fromisoformat(value)
    except ValueError:return False
    return (completed.tzinfo is not None
        and completed.utcoffset()==timezone.utc.utcoffset(completed)
        and completed.isoformat()==value)

def work_problems(state):
    result=[];work=state['work_state']
    for table,record in work.items():
        if record.get('status')=='NOT-YET':continue
        for row in record['rows']:
            active = (table=='builds' and (row['status'] in ACTIVE_BUILDS or row.get('pending_approval_request_id'))
                or table=='planning_runs' and (
                    row.get('state') in ACTIVE_PLANS
                    or row.get('state') not in ACTIVE_PLANS|TERMINAL_PLANS
                    or 'pending_approval_request_id' not in row
                    or row.get('pending_approval_request_id') is not None
                        and not completed_terminal_planning_approval(row))
                or table=='work_queue'
                or table=='publication_records' and row.get('result')!='merged into the remote and running'
                or table=='deployment_targets' and bool(row.get('holder_build')))
            if active:result.append({'table':table,'row':row})
    return result

