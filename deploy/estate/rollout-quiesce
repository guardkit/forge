        need(not switch_receipt or Path(switch_receipt)!=self.receipt,'the upgrade receipt is the switch\'s close receipt; name a new private receipt so the switch\'s stays exactly as it was')
        need(not any(p==self.receipt or p in self.receipt.parents for p in (self.snapshot,self.authority)),'the upgrade receipt lies inside a snapshot folder; choose a private path outside both')
        self.sandbox_evidence=private_path(self.receipt.with_name(self.receipt.name+'.rollout-sandbox-command.json'))
