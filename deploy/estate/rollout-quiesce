    def upgrade_inputs(self,args):
        c=self.c;u=self.upgrade
        need(isinstance(u,dict) and {'from','to','receipt','snapshot','authority_snapshot','closed_door_dir'}<=set(u),'the upgrade block is incomplete; name from, to, receipt, snapshot, authority_snapshot and closed_door_dir')
        need('release' in c,'an upgrade inventory names its own release; add release to the inventory')
        self.release,self.entry=r.release(c)
        for side in ('from','to'):
            s=u[side]
            need(isinstance(s,dict) and isinstance(s.get('release'),str) and s['release'] in r.RELEASES,f'the upgrade block\'s {side} side does not name a release in the reviewed table; correct the upgrade block')
            need(isinstance(s.get('env_file'),str) and re.fullmatch('[0-9a-f]{64}',str(s.get('env_sha256'))) and isinstance(s.get('compose_files'),list) and s['compose_files']
                 and all(isinstance(x,dict) and isinstance(x.get('path'),str) and re.fullmatch('[0-9a-f]{64}',str(x.get('sha256'))) for x in s['compose_files']),
                 f'the upgrade block\'s {side} side must name its env file and its compose files, each with its SHA-256; correct the upgrade block')
        need(u['from']['release']!=u['to']['release'],'the upgrade block names the same release on both sides; name the release it leaves and the one it goes to')
        need(self.release in (u['from']['release'],u['to']['release']),f'this inventory names release {self.release}, which is neither side of the upgrade; use the inventory of one of the two releases')
        self.side='from' if self.release==u['from']['release'] else 'to'
        mine=u[self.side]
        need(re.fullmatch(r'[a-z0-9][a-z0-9_-]+',args.project) and args.project==c['project'],'explicit project conflicts with the inventory; select the intended inventory')
        need(args.env_file==c['env_file']==mine['env_file'],f'the env file differs between the command line, the inventory and the upgrade block\'s {self.side} side; use the env file of release {self.release}')
        need(c['compose_files']==[x['path'] for x in mine['compose_files']],f'the inventory\'s compose files differ from the upgrade block\'s {self.side} side; use the compose files of release {self.release}')
        need(c['runtime_image']==self.entry['runtime'],'estate project or runtime identity is invalid; use the accepted explicit release')
        need(set(c['volumes'])==r.VOLUME_ROLES and len(set(c['volumes'].values()))==5 and all(re.fullmatch('[a-zA-Z0-9][a-zA-Z0-9_.-]+',name) for name in c['volumes'].values()),'five distinct state volumes are required; correct the explicit inventory')
