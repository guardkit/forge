def docker_time(value):
    """Docker's RFC 3339 time (nanoseconds, Z) as an aware datetime."""
    m=re.fullmatch(r'(\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d)(?:\.(\d+))?(Z|[+-]\d\d:\d\d)',value or '')
    need(m,f'Docker reported an unreadable time {value!r}; inspect the container')
    return datetime.fromisoformat(m[1]+'.'+(m[2] or '')[:6].ljust(6,'0')+('+00:00' if m[3]=='Z' else m[3]))
