    def readiness(self,ids,restarts):
        """One observation of what resume opened: (not yet ready, never will be), each by service."""
        waiting={};broken={}
        for name,identifier in ids.items():
            found=self.ask(f'Docker about the {name} container {identifier[:12]}','inspect',identifier)
            try:item=json.loads(found.stdout)[0] if found.returncode==0 else None
            except (ValueError,IndexError,TypeError):item=None
            if not isinstance(item,dict):
                broken[name]=f'{name} container {identifier[:12]} can no longer be inspected; it was removed or replaced after resume opened it';continue
            state=item.get('State') or {}
            if item.get('RestartCount')!=restarts[name]:
                broken[name]=f'{name} has restarted since resume opened it (restart count {restarts[name]} then {item.get("RestartCount")}); read its log';continue
            if not state.get('Running') or state.get('Restarting'):
                waiting[name]=f'{name} is not running (Docker status {state.get("Status")})';continue
            if name in HEALTHCHECKED:
                health=(state.get('Health') or {}).get('Status')
                if health is None:
                    broken[name]=f'{name} has no Docker healthcheck although its compose file defines one, so it can never be seen healthy';continue
                if health!='healthy':
                    waiting[name]=f'{name} Docker health is {health}';continue
            if name=='coordinator':
                # Docker health asks only whether it answers at all; item 8e needs 200.
                code=self.ask('the coordinator for its health route','exec',identifier,'curl','-s','-o','/dev/null','--max-time','5','-w','%{http_code}','http://localhost:8080/healthz').stdout.strip()
                if code!='200':waiting[name]=f'coordinator answered its health route with {code or "nothing"}; it answers 200 only once its subscription to the bus is live'
            if name=='bus-gateway':
                # No healthcheck and no port: the bus is asked, from inside the
                # coordinator, as estate-check item 8i asks it in external mode.
                if 'coordinator' in waiting or 'coordinator' in broken:
                    waiting[name]='bus-gateway cannot be asked about until the coordinator it is asked from is ready';continue
                address=self.values['BUS_MONITORING_ADDRESS'];account=self.values['JARVIS_NATS_USER']
                client='bus-gateway-'+(self.values.get('FACTORY_INSTANCE') or 'factory');subject=self.values.get('GATEWAY_WATCH_SUBJECT') or 'agents.command.jarvis'
                code='import json,sys,urllib.request\n'+inspect_source.getsource(gateway_connections)+"\ndoc=json.loads(urllib.request.urlopen('http://'+sys.argv[1]+'/connz?auth=1&subs=1',timeout=5).read().decode())\nprint(gateway_connections(doc,*sys.argv[2:5]))\n"
                count=self.ask(f'the bus at {address}, from inside the coordinator, for its connections','exec',ids['coordinator'],'python','-c',code,address,account,client,subject).stdout.strip()
                if not (count.isdigit() and int(count)>0):
                    waiting[name]=f"the bus at {address} holds no connection yet with the client name '{client}' and the subscription {subject} on the '{account}' account"+('' if count.isdigit() else ' (the bus could not be asked)')
        return waiting,broken
    def wait_ready(self,events):
        """Wait, bounded by one READY_DEADLINE_SECONDS deadline taken before the
        containers are even found, until the recreated coordinator and the opened
        producers are ready to be checked; refuse naming what is not, or what
        could not be asked in time, or readiness that arrived after the deadline."""
        opened=('coordinator',*PRODUCERS)
        event={'stage':'readiness-wait','waited_for':list(opened),'deadline_seconds':READY_DEADLINE_SECONDS,'started_at':now(),'polls':0,'ready':False}
        started=time.monotonic();deadline=self._ready_deadline=started+READY_DEADLINE_SECONDS
        try:
            try:
                need(self.values.get('BUS_MONITORING_ADDRESS') and self.values.get('JARVIS_NATS_USER'),'the env file names no BUS_MONITORING_ADDRESS or JARVIS_NATS_USER, so whether the bus gateway is on the bus cannot be asked')
                self._ready_asking='Docker for the containers resume opened (compose config, compose ps and inspect)'
                items=self.service_ids(opened)
            # After discovery's own recorded commands, so this event stays the stage's last.
            finally:events.append(event)
            need(set(items)==set(opened),'resume opened '+', '.join(x for x in opened if x not in items)+' and no container exists for it; read the compose output in this receipt')
            ids={name:items[name]['Id'] for name in opened};restarts={name:items[name].get('RestartCount') for name in opened}
            while True:
                event['polls']+=1;waiting,broken=self.readiness(ids,restarts)
                event['not_ready']={name:self.sanitize(text) for name,text in {**waiting,**broken}.items()}
                need(not broken,'readiness-wait: '+'; '.join(broken.values())+'. The services check was not run.')
                late=time.monotonic()-deadline
                if not waiting:
                    need(late<=0,f'readiness-wait: readiness arrived after the deadline: what resume opened was first seen ready {late:.1f} s after its {READY_DEADLINE_SECONDS} s. The services check was not run.')
                    event['ready']=True;return
                if late<0:time.sleep(min(READY_POLL_SECONDS,-late))
                need(time.monotonic()<deadline,f'readiness-wait: after {READY_DEADLINE_SECONDS} s these were still not ready: '+'; '.join(waiting.values())+'. The services check was not run.')
        except subprocess.TimeoutExpired as exc:
            failure=r.Refusal(f'readiness-wait: asking {self._ready_asking} got no answer within {exc.timeout:.1f} s, and the wait allows {READY_DEADLINE_SECONDS} s in all. The services check was not run.')
            event['reason']=self.sanitize(str(failure));raise failure from None
        except Exception as exc:
            event['reason']=self.sanitize(str(exc));raise
        finally:
            self._ready_deadline=self._ready_asking=None
            event['seconds']=round(time.monotonic()-started,1);event['finished_at']=now()

