        need(host==ledger_record.get('value') and host.get('format_version')==1 and host.get('project')==self.c['project'] and host.get('snapshot')==str(self.authority),'resume markers disagree, or name another project or snapshot; keep current authority and reconcile them')
        required={'snapshot_sha256','release_tag','image_id','actor','at','work_state','close_receipt_sha256'}
        named=str(host.get('release_tag','')).rpartition(':')[2]
        need(required<=host.keys() and named in r.RELEASES and host['image_id']==r.RELEASES[named]['runtime'],'resume markers name a release that is not in the reviewed table, or another image than that release\'s; retain current authority and reconcile them')
        need(host['snapshot_sha256']==r.read_json(self.authority/'metadata.json')['sha256'],'resume marker names another snapshot; retain current authority and reconcile its provenance')
