        need(isinstance(ledger_record,dict) and type(ledger_record.get('present')) is bool,'ledger marker presence is unknown; preserve current authority and reconcile')
        need(host_record['present']==ledger_record['present'],'resume marker exists in only one place; keep the estate as it is and reconcile both original markers')
        need(host_record['present'],'this estate has no resume markers, so it was never resumed; an upgrade takes an estate the switch resumed')
