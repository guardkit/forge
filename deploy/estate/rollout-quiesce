        need(self.upgrade,'--open belongs to an upgrade inventory; this one has no upgrade block')
        self.markers();self.record()
        switched=[x for x in self.doc.get('switches',[]) if x.get('release')==self.release and x.get('passed')]
        need(switched,f'release {self.release} has not been brought up with the door shut; run --switch for it first. Nothing was started')
        since=datetime.fromisoformat(switched[-1]['started_at'])
        # Steps 1-5 change nothing (runbook TC2, in resume()'s order).
        model=self.model()
        self.require_on_release(model,self.closed_door_items(model))
        self.judge_bus_ready(self.bus_ready(),since)
        self.producers_stopped();self.watch_closed(required=True)
        for index in range(2):
