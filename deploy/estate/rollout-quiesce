                need(service in (SUPERVISOR,'gateway-watch'),f'service {service} is absent from the rendered graph; correct the release\'s Compose inputs');continue
            expected=self.release_images(service)
            need(isinstance(expected,str) and re.fullmatch(r'sha256:[0-9a-f]{64}',expected),f'release {self.release} names no immutable image for {service}; correct the env file\'s provisioning image or the release table')
            need(services[service].get('image')==expected,f'{service} does not render release {self.release}\'s image from the reviewed table; correct the env image IDs')

    def project_containers(self):
        """Every container of this Compose project, by ID: service, image, name and state."""
        ids=r.docker(self.c,'ps','--all','--filter','label=com.docker.compose.project='+self.c['project'],'--format','{{.ID}}').stdout.split()
        result={}
        for identifier in ids:
            item=r.inspect(self.c,identifier);labels=item['Config'].get('Labels') or {}
            need(labels.get('com.docker.compose.project')==self.c['project'] and labels.get('com.docker.compose.service'),f'container {identifier} has unclear ownership; leave it untouched and reconcile')
            result[item['Id']]={'service':labels['com.docker.compose.service'],'image':item['Image'],'name':item.get('Name'),'status':item['State'].get('Status')}
        return result

    def volume_record(self):
        names=r.docker(self.c,'volume','ls','--filter','label=com.docker.compose.project='+self.c['project'],'--format','{{.Name}}').stdout.split()
        items=json.loads(r.docker(self.c,'volume','inspect',*names).stdout) if names else []
        result={item['Name']:{'Mountpoint':item.get('Mountpoint'),'CreatedAt':item.get('CreatedAt')} for item in items}
        need(set(self.c['volumes'].values())<=set(result),'a state volume the inventory names does not belong to this project; reconcile the volume mapping')
        return result

    def settings_digests(self,wanted=None):
        """Digests of the settings volume's forge.yaml, never its values (runbook 2.6)."""
        args=[json.dumps(wanted)] if wanted is not None else []
        return json.loads(self.volume('settings',SETTINGS_DIGEST_CODE,args))

    def settings_invariant(self):
        """The settings file is U1's apart from planning.enabled, the one value the tools write."""
        recorded=self.doc['settings'];actual=self.settings_digests({'planning_enabled':recorded['planning_enabled']})
        need(actual['canonical_sha256']==recorded['canonical_sha256'] and recorded['sha256'] in (actual['sha256'],actual['rewritten_sha256']),
             'the coordinator\'s settings file differs from the one recorded at --close in more than planning.enabled; an upgrade never changes the settings, so nothing is started. Find what changed it and put it back')
        return actual

    def sandbox_facts(self):
        """What this release's supervisor runs inside its sandbox, from its own env files."""
        name=self.values.get('SANDBOX_NAME','');script=self.values.get('SANDBOX_BOOTSTRAP','');bootstrap=self.values.get('SANDBOX_PROJECT_ENV_FILE','')
        need(re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9_.-]*',name) and script and not script.startswith('-') and bootstrap,'the env file does not name the sandbox, its bootstrap and its bootstrap env file; the sandbox supervisor cannot be checked')
        bootstrap=r.path(bootstrap)
        values,_=load_script('rollout-settings').read_env(bootstrap)
        settings=values.get('FORGE_CONFIG_PATH') or None
        need(settings is None or (settings.startswith('/') and not settings.startswith('-')),'the bootstrap env names a relative FORGE_CONFIG_PATH; name the sandbox settings file by its absolute path')
        prefix=values.get('SANDBOX_CONTAINER_PREFIX') or self.values.get('SANDBOX_CONTAINER_PREFIX') or 'forge-sandbox'
        return {'name':name,'script':script,'bootstrap_env_file':str(bootstrap),'settings_path':settings,'prefix':prefix,'image':values.get('FORGE_IMAGE')}

    def sbx(self,*argv):
        env={'PATH':os.environ.get('PATH','/usr/local/bin:/usr/bin:/bin'),'LANG':'C.UTF-8'}
        for key in ('HOME','USER','XDG_RUNTIME_DIR','DBUS_SESSION_BUS_ADDRESS'):
            if key in os.environ:env[key]=os.environ[key]
        events=getattr(self,'_diagnostic_events',None)
        if events is None:return r.run(['sbx',*argv],env=env)
        return self.captured(['sbx',*argv],self._diagnostic_stage,events,env=env)

    def sandbox_hashes(self):
        """SHA-256 of the clone's bootstrap and the sandbox settings file (read inside the
        sandbox) and of the bootstrap env file (on this machine)."""
        facts=self.sandbox_facts();files=[facts['script']]+([facts['settings_path']] if facts['settings_path'] else [])
        seen={}
        for line in self.sbx('exec',facts['name'],'sha256sum','--',*files).stdout.splitlines():
            digest,_,name=line.partition('  ')
            if re.fullmatch('[0-9a-f]{64}',digest):seen[name.strip()]=digest
        need(all(x in seen for x in files),'the sandbox did not report the hash of its bootstrap or settings file; check the sandbox answers and both files exist')
        return {'template_sha256':seen[facts['script']],'bootstrap_env_file':facts['bootstrap_env_file'],'bootstrap_env_sha256':r.sha256(facts['bootstrap_env_file']),
                'settings_path':facts['settings_path'],'settings_sha256':seen.get(facts['settings_path']) if facts['settings_path'] else None}

    def expected_sandbox(self):
        """The three hashes recorded for this release: at --close for the release that
        was running, or in the installation receipt rollout-sandbox --upgrade wrote."""
        recorded=(self.doc.get('sandbox') or {}).get(self.release)
        if recorded:return recorded
        need(self.release==self.upgrade['to']['release'],f'no sandbox installation is recorded for release {self.release}; run --close with its inventory first')
        need(isinstance(self.c.get('sandbox'),dict) and isinstance(self.c['sandbox'].get('evidence_dir'),str),'the inventory names no sandbox.evidence_dir, where rollout-sandbox --upgrade writes its installation receipt; name it')
        receipt=r.read_json(private_path(Path(self.c['sandbox']['evidence_dir'])/'sandbox-installed.json',exists=True))
        hexes=all(isinstance(receipt.get(k),str) and re.fullmatch('[0-9a-f]{64}',receipt[k]) for k in ('template_sha256','bootstrap_env_sha256','settings_sha256'))
        need(receipt.get('format_version')==2 and receipt.get('image')==self.entry['runtime'] and hexes,f'the sandbox installation receipt is not rollout-sandbox --upgrade\'s for release {self.release}; run that step before --switch')
        return {k:receipt[k] for k in ('template_sha256','bootstrap_env_sha256','settings_sha256')}

    def one_container(self,service,*,profile=()):
        ids=self.compose(*profile,'ps','--all','-q',service).stdout.split()
        need(len(ids)<=1,f'service {service} has more than one container; reconcile its exact identity')
        return r.inspect(self.c,ids[0]) if ids else None

    def closed_door_items(self,model):
        services=[s for s in LONG_RUNNING if s in model.get('services',{})]
        return self.service_ids(services)

    def require_on_release(self,model,items):
        """Every long-running closed-door service running on this release's image."""
        for service in (s for s in LONG_RUNNING if s in model.get('services',{})):
            item=items.get(service)
            need(item and item['State'].get('Running') and item['Image']==self.release_images(service),f'{service} is not running on release {self.release}; run --switch for this release first. Nothing was started')

    def bus_ready(self):
        item=self.one_container(ONE_SHOT)
        if item is None:return None
        state=item['State']
        return {'id':item['Id'],'image':item['Image'],'running':bool(state.get('Running')) or state.get('Status') in ('created','restarting'),'status':state.get('Status'),'exit':state.get('ExitCode'),'started_at':state.get('StartedAt'),'finished_at':state.get('FinishedAt')}

    def judge_bus_ready(self,ready,since):
        """bus-ready is a one-shot: proven only once it has exited 0 on its image in this run."""
        need(ready is not None,'bus-ready has no container; run --switch for this release')
        need(not ready['running'],'bus-ready is still running its comparison against the bus, so it has proven nothing yet; wait for it to finish and run this step again')
        need(ready['image']==self.release_images(ONE_SHOT),f'bus-ready ran another image than release {self.release}\'s provisioning image; run --switch for this release')
        need(ready['status']=='exited' and ready['exit']==0,f'bus-ready exited {ready["exit"]}: the bus differs from the pinned definitions or could not be read. Read its log; the door stays shut')
        need(docker_time(ready['started_at'])>=since,'bus-ready last ran before this release was brought up; run --switch for this release')
        return ready

    def run_bus_ready(self,since):
        self.compose('up','-d','--no-deps',ONE_SHOT)
        deadline=time.monotonic()+BUS_READY_WAIT_SECONDS
        while True:
            ready=self.bus_ready()
            if ready is None or not ready['running'] or time.monotonic()>=deadline:break
            time.sleep(READY_POLL_SECONDS)
        need(ready is None or not ready['running'],f'bus-ready was still running after {BUS_READY_WAIT_SECONDS} s; the door stays shut. Read its log, then run --switch again')
        return self.judge_bus_ready(ready,since)

    def load_settings(self):
        """This release's image loads the current settings file with the estate env."""
        code=GUARD+"import pathlib; from forge.config.loader import load_config; load_config(pathlib.Path('/state/forge.yaml')); print('loaded')"
        self.volume('settings',code,environment=True)

    def policy_verify(self,*,require_members):
        need(self.c['docker_context']=='default','the publisher policy is bound to the local default Docker context; use it')
        env={'PATH':os.environ.get('PATH','/usr/sbin:/usr/bin:/sbin:/bin'),'DOCKER_HOST':'unix:///var/run/docker.sock'}
        daemon=r.docker(self.c,'info','--format','{{.ID}}').stdout.strip()
        argv=['sudo','-n','--',POLICY_HELPER,'verify','--docker-host',env['DOCKER_HOST'],'--env-file',r.path(self.args.env_file),'--project',self.c['project'],'--daemon-id',daemon]
        if require_members:argv.append('--require-members')
        events=getattr(self,'_diagnostic_events',None)
        if events is None:return r.run(argv,env=env)
        return self.captured(argv,self._diagnostic_stage,events,env=env)

    def current_copy(self,directory):
        output=directory/'current.db'
        code='''import pathlib,sqlite3,hashlib,json
p=pathlib.Path('/state/forge.db');wal=p.with_name(p.name+'-wal');active=wal.exists() and wal.stat().st_size>0
source=sqlite3.connect(p.as_uri()+('?mode=ro' if active else '?mode=ro&immutable=1'),uri=True);target=sqlite3.connect('/out/current.db');source.backup(target);target.close();source.close()
p=pathlib.Path('/out/current.db');print(json.dumps({'sha256':hashlib.sha256(p.read_bytes()).hexdigest(),'size':p.stat().st_size}))
'''
        name=self.c['volumes']['ledger'];r.volume_identity(self.c,name,self.model())
        observed=json.loads(self.helper(code,mounts=[f'type=volume,src={name},dst=/state,readonly',f'type=bind,src={directory},dst=/out']))
        need(r.sha256(output)==observed['sha256'],'current-copy hash differs; retain stopped authority and retry the copy')
        return output,observed

    def ledger_backup(self,name):
        """A consistent copy of the current ledger, taken through a read-only mount, kept
        private in the upgrade snapshot. Never overwrites an earlier one."""
        destination=private_path(self.snapshot/name)
        need(not destination.exists(),f'{destination} already exists; an earlier backup is never overwritten')
        with tempfile.TemporaryDirectory(prefix='.ledger-backup-',dir=self.snapshot) as temporary:
            copy,observed=self.current_copy(Path(temporary))
            staged=Path(temporary)/'owned.db'
            with open(copy,'rb') as source,open(os.open(staged,os.O_WRONLY|os.O_CREAT|os.O_EXCL,0o600),'wb') as target:
                target.write(source.read());target.flush();os.fsync(target.fileno())
            os.link(staged,destination)
        need(r.sha256(destination)==observed['sha256'],'the ledger backup differs from what was read; keep the estate stopped and take it again')
        return {'path':str(destination),'sha256':observed['sha256'],'ledger_state':r.ledger_state(destination,consolidated=True),'logical_sha256':r.consolidated_logical_digest(destination)}

    def stop_supervisor(self,model):
        """Stop the sandbox supervisor first and require exit 0: run.sh exits 0 only once the
        work inside the sandbox has stopped (3 means that stop failed, run.sh:287, :381)."""
        if SUPERVISOR not in model.get('services',{}):return {'supervisor':'none in this estate'}
        item=self.service_ids((SUPERVISOR,)).get(SUPERVISOR)
        if item is None:return {'supervisor':'no container'}
        if item['State'].get('Running'):
            self.compose('stop','--timeout',str(SUPERVISOR_STOP_SECONDS),SUPERVISOR,timeout=SUPERVISOR_STOP_SECONDS+60)
        after=r.inspect(self.c,item['Id'])
        need(not after['State'].get('Running'),'sandbox-runner did not stop; nothing else was stopped. Read its log before retrying')
        code=after['State'].get('ExitCode')
        need(code==0,f'sandbox-runner exited {code}, not 0: its stop of the work inside the sandbox did not succeed, so nothing else was stopped. Read its log and stop the sandbox\'s work before retrying')
        return {'supervisor':item['Id'],'exit':code}

    def upgrade_close(self):
        self.markers()
        need(self.snapshot.is_dir() and not self.snapshot.is_symlink(),'the upgrade snapshot folder does not exist; the preparation step creates it')
        containers=self.project_containers()
        if self.receipt.exists():
            self.record()
            known=self.doc.setdefault('containers',{})
            for identifier,item in containers.items():known.setdefault(identifier,item)
            self.save()
        else:
            need(self.side=='from',f'an upgrade starts from release {self.upgrade["from"]["release"]}, the one running; close with its inventory')
            model=self.model()
            settings=self.settings_digests()
            # Only a file in the tools' own written form can be proved unchanged after
            # the planning switch rewrites it; refuse now rather than at --switch.
            need(settings['rewritten_sha256']==settings['sha256'],'the coordinator\'s settings file is not in the form the planning switch writes, so it could not be proved unchanged after --final turns planning off; nothing was stopped. Rewrite it through the planning switch first')
            sandbox=self.sandbox_hashes() if SUPERVISOR in model.get('services',{}) else None
            self.doc={'format_version':1,'kind':'upgrade','binding':self.binding,'created_at':now(),'release_at_close':self.release,
                      'containers':containers,'settings':{k:settings[k] for k in ('sha256','canonical_sha256','planning_enabled')},
                      'volumes':self.volume_record(),'sources':{side:self.side_hashes(side) for side in ('from','to')},
                      'sandbox':{self.release:sandbox} if sandbox else {},'stage':'recorded','observations':[]}
            self.save()
        self.watch_closed(stop=True);self.stop_current(PRODUCERS)
        self.doc['stage']='closed';self.doc['closed_phase']='prepared';self.save()
        return {'closed':True,'receipt':str(self.receipt),'recorded_containers':len(self.doc['containers']),'notice':'No session may run forge queue until this upgrade opens the door again.'}

    def upgrade_final(self):
        self.closed();need(self.doc['stage'] in ('settled','final'),'two quiet observations are missing; run --settle before stopping writers')
        model=self.model();supervisor=self.stop_supervisor(model)
        self.stop_current(SERVICES)
        attachments=r.docker(self.c,'ps','--filter','volume='+self.c['volumes']['ledger'],'--format','{{.ID}}').stdout.strip();need(not attachments,'a running container still attaches the current ledger; stop its explicit writer before proceeding')
        holders_before=self.current_holders();first=self.current_state();time.sleep(20);holders_after=self.current_holders();state=self.current_state();need(first==state,'current ledger changed after graph stop; find its remaining writer')
        self.doc['current_holder_proof']={'before':holders_before,'after':holders_after}
        need(not work_problems(state),'stopped record still contains active work; reconcile it without cancelling or discarding anything')
        count=self.monitor();quiet_counts(count)
        name='current-forge.db' if not (self.snapshot/'current-forge.db').exists() else 'current-forge-'+datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%S%fZ')+'.db'
        backup=self.ledger_backup(name)
        need(backup['logical_sha256']==state['logical_sha256'],'the ledger changed between the stillness proof and its backup; find the remaining writer')
        self.planning(False)
        final={'at':now(),'release':self.release,'state':state,'counts':count,'supervisor':supervisor,'backup':backup,'planning_enabled':False}
        self.doc['stage']='final';self.doc['final_phase']='prepared';self.doc['final']=final;self.doc.setdefault('finals',[]).append(final);self.save()
        return final

    def ledger_readers(self,baseline):
        """The three ledger readers agree, and see the baseline or exactly its start-up reconciliation."""
        code='import pathlib,json,sqlite3,hashlib\n'+inspect_source.getsource(r.logical_digest)+READER_CODE
        seen={}
        for service in LEDGER_READERS:
            item=self.service_ids((service,))[service]
            out=json.loads(self.recorded_docker('exec',item['Id'],'python','-c',code).stdout)
            need(out.get('schema_version')==self.entry['schema'],f'{service} reads a ledger at schema {out.get("schema_version")}, not release {self.release}\'s {self.entry["schema"]}; keep the door shut and reconcile')
            seen[service]={'container_id':item['Id'],'logical_sha256':out['logical_sha256']}
        digests={x['logical_sha256'] for x in seen.values()}
        need(len(digests)==1,'the three services observed different ledger states; keep the door shut and run --switch again once start-up has settled')
        digest=digests.pop()
        if digest==baseline['logical_sha256']:return {'services':seen,'reconciled':[]}
        import base64
        with tempfile.TemporaryDirectory(prefix='.switch-started-',dir=self.snapshot) as temporary:
            started=Path(temporary)/'started.db'
            # Not recorded: its output is the ledger itself.
            started.write_bytes(base64.b64decode(r.docker(self.c,'exec',seen['coordinator']['container_id'],'python','-c',r.STARTED_COPY_CODE).stdout));os.chmod(started,0o600)
            need(r.consolidated_logical_digest(started)==digest,'the started ledger changed between its reading and its copy; keep the door shut and run --switch again')
            changed=r.boot_reconciled_builds(baseline['path'],started)
        need(changed,'the started ledger differs from the recorded one without a reconciled build; keep the door shut and reconcile its state')
        return {'services':seen,'reconciled':changed}

    def start_supervisor(self,model):
        """Start sandbox-runner only on this release's own bootstrap, env and settings."""
        item=self.service_ids((SUPERVISOR,)).get(SUPERVISOR)
        facts=self.sandbox_facts()
        if not (item and item['State'].get('Running') and item['Image']==self.release_images(SUPERVISOR)):
            expected=self.expected_sandbox();actual=self.sandbox_hashes()
            for key,what in (('template_sha256','the clone\'s bootstrap'),('bootstrap_env_sha256','the bootstrap env file'),('settings_sha256','the sandbox settings file')):
                need(actual[key]==expected[key],f'{what} does not have the SHA-256 recorded for release {self.release}, so sandbox-runner was not started; install this release in the sandbox (or restore it) first. The rest is up with the door shut')
            self.compose('up','-d','--no-deps',SUPERVISOR)
            item=self.service_ids((SUPERVISOR,))[SUPERVISOR]
        restarts=item.get('RestartCount');deadline=time.monotonic()+SANDBOX_START_WAIT_SECONDS
        wanted={facts['prefix']+'-helper',facts['prefix']+'-runner'}
        while True:
            now_item=r.inspect(self.c,item['Id'])
            need(now_item['State'].get('Running') and now_item.get('RestartCount')==restarts,'sandbox-runner stopped or restarted while its sandbox services were starting; read its log. The door stays shut')
            names={x for x in self.sbx('exec',facts['name'],'docker','ps','--format','{{.Names}}').stdout.split() if x.startswith(facts['prefix']+'-')}
            if names==wanted or time.monotonic()>=deadline:break
            time.sleep(READY_POLL_SECONDS)
        need(names==wanted,f'inside the sandbox, the running {facts["prefix"]}- containers are {sorted(names)}, not exactly the helper and the runner; the door stays shut')
        need(facts['image'] and not facts['image'].startswith('-'),'the bootstrap env names no FORGE_IMAGE; the sandbox services\' image cannot be checked')
        image=self.sbx('exec',facts['name'],'docker','image','inspect','--format','{{.Id}} {{index .Config.Labels "com.guardkit.release.version"}}',facts['image']).stdout.split()
        need(len(image)==2 and image[1]==self.release,f'inside the sandbox, the image the bootstrap names is not release {self.release}\'s; the door stays shut')
        running=self.sbx('exec',facts['name'],'docker','inspect','--format','{{.Name}} {{.Image}}',*sorted(wanted)).stdout.split()
        need(running==[x for name in sorted(wanted) for x in ('/'+name,image[0])],f'inside the sandbox, the helper and runner do not both run release {self.release}\'s image; the door stays shut')
        return {'supervisor':item['Id'],'restarts':restarts,'inside':sorted(wanted),'image':image[0]}

    def switch(self):
        """Bring this inventory's release up with the door shut and planning off (TC2)."""
        need(self.upgrade,'--switch belongs to an upgrade inventory; this one has no upgrade block')
        self.markers();self.record()
        if self.side=='to':need(self.doc.get('stage')=='final',f'release {self.release} is brought up only after --final stopped release {self.upgrade["from"]["release"]}; run --final with that inventory first')
        else:need(self.doc.get('stage') in ('closed','settled','final'),'the door is not recorded shut; run --close first')
        result={'format_version':1,'release':self.release,'started_at':now(),'passed':False,'commands':[]}
        destination=private_path(self.snapshot/('switched-'+self.release+'.json'))
        self._diagnostic_events=result['commands'];self._diagnostic_stage='switch-preflight'
        try:
            self.switch_steps(result);result['passed']=True
        except Exception as exc:
            result['failure']={'stage':self._diagnostic_stage,'reason':self.sanitize(str(exc))};raise
        finally:
            self._diagnostic_events=None;result['finished_at']=now();r.atomic_json(destination,result)
            self.doc.setdefault('switches',[]).append({k:result.get(k) for k in ('release','started_at','finished_at','passed','bus_ready')});self.save()
        return result

    def switch_steps(self,result):
        def stage(name):self._diagnostic_stage=name
        since=datetime.now(timezone.utc)
        stage('door-shut');self.watch_closed();self.producers_stopped()
        stage('render');model=self.model();self.check_release_images(model)
        policy=load_script('publisher-host-policy')
        policy.validate_declared(model,policy.binding(self.c['project']),r.path(self.values['FORGE_PUBLISHER_SETTINGS_FILE']))
        # Checked before anything starts, and again after the tools' own write below.
        stage('settings-invariant');self.settings_invariant()
        stage('settings-load');self.load_settings()
        stage('policy-verify');self.policy_verify(require_members=False)
        stage('baseline')
        if self.doc.get('stage')=='final':baseline=self.doc['final']['backup']
        else:baseline=self.ledger_backup('switch-start-'+self.release+'-'+since.strftime('%Y%m%dT%H%M%S%fZ')+'.db')
        result['baseline']={k:baseline[k] for k in ('path','sha256','logical_sha256')}
        stage('remove-other-release')
        recorded=self.doc.get('containers',{});removed=[]
        for identifier,item in self.project_containers().items():
            expected=self.release_images(item['service'])
            if expected is None or item['image']==expected:continue
            live=r.inspect(self.c,identifier)
            need(not live['State'].get('Running'),f'{item["service"]} is running on another release\'s image; to leave a release that is running, use rollout-back --upgrade-back. Nothing was started')
            need(identifier in recorded,f'{item["service"]} container {identifier[:12]} is on another release and was not recorded at --close; leave it and reconcile. Nothing was started')
            r.docker(self.c,'rm',identifier);removed.append(identifier)
        result['removed']=removed
        stage('bus-ready');ready=self.run_bus_ready(since);result['bus_ready']={k:ready[k] for k in ('id','started_at','finished_at')}
        stage('closed-door-start');items=self.closed_door_items(model)
        starting=[s for s in LONG_RUNNING if s in model['services'] and s not in ('coordinator',SUPERVISOR) and not (items.get(s) and items[s]['State'].get('Running') and items[s]['Image']==self.release_images(s))]
        # The coordinator is created by the forced recreation below, after planning is
        # written off, so it never starts on this release with planning on.
        if starting:self.compose('up','-d','--no-deps',*starting)
        result['started']=starting
        stage('planning-off');self.planning(False);written=datetime.now(timezone.utc)
        stage('coordinator-recreate');self.compose('up','-d','--no-deps','--force-recreate','coordinator')
        coordinator=self.service_ids(('coordinator',))['coordinator']
        need(coordinator['State'].get('Running') and coordinator['Image']==self.entry['runtime'] and docker_time(coordinator['State'].get('StartedAt'))>written,'the coordinator was not started on this release after planning was written off; the door stays shut')
        result['coordinator']={'id':coordinator['Id'],'started_at':coordinator['State'].get('StartedAt'),'planning_written_at':written.isoformat()}
        stage('settings-invariant-after');self.settings_invariant()
