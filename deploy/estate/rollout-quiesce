def gateway_connections(doc, account, name, subject):
    """Count the bus gateway's OWN connections in a connz answer: the account AND
    the client name AND the subscription on one connection, as estate-check item
    8i asks, because the front door shares the account."""
    def subjects(connection):
        return connection.get('subscriptions_list') or [x.get('subject') for x in connection.get('subscriptions_list_detail') or []]
    return sum(1 for connection in doc.get('connections') or []
               if connection.get('authorized_user')==account and (connection.get('name') or '')==name and subject in subjects(connection))

def marker_file(value):
    """Physical absence is different from any present, malformed artifact."""
    import os, json, pathlib, stat
    p=pathlib.Path(value)
    try:before=p.lstat()
    except FileNotFoundError:return {'present':False}
    if not stat.S_ISREG(before.st_mode) or before.st_nlink!=1 or before.st_uid!=os.geteuid() or stat.S_IMODE(before.st_mode)!=0o600:
        raise ValueError('resume marker is not a private owned unaliased regular file')
    fd=os.open(p,os.O_RDONLY|os.O_NOFOLLOW)
    with os.fdopen(fd) as f:
        opened=os.fstat(f.fileno())
        if (opened.st_dev,opened.st_ino)!=(before.st_dev,before.st_ino):raise ValueError('resume marker identity changed')
        value=json.load(f)
    after=p.lstat()
    if (before.st_dev,before.st_ino,before.st_size,before.st_mtime_ns,before.st_nlink)!=(after.st_dev,after.st_ino,after.st_size,after.st_mtime_ns,after.st_nlink):raise ValueError('resume marker changed during read')
    if not isinstance(value,dict):raise ValueError('present resume marker is not an object')
    return {'present':True,'value':value}

def ledger_lease_proof(root):
    """Prove no open DB/WAL/SHM description without inspecting any process."""
    import ctypes, errno, fcntl, os, pathlib, signal, stat
    root=pathlib.Path(root);names=('forge.db','forge.db-wal','forge.db-shm')
    class Failure(Exception):
        def __init__(self,kind,reason,number=None):self.kind=kind;self.reason=reason;self.number=number
    class StatFS(ctypes.Structure):
        _fields_=[('f_type',ctypes.c_long),('f_bsize',ctypes.c_long),('f_blocks',ctypes.c_ulong),('f_bfree',ctypes.c_ulong),('f_bavail',ctypes.c_ulong),('f_files',ctypes.c_ulong),('f_ffree',ctypes.c_ulong),('f_fsid',ctypes.c_int*2),('f_namelen',ctypes.c_long),('f_frsize',ctypes.c_long),('f_flags',ctypes.c_long),('f_spare',ctypes.c_long*4)]
    allowed={0xEF53:'ext',0x58465342:'xfs',0x9123683E:'btrfs'};rootfd=None;root_identity=None
    def filesystem(fd):
        item=StatFS();libc=ctypes.CDLL(None,use_errno=True)
        if libc.fstatfs(fd,ctypes.byref(item)):
            number=ctypes.get_errno();raise Failure('unknown','filesystem identity is unreadable',number)
        magic=item.f_type & ((1 << (ctypes.sizeof(ctypes.c_long)*8))-1)
        if magic not in allowed:raise Failure('unsupported','ledger filesystem is not an allowlisted host-local type')
        return {'name':allowed[magic],'magic':hex(magic)}
    def identity(item):
        return [item.st_dev,item.st_ino,item.st_size,item.st_mtime_ns,stat.S_IMODE(item.st_mode),item.st_uid,item.st_gid]
    def identities():
        base=os.fstat(rootfd)
        if identity(base)!=root_identity:raise Failure('identity','ledger volume root identity changed')
        result={}
        for name in names:
            try:item=os.stat(name,dir_fd=rootfd,follow_symlinks=False)
            except FileNotFoundError:
                if name=='forge.db':raise Failure('identity','current ledger is absent')
                continue
            if (not stat.S_ISREG(item.st_mode) or item.st_nlink!=1 or item.st_dev!=base.st_dev
                    or item.st_uid!=os.geteuid() or item.st_gid!=os.getegid()
                    or stat.S_IMODE(item.st_mode) not in (0o600,0o644)):
                raise Failure('identity','current ledger file identity, ownership, mode or filesystem is unsafe')
            result[name]=identity(item)
        return result
    leases=[];descriptors=[];cleanup=[];oldmask=None;result={'format_version':1,'complete':False,'cleanup_complete':False}
    try:
        for constant in ('F_SETLEASE','F_GETLEASE','F_SETOWN'):
            if not hasattr(fcntl,constant):raise Failure('unsupported','required Linux lease operation is unavailable')
        oldmask=signal.pthread_sigmask(signal.SIG_BLOCK,{signal.SIGIO})
        before=root.lstat()
        if not stat.S_ISDIR(before.st_mode) or before.st_uid!=os.geteuid() or before.st_gid!=os.getegid() or stat.S_IMODE(before.st_mode)!=0o755:
            raise Failure('identity','ledger volume root is not the exact owned mode-0755 directory')
        rootfd=os.open(root,os.O_RDONLY|os.O_DIRECTORY|os.O_NOFOLLOW|os.O_NONBLOCK);descriptors.append(rootfd)
        opened_root=os.fstat(rootfd);root_identity=identity(opened_root)
        if root_identity!=identity(before):raise Failure('identity','ledger volume root changed while it was opened')
        fs=filesystem(rootfd);initial=identities();result.update(files=initial,filesystem=fs)
        for name in sorted(initial):
            try:fd=os.open(name,os.O_RDONLY|os.O_NOFOLLOW|os.O_NONBLOCK,dir_fd=rootfd)
            except OSError as e:
                raise Failure('holder' if e.errno==errno.EAGAIN else 'unknown','ledger open conflicts with an existing lease' if e.errno==errno.EAGAIN else 'ledger cannot be opened safely',e.errno)
            descriptors.append(fd);opened=os.fstat(fd)
            if identity(opened)!=initial[name] or filesystem(fd)!=fs:
                raise Failure('identity','ledger identity or filesystem changed while it was opened')
            try:
                fcntl.fcntl(fd,fcntl.F_SETOWN,os.getpid())
                if hasattr(fcntl,'F_SETSIG'):fcntl.fcntl(fd,fcntl.F_SETSIG,signal.SIGIO)
                fcntl.fcntl(fd,fcntl.F_SETLEASE,fcntl.F_WRLCK)
            except OSError as e:
                raise Failure('holder' if e.errno==errno.EAGAIN else 'unknown','ledger has an open holder' if e.errno==errno.EAGAIN else 'exclusive ledger lease is unavailable',e.errno)
            leases.append(fd)
        if identities()!=initial or identity(root.lstat())!=root_identity:
            raise Failure('identity','ledger presence or identity changed during lease acquisition')
        if signal.SIGIO in signal.sigpending():raise Failure('break','a new ledger open raced with holder proof')
        if any(fcntl.fcntl(fd,fcntl.F_GETLEASE)!=fcntl.F_WRLCK for fd in leases):
            raise Failure('break','a ledger lease break is pending')
        result.update(complete=True,kind='clean',reason='every present owned local ledger inode was exclusively leased and stable')
    except Failure as e:
        result.update(complete=False,kind=e.kind,reason=e.reason)
        if e.number is not None:result['errno']=e.number
    except BaseException:
        result.update(complete=False,kind='unknown',reason='unexpected lease proof failure')
    finally:
        for fd in reversed(leases):
            try:fcntl.fcntl(fd,fcntl.F_SETLEASE,fcntl.F_UNLCK)
            except BaseException:cleanup.append('lease release failed')
        for fd in reversed(descriptors):
            try:os.close(fd)
            except BaseException:cleanup.append('descriptor close failed')
        if oldmask is not None:
            try:
                if signal.SIGIO in signal.sigpending():result.update(complete=False,kind='break',reason='a ledger lease break signal is pending')
                while signal.SIGIO in signal.sigpending():signal.sigtimedwait({signal.SIGIO},0)
                signal.pthread_sigmask(signal.SIG_SETMASK,oldmask)
            except BaseException:cleanup.append('signal cleanup failed')
        if cleanup:result.update(complete=False,kind='unknown',reason='lease proof cleanup is uncertain',cleanup_errors=cleanup)
        result['cleanup_complete']=not cleanup
    return result

class Estate:
    def __init__(self,args,config=None):
        # config: an already-read inventory, for rollout-back's derived view of the
        # other release in an upgrade; normally the file --config names.
        self.args=args;self.config_path=r.path(args.config);self.c=r.read_json(self.config_path) if config is None else config
        self.upgrade=self.c.get('upgrade')
        if self.upgrade is not None:
            self.upgrade_inputs(args);return
        self.q=self.c['quiesce'];self.snapshot=r.path(args.snapshot,exists=False)
        need(re.fullmatch(r'\d{8}T\d{6}Z(?:-[A-Za-z0-9_-]+)?',self.snapshot.name),'snapshot is not a dated path; name its exact future or existing directory')
        need(self.snapshot.parent==r.path(self.c['snapshot_root']),'snapshot is outside the declared root; select its dated child')
        need(args.project==self.c['project'] and args.env_file==self.c['env_file'],'explicit env or project conflicts with inventory; select the intended phase inventory')
        need(re.fullmatch(r'[a-z0-9][a-z0-9_-]+',args.project) and self.c['runtime_image']==r.release(self.c)[1]['runtime'],'estate project or runtime identity is invalid; use the accepted explicit release')
        need(set(self.c['volumes'])==r.VOLUME_ROLES and len(set(self.c['volumes'].values()))==5,'five distinct state volumes are required; correct the explicit inventory')
        need(set(self.c['units'])==r.UNIT_ROLES and set(self.c['old_containers'])=={'coordinator','memory','relay'} and len(set(self.c['units'].values()))==len(r.UNIT_ROLES) and len(set(self.c['old_containers'].values()))==3,'legacy identities are incomplete or repeated; name exactly the distinct recorded units and three containers')
        need(all(re.fullmatch('[a-zA-Z0-9][a-zA-Z0-9_.-]+',name) for name in self.c['volumes'].values()),'state volume name is invalid; use five explicit named volumes')
        self.receipt=private_path(self.q['receipt'])
        self.sandbox_evidence=private_path(self.receipt.with_name(self.receipt.name+'.rollout-sandbox-command.json'))
        old_root=Path(self.c['source_db']).parent
        need(old_root!=self.receipt and old_root not in self.receipt.parents,'close receipt lies in the old ledger folder; choose external private evidence storage')
        need(self.snapshot!=self.receipt and self.snapshot not in self.receipt.parents,'close receipt lies inside the future snapshot; select a private external receipt path')
        paths=[self.config_path,self.snapshot,*[Path(v) for v in self.c['sources'].values()],Path(self.c['source_db'])]
        paths += [Path(self.q[k]) for k in ('original_env_file','original_settings','prepared_env_file','prepared_settings','settings_receipt')]
        paths += [Path(x) for x in args.secret_env_file]
        for p in paths:
            # Phase-independent binding is lexical: after resume even stat() of
            # the old folder is forbidden. Existing output aliases are excluded
            # by private_path's single-link rule; new outputs cannot be aliases.
