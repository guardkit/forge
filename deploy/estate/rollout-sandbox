class Refusal(Exception):
    pass


def require(condition, message):
    if not condition:
        raise Refusal(message)


def digest(data):
    return hashlib.sha256(data).hexdigest()


def sandbox_publish_address(values, gateway):
    if 'SANDBOX_PUBLISH_ADDRESS' not in values:
        return gateway
    value = values['SANDBOX_PUBLISH_ADDRESS']
    if not re.fullmatch(r'(?:0|[1-9][0-9]{0,2})(?:\.(?:0|[1-9][0-9]{0,2})){3}',value):
        raise Refusal('SANDBOX_PUBLISH_ADDRESS must be a canonical dotted-decimal IPv4 literal')
    try:
        address = ipaddress.IPv4Address(value)
    except ipaddress.AddressValueError:
        raise Refusal('SANDBOX_PUBLISH_ADDRESS must be a canonical dotted-decimal IPv4 literal') from None
    require(not (address.is_unspecified or address.is_loopback or address.is_multicast or value == '255.255.255.255'),
            'SANDBOX_PUBLISH_ADDRESS cannot be unspecified, loopback, multicast or limited broadcast')
    return value


def json_read(path):
    return json.loads(Path(path).read_text())


def private_write(path, data, mode=0o600):
    path = Path(path)
    require(not path.is_symlink(), f'{path} is a symlink; choose a private regular file')
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    fd, temp = tempfile.mkstemp(prefix='.rollout-', dir=path.parent)
    try:
        with os.fdopen(fd, 'wb') as stream:
            stream.write(data)
            stream.flush()
            os.fsync(stream.fileno())
        os.chmod(temp, mode)
        os.replace(temp, path)
        fd = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY)
        try:
            os.fsync(fd)
        finally:
            os.close(fd)
    finally:
        if os.path.exists(temp):
            os.unlink(temp)


def load_env(path, secret_paths=()):
    """Expand only explicit ${NAME} references; never consult a shell/env."""
    raw = {}
    for source in (path, *secret_paths):
        source = Path(source)
        if source != Path(path):
            require(source.is_file() and not source.is_symlink() and source.stat().st_mode & 0o077 == 0,
                    f'secret env file {source} is not private; use a regular mode-0600 file')
        for line in source.read_text().splitlines():
            line = line.strip()
            if not line or line.startswith('#'):
                continue
            key, sep, value = line.partition('=')
            require(sep and re.fullmatch(r'[A-Z_][A-Z0-9_]*', key) and key not in raw,
                    f'env file {source} contains a malformed or duplicate name; fix that line')
            if len(value) >= 2 and value[0] == value[-1] and value[0] in "\"'":
                value = value[1:-1]
            require(not any(token in value for token in ('$(', '`', '\x00', '\n', '\r')),
                    f'env file {source} contains executable text; provide literal values or named references')
            raw[key] = value
    resolved = {}
    visiting = set()
    pattern = re.compile(r'\$\{([A-Z_][A-Z0-9_]*)\}')

    def resolve(name):
        require(name in raw, f'env name {name} is unset in the explicit files; supply its value there')
        require(name not in visiting, f'env name {name} has a cyclic reference; fix the explicit files')
        if name in resolved:
            return resolved[name]
        require(len(visiting) < 64, 'env reference nesting exceeds 64 names; simplify the explicit files')
        visiting.add(name)
        value = raw[name]
        require('${' not in pattern.sub('', value), f'env name {name} contains an unsupported reference; use only ${{NAME}}')
        value = pattern.sub(lambda match: resolve(match[1]), value)
        visiting.remove(name)
        resolved[name] = value
        return value

    for name in raw:
        resolve(name)
    return resolved


