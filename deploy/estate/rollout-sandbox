            require(isinstance(value, str) and PurePosixPath(value).is_absolute() and '..' not in PurePosixPath(value).parts,
                    f'sandbox.{name} is not an absolute path; name its exact location')
        clone = PurePosixPath(s['clone_path'])
        for name in ('script_path', 'profile_path'):
            require(PurePosixPath(s[name]).is_relative_to(clone), f'{name} is outside the private clone; fix the inventory')
        require(s['script_path'] != s['profile_path'], 'script and profile paths overlap; fix the inventory')
        require(isinstance(s['known_files'], list) and s['known_files'], 'known_files is empty; name the disk witnesses')
        for name in s['known_files']:
            require(isinstance(name, str) and name and not PurePosixPath(name).is_absolute() and '..' not in PurePosixPath(name).parts,
                    'known_files contains an unsafe path; name relative files in the private clone')
        require(isinstance(s['legacy_command_markers'], list) and s['legacy_command_markers'] and all(isinstance(x,str) and x for x in s['legacy_command_markers']),
                'legacy command markers are absent; name the old bootstrap and both services')
        require(re.fullmatch(r'[A-Za-z0-9_./-]+', s['remote_ref']) and not s['remote_ref'].startswith('-'), 'remote_ref is invalid; name the local remote tracking ref')
        require(re.fullmatch(r'[A-Za-z0-9_-]+',s['remote_name']), 'remote_name is invalid; name the registered Git remote')
        require(isinstance(s['declared_remote'],str) and s['declared_remote'] and not any(x in s['declared_remote'] for x in ('\n','\r','\x00')), 'declared_remote is missing; name the registered remote')
        require(isinstance(s['declaration_files'],list) and s['declaration_files'] and all(isinstance(x,str) and x and not PurePosixPath(x).is_absolute() and '..' not in PurePosixPath(x).parts for x in s['declaration_files']), 'declaration_files is empty or unsafe; name the project declarations at the registered ref')
        require(re.fullmatch(r'[a-zA-Z0-9][a-zA-Z0-9_./:@-]*',s['release_image']) and ':' in s['release_image'] and not s['release_image'].startswith('sha256:'), 'release_image must name the transferable release tag; supply its explicit reference')
        require(s['expected_sbx_version'] == 'v0.42.1', 'sandbox client semantics are unverified; use the reviewed v0.42.1 client')
        self.units = {key:c['units'][key] for key in ('keeper','runner')}
        require(len(set(self.units.values())) == 2 and all(re.fullmatch(r'[A-Za-z0-9_.@-]+\.service', v) and not v.startswith('-') for v in self.units.values()), 'unit names are invalid; name distinct keeper and runner services')
        self.dropin = Path(s['systemd_user_dir']) / (self.units['runner'] + '.d') / 'zzzz-rollout-empty-stop.conf'
        for path in s['legacy_dropins']:
            require(Path(path).parent == self.dropin.parent and Path(path).suffix == '.conf' and Path(path) != self.dropin,
                    'legacy drop-in is outside the exact runner unit; fix the inventory')
        require(isinstance(s['forbidden_values'], list) and all(isinstance(x,str) and x for x in s['forbidden_values']), 'forbidden_values must list machine values to sweep; fix the inventory')
        gateway = self.values.get('FACTORY_GATEWAY_ADDRESS','')
        try:
            address = ipaddress.ip_address(gateway)
        except ValueError:
            raise Refusal('FACTORY_GATEWAY_ADDRESS is missing or not an IP address; name the sandbox boundary address in the env file') from None
        require(address.version == 4 and not address.is_loopback and not address.is_unspecified,
                'gateway address is loopback or unspecified; name the sandbox boundary address')
        for key in ('FORGE_TARGET_OWNER_URL','FORGE_SANDBOX_SIDECAR_URL','FORGE_SANDBOX_RUNNER_URL'):
            u = urlsplit(self.values[key])
            require(u.scheme in ('http','https') and u.hostname == gateway and u.port and not u.username and not u.password and u.path in (('','/','/recorded') if key == 'FORGE_TARGET_OWNER_URL' else ('','/')) and not u.query and not u.fragment,
                    f'{key} does not use the gateway with an explicit port; fix the env route')
        owner = urlsplit(self.values['FORGE_TARGET_OWNER_URL'])
        self.answer = f'{gateway}:{owner.port}'
        # Same published port compose.yaml binds at the gateway for the memory MCP.
        memory_port = self.values.get('FLEET_MEMORY_PORT','')
        require(re.fullmatch(r'[1-9][0-9]{0,4}',memory_port) and int(memory_port) < 65536,
                'FLEET_MEMORY_PORT is missing or not a port number; name the memory MCP gateway publish port in the env file')
        self.memory_mcp = f'{gateway}:{int(memory_port)}'
        require(self.memory_mcp != self.answer, 'FLEET_MEMORY_PORT equals the answer-service port; give the memory MCP its own gateway port')
        require(isinstance(s.get('allow_replacements',{}),dict), 'allow_replacements must map old rules to env names; fix the inventory')
        for old, name in s.get('allow_replacements',{}).items():
            require(isinstance(old,str) and isinstance(name,str) and re.fullmatch(r'[A-Z_][A-Z0-9_]*',name), 'allow replacement must name an env variable; fix the inventory')
            rule = self.values[name]
            host, sep, port = rule.partition(':')
            require(host == gateway and sep and port.isdigit() and 0 < int(port) < 65536, f'{name} is not an exact gateway host:port rule; fix its route')
        require(self.values.get('FLEET_MEMORY_ENABLED') in ('true','false'), 'FLEET_MEMORY_ENABLED is missing; explicitly choose true or false')
        require(all(name in TEMPLATE.read_text() for name in MEMORY_NAMES) and '\n  stop)' in TEMPLATE.read_text(), 'current template lacks the stop or memory contract; repair the bundle first')
        self.template = TEMPLATE.read_bytes()
        require(not Path(s['profile_source']).is_symlink(), 'profile_source is a symlink; use the exact producer profile file')
        self.source = Path(s['profile_source']).read_text()
        # Preserve only transport identity, never tool-control or route overrides.
        self.env = {'PATH':'/usr/local/bin:/usr/bin:/bin','LANG':'C.UTF-8'}
        for key in ('HOME','USER','XDG_RUNTIME_DIR','DBUS_SESSION_BUS_ADDRESS'):
            if key in os.environ:
                self.env[key] = os.environ[key]
        self.env['DOCKER_CONTEXT'] = c['docker_context']
        self.bootstrap_env = Path(s['bootstrap_env_file'])
        require(self.values.get('SANDBOX_PROJECT_ENV_FILE') == str(self.bootstrap_env), 'SANDBOX_PROJECT_ENV_FILE does not name sandbox.bootstrap_env_file; bind the existing Compose runner to that explicit private output')
        require(self.values.get('SANDBOX_NAME') == s['name'] and self.values.get('SANDBOX_BOOTSTRAP') == s['script_path'], 'normal Compose runner sandbox/bootstrap differs from this inventory; fix its explicit env inputs')
        self.forwarded_names = self.values.get('SANDBOX_ENV_NAMES','').replace(',',' ').split()
        mandatory = {'FORGE_IMAGE','FORGE_IMAGE_IDENTITY','FORGE_RELEASE_VERSION','FORGE_RELEASE_MANIFEST_SHA256','FORGE_TARGET_OWNER_URL',*MEMORY_NAMES}
        require(set(self.forwarded_names) >= mandatory and all(re.fullmatch(r'[A-Z_][A-Z0-9_]*',x) for x in self.forwarded_names), 'SANDBOX_ENV_NAMES lacks required image, answer or memory names; fix the normal runner declaration')
        # run.sh forwards only nonempty declared names. Match the template's
        # receipt precedence at this boundary, not merely the rewritten profile.
        self.forwarded_values = {name:self.values[name] for name in self.forwarded_names if self.values.get(name)}
        effective_receipts = (self.forwarded_values.get('FORGE_RECEIPTS_DIR')
                              or self.forwarded_values.get('SANDBOX_RECEIPTS_PATH'))
        require(effective_receipts == s['receipts_path'], 'effective forwarded receipts path differs from sandbox.receipts_path or is missing; declare and forward the matching receipt setting before stopping the sandbox')
        if self.values['FLEET_MEMORY_ENABLED'] == 'true':
            require(all(self.values.get(name) for name in MEMORY_NAMES), 'enabled memory lacks explicit private values; supply all seven names through the named files')
        self.validate_settings_inputs()
        self.evidence = Path(s['evidence_dir'])
        forbidden = [ROOT.resolve(),Path(s['profile_source']).resolve().parent]
        forbidden += [Path(x).resolve() for x in c['forbidden_roots']]
        require(not any(self.bootstrap_env.resolve().is_relative_to(root) for root in forbidden) and not self.bootstrap_env.resolve().is_relative_to(self.evidence.resolve()) and self.bootstrap_env.resolve() not in {Path(args.env_file).resolve(),Path(args.config).resolve(),*[Path(x).resolve() for x in args.secret_env_file]}, 'bootstrap_env_file overlaps source, evidence or input files; choose a separate private operational path')
        require(not any(self.evidence.resolve().is_relative_to(root) for root in forbidden),
                'evidence_dir is inside a source checkout; choose a private external directory')
        require(not self.evidence.is_symlink() and (not self.evidence.exists() or self.evidence.stat().st_mode & 0o077 == 0),
                'evidence_dir is not private; create it with mode 0700 outside source checkouts')
        self.events = []
        self.stop_proved = False
        self.replacement_started = False
        self.complete = False

    def validate_settings_inputs(self):
        """The sandbox settings file's inventory keys (release -3 TC5)."""
        s = self.s
        path = s.get('settings_path')
        require(isinstance(path,str) and PurePosixPath(path).is_absolute() and '..' not in PurePosixPath(path).parts and len(PurePosixPath(path).parts) > 2 and PurePosixPath(path).name.endswith(('.yaml','.yml')),
                'sandbox.settings_path is not an absolute .yaml file path; name the sandbox settings file explicitly')
        self.settings_path = PurePosixPath(path)
        require('.forge-runner' not in self.settings_path.parts,
                "sandbox.settings_path is inside the template's own state folders (~/.forge-runner/<hash>/, its lock, process record and launch declaration); choose a path outside them")
        # Outside the clone and every shared folder: no build's read-write
        # mount, git clean or scratch tool may reach it.
        shared = {'sandbox.clone_path':s['clone_path'],'sandbox.receipts_path':s['receipts_path']}
        shared.update({name:value for name,value in self.forwarded_values.items()
                       if name != 'FORGE_CONFIG_PATH' and value.startswith('/') and not any(c in value for c in ' :,')})
        shared['the template state folders (~/.forge-runner)'] = '~/.forge-runner'
        self.excluded_roots = shared
        for name, folder in shared.items():
            if folder.startswith('~'):
                continue
            require(not self.settings_path.is_relative_to(PurePosixPath(folder)) and not PurePosixPath(folder).is_relative_to(self.settings_path),
                    f'sandbox.settings_path is inside {name}, a folder the sandbox shares or builds write; choose a path on the sandbox root filesystem outside the clone and every shared folder')
        keys = s.get('repo_keys')
        require(isinstance(keys,list) and keys and len(set(keys)) == len(keys) and all(isinstance(x,str) and re.fullmatch(r'[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+',x) for x in keys),
                'sandbox.repo_keys must list distinct org/name repository keys; name the repositories this sandbox builds')
        floor = s.get('worktree_disk_floor_gb')
        require(isinstance(floor,(int,float)) and not isinstance(floor,bool) and floor > 0,
                'sandbox.worktree_disk_floor_gb must be a positive number of GiB; name the worktree disk floor')
        volume = self.config.get('volumes',{}).get('settings') if isinstance(self.config.get('volumes'),dict) else None
        require(isinstance(volume,str) and re.fullmatch(r'[a-zA-Z0-9][a-zA-Z0-9_.-]+',volume),
                "volumes.settings does not name the coordinator's settings volume; name it in the private inventory")
        self.settings_volume = volume
        require('FORGE_CONFIG_PATH' in self.forwarded_names,
                'FORGE_CONFIG_PATH is not in SANDBOX_ENV_NAMES, so the sandbox services would never be told where their settings file is; add the name')
        require(self.values.get('FORGE_CONFIG_PATH','') in ('',str(self.settings_path)),
                'FORGE_CONFIG_PATH in the env file names another file than sandbox.settings_path; leave it unset or name the same file')

    def sandbox_settings(self):
        """Generate and validate the sandbox settings file; changes nothing."""
        context = self.config['docker_context']
        try:
            listing = json.loads(self.run(['docker','--context',context,'volume','inspect',self.settings_volume]).stdout)
        except ValueError:
            listing = None
        require(isinstance(listing,list) and len(listing) == 1 and listing[0].get('Name') == self.settings_volume
                and (listing[0].get('Labels') or {}).get('com.docker.compose.project') == self.args.project,
                f"the coordinator's settings volume {self.settings_volume} is missing or not this project's; name the estate's own settings volume")
        payload = {'repo_keys':self.s['repo_keys'],'sandbox':self.s['name'],'clone_path':self.s['clone_path'],'floor':self.s['worktree_disk_floor_gb']}
        out = self.run(['docker','--context',context,'run','--rm','--pull=never','--network=none','--read-only',
                        '--tmpfs','/tmp:rw,noexec,nosuid','--user','0:0','--cap-drop','ALL','--cap-add','DAC_OVERRIDE',
                        '--security-opt','no-new-privileges',
                        '--mount',f'type=volume,src={self.settings_volume},dst=/coordinator-settings,readonly',
                        '-i','--entrypoint','python',self.config['runtime_image'],'-c',SETTINGS,'/coordinator-settings/forge.yaml'],
                       input=json.dumps(payload)).stdout
        result = json.loads(out)
        require('unmapped' not in result,
                "sandbox.repo_keys names repositories the coordinator's planning.sandboxes does not give to "+self.s['name']+': '+', '.join(result.get('unmapped',[]))+'; name only this sandbox\'s repositories')
        text = result['text']
        require(isinstance(text,str) and '${' not in text, 'generated sandbox settings still hold a ${NAME}; the file would not load in the sandbox')
        result['sha256'] = digest(text.encode())
        return result

    def settings_item(self, text, real_parent=None):
        # The excluded roots travel with the item: the install step resolves
        # them inside the sandbox and refuses an overlap at write time too.
        return {'path':str(self.settings_path),'root':str(self.settings_path.parent),'data':base64.b64encode(text.encode()).decode(),'mode':0o644,'parent_mode':0o755,
                'excluded':sorted(set(self.excluded_roots.values())),'real_parent':real_parent}

    def run(self, argv, *, input=None, check=True, timeout=120, env=None):
        deadline = getattr(self,'deadline',None)
        if deadline is not None:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                raise Refusal(f'the upgrade reached its own time limit of {UPGRADE_LIMIT_SECONDS} seconds before {Path(argv[0]).name} could run; nothing more was started, so read its evidence for where it stopped')
            timeout = min(timeout, remaining)
        try:
            result = subprocess.run(argv, input=input, text=True, capture_output=True,
                                    env=env or self.env, timeout=timeout)
        except (OSError, subprocess.TimeoutExpired):
            raise Refusal(f'{Path(argv[0]).name} did not answer for {self.s["name"]}; keep units masked and inspect it before retrying') from None
        # Retain the actual CLI boundary, hashing embedded code/inventory rather
        # than copying payloads, output or environment values into diagnostics.
        recorded = list(argv)
        if '-c' in recorded:
            start = recorded.index('-c') + 1
            recorded[start:] = ['<payload-sha256:'+digest(value.encode())+'>' for value in recorded[start:]]
        self.events.append({'argv':recorded,'exit':result.returncode})
        if check and result.returncode:
            raise Refusal(f'{Path(argv[0]).name} refused for {self.s["name"]}; keep units masked and inspect it before retrying')
        return result

    def sbx(self, *argv, **kw):
        return self.run(['sbx',*argv], **kw)

    def inside(self, *argv, **kw):
        return self.sbx('exec',*(['-i'] if kw.get('input') is not None else []),self.s['name'],*argv,**kw)

    def save(self, name, value):
        private_write(self.evidence / name, (json.dumps(value,sort_keys=True,indent=2)+'\n').encode())

    def systemctl(self, *args, **kw):
        operation = args[0] if args else 'operation'
        unit = args[1] if len(args) > 1 and args[1] in self.units.values() else None
        try:
            return self.run(['systemctl','--user',*args], **kw)
        except Refusal as exc:
            outcome = 'did not answer' if 'did not answer' in str(exc) else 'refused'
            target = f' for unit {unit}' if unit else ''
            raise Refusal(f'systemctl {operation} {outcome}{target} in sandbox {self.s["name"]}; keep units masked and inspect it before retrying') from None

    def properties(self, unit, *, identity=False):
        fields = ('LoadState','ActiveState','SubState','MainPID','ControlPID','UnitFileState')
        if identity:
            fields += ('Id',)
        out = self.systemctl('show',unit,*['--property='+x for x in fields]).stdout
        result = dict(line.split('=',1) for line in out.splitlines() if '=' in line)
        require(all(x in result for x in fields), f'unit state is unreadable for {unit}; inspect its complete systemd state')
        return result

    def empty_command_array(self, unit, field):
        encoded = ''.join(chr(byte) if chr(byte).isalnum() and byte < 128 else f'_{byte:02x}'
                          for byte in unit.encode())
        path = '/org/freedesktop/systemd1/unit/' + encoded
        result = self.run(['busctl','--user','get-property','org.freedesktop.systemd1',path,
                           'org.freedesktop.systemd1.Service',field])
        require(result.stdout.strip() == 'a(sasbttttuii) 0',
                f'{field} is not proved an explicitly empty command array for {unit}; fix the drop-in before stopping any unit')

    def empty_stop(self):
        unit = self.units['runner']
        p = self.properties(unit,identity=True)
        require(p['LoadState'] == 'loaded' and p['Id'] == unit,
                f'loaded unit identity is not proved for {unit}; inspect its complete systemd state')
        self.empty_command_array(unit,'ExecStop')
        self.empty_command_array(unit,'ExecStopPost')
        self.stop_proved = True

    def stopped(self, unit):
        p = self.properties(unit)
        require(p['ActiveState'] in ('inactive','failed') and p['SubState'] in ('dead','failed') and p['MainPID'] == '0' and p['ControlPID'] == '0' and p['UnitFileState'] in ('masked','masked-runtime'),
                f'{unit} is not settled and masked; inspect that unit before stopping the sandbox')

    def stop_unit(self, unit):
        self.systemctl('stop',unit)
        self.systemctl('mask',unit)
        self.stopped(unit)

    def disk(self):
        out = self.inside('python3','-c',DISK,json.dumps(self.s)).stdout
        doc = json.loads(out)
        require(re.fullmatch(r'[0-9a-f]{40,64}',doc['clone_commit']) and doc['boot_id'], 'sandbox disk witnesses are unreadable; inspect the private clone and receipts')
        return doc

    def status(self):
        try:
            result = self.sbx('ls','--json',check=False)
            document = json.loads(result.stdout)
            require(isinstance(document,dict) and isinstance(document.get('sandboxes'),list), 'status list has unknown shape')
            listing = document['sandboxes']
            matches = [x for x in listing if x.get('name') == self.s['name']]
            require(result.returncode == 0 and len(matches) == 1 and matches[0].get('status') == 'stopped', 'status is unknown or not stopped')
        except (ValueError,TypeError,AttributeError,Refusal):
            raise Refusal(f'stopped status is unknown or not proved for {self.s["name"]}; work may still be running inside, so keep units masked and inspect before retrying') from None

    def profile(self):
        payload = {'source':self.source,'sandbox':self.s,'env':{k:v for k,v in self.values.items() if k in {'FACTORY_GATEWAY_ADDRESS','FORGE_SANDBOX_SIDECAR_URL','FORGE_SANDBOX_RUNNER_URL'} or k in self.s.get('allow_replacements',{}).values()},'answer':self.answer,'memory_mcp':self.memory_mcp}
        out = self.run(['docker','--context',self.config['docker_context'],'run','--rm','--pull=never','--network=none','--read-only','-i','--entrypoint','python',self.config['runtime_image'],'-c',PROFILE], input=json.dumps(payload)).stdout
        return json.loads(out)

    def validate_bootstrap_ports(self, profile):
        # Read the current bundled template's defaults. A project using another
        # inner port must actually forward its matching setting through run.sh.
        for name, published in zip(('SANDBOX_SIDECAR_PORT','SANDBOX_RUNNER_PORT'),profile['publish'][-2:]):
            default = re.search(r'^\w+="\$\{' + name + r':-([0-9]+)\}"$',self.template.decode(),re.MULTILINE)
            require(default is not None, f'current template default for {name} is unreadable; verify its listener contract before proceeding')
            effective = self.forwarded_values.get(name) or default[1]
            require(effective.isdigit() and 0 < int(effective) < 65536 and int(effective) == int(published.rsplit(':',1)[1]),
                    f'effective forwarded {name} does not match the profile destination port; declare and forward the project port before stopping the sandbox')

    def reviewed_image_settings(self):
        # Read the accepted serialization, never source its shell. Keep this
        # caller bound to the same platform/layer/runtime-config document that
        # the unchanged transfer helper and installed template compare.
        pattern = r"^IMAGE_IDENTITY_DOCUMENT_FORMAT='([^']+)'$"
        formats = [re.search(pattern, source, re.MULTILINE) for source in
                   (HANDOFF.read_text(), self.template.decode())]
        require(all(formats) and formats[0][1] == formats[1][1],
                'image identity formats disagree; reconcile the accepted helper and current template')
        document = self.run(['docker','--context',self.config['docker_context'],
            'image','inspect','--format',formats[0][1],self.config['runtime_image']]).stdout
        # Match the helper's command-substitution and transport normalization;
        # JSON escapes configuration line endings, so these are transport only.
        document = document.rstrip('\n').replace('\r\n','\n').removesuffix('\r').rstrip('\n')
        header, separator, body = document.partition('\n')
        require(separator and header == 'forge-image-identity/2',
                'reviewed immutable image identity is unreadable; keep units masked and inspect that image')
        identity = json.loads(body)
        require(isinstance(identity,dict) and set(identity) == {
            'architecture','os','layers','env','entrypoint','cmd','user','workdir',
            'labels','ports','volumes','stopsignal'} and isinstance(identity['labels'],dict),
            'reviewed immutable image identity is incomplete; keep units masked and inspect that image')
        labels = identity['labels']
        # Never persist this document: its runtime configuration can contain
        # environment values. Only its hash and the release labels leave here.
        return {
            'FORGE_IMAGE_IDENTITY':digest((document+'\n').encode()),
            'FORGE_RELEASE_VERSION':labels.get('com.guardkit.release.version'),
            'FORGE_RELEASE_MANIFEST_SHA256':labels.get('com.guardkit.release.manifest.sha256'),
        }

    def release_tag_resolves(self):
        resolved = self.run(['docker','--context',self.config['docker_context'],'image','inspect','--format','{{.Id}}',self.s['release_image']]).stdout.strip()
        require(resolved == self.config['runtime_image'], 'release_image tag no longer resolves to the accepted host image; restore its exact release identity before proceeding')

    def handoff(self):
        expected = self.reviewed_image_settings()  # Immutable host ID, never the mutable transfer tag.
        self.release_tag_resolves()
        env = dict(self.env,FORGE_IMAGE=self.s['release_image'],SANDBOX_CLIENT='sbx')
        result = self.run(['bash',str(HANDOFF),self.s['name']],env=env,timeout=1000)
        names = ('FORGE_IMAGE','FORGE_IMAGE_IDENTITY','FORGE_RELEASE_VERSION','FORGE_RELEASE_MANIFEST_SHA256')
        settings = {}
        for line in result.stdout.splitlines():
            match = re.fullmatch(r'\[hand-release-image\]   ([A-Z0-9_]+)=(.*)',line)
            if match and match[1] in names:
                settings[match[1]] = match[2]
        require(set(settings) == set(names) and settings['FORGE_IMAGE'] == self.s['release_image'] and re.fullmatch(r'[0-9a-f]{64}',settings['FORGE_IMAGE_IDENTITY']) and re.fullmatch(r'[0-9a-f]{64}',settings['FORGE_RELEASE_MANIFEST_SHA256']) and re.fullmatch(r'[A-Za-z0-9_.-]+',settings['FORGE_RELEASE_VERSION']), 'image handoff did not return its complete identity settings; keep units masked and inspect the release')
        require(all(settings[name] == value for name,value in expected.items()),
                'image handoff identity or release labels differ from the reviewed immutable image; keep units masked and inspect the transfer tag')
        private_write(self.evidence/'bootstrap-image.env',''.join(name+'='+settings[name]+'\n' for name in names).encode())
        return settings

    def require_sbx_version(self):
        try:
            version = json.loads(self.sbx('version','--json').stdout)
            client = version['client']
            server = version['server']
            valid_version = (isinstance(version,dict) and isinstance(client,dict)
                and isinstance(server,dict)
                and client.get('version') == self.s['expected_sbx_version']
                and server.get('state') == 'running'
                and server.get('version') == self.s['expected_sbx_version'])
        except (ValueError,TypeError,KeyError):
            valid_version = False
        require(valid_version, 'sandbox client or server version/state is not the reviewed running v0.42.1 contract; verify its stopped-status contract first')

    def execute(self):
        print('While the sandbox is stopped, nobody may run sbx prune, sbx rm or sbx reset.',flush=True)
        self.require_sbx_version()
        profile = self.profile()  # Parse/validate before touching any unit.
        self.validate_bootstrap_ports(profile)
        settings = self.sandbox_settings()  # Generated and loaded before touching any unit.
        receipt = self.evidence / 'sandbox-installed.json'
        if receipt.exists():
            previous = json_read(receipt)
            require(previous.get('project') == self.args.project and previous.get('sandbox') == self.s['name'] and previous.get('image') == self.config['runtime_image'] and previous.get('template_sha256') == digest(self.template), 'installation receipt differs from this rollout; reconcile the existing installation')
            for path, data in ((self.s['script_path'],self.template),(self.s['profile_path'],profile['text'].encode()),(str(self.settings_path),settings['text'].encode())):
                out = self.inside('sha256sum',path).stdout.split()
                require(out and out[0] == digest(data), f'installed file differs at {path}; reconcile without re-running legacy shutdown')
            require(Path(self.s['profile_source']).read_bytes() == profile['text'].encode(), 'producer profile differs from the installed profile; reconcile its routes')
            image_settings = previous['bootstrap_image_settings']
            reviewed = self.reviewed_image_settings()
            require(image_settings.get('FORGE_IMAGE') == self.s['release_image'] and all(image_settings.get(name) == value for name,value in reviewed.items()), 'existing installation identity differs from the reviewed immutable image; reconcile its receipt and runner settings')
            expected = {name:self.values[name] for name in self.forwarded_names if name in self.values}
            expected.update(image_settings)
            expected['FORGE_CONFIG_PATH'] = str(self.settings_path)
            encoded = ''.join(name+'='+json.dumps(value.replace('$','$$'),ensure_ascii=False)+'\n' for name,value in sorted(expected.items()))
            require(self.bootstrap_env.read_bytes() == encoded.encode(), 'normal runner env file differs from explicit inputs; reconcile it before starting the sandbox service')
            print('Sandbox replacement already matches the current template and profile; legacy shutdown was not repeated.')
            return
        before = self.disk()
        self.save('disk-before.json',before)
        print('Private clone commits absent from its recorded remote ref: '+(before['ahead_commits'].replace('\n',', ') or 'none'),flush=True)
        try:
            diagnostics = self.inside('ps','-eo','pid,lstart,args',check=False)
        except Refusal:
            diagnostics = subprocess.CompletedProcess([],2,'','')
        self.save('processes-before.json',{'readable':diagnostics.returncode == 0,'processes':diagnostics.stdout if diagnostics.returncode == 0 else ''})
        if diagnostics.returncode:
            print('Before-list unavailable; whole-sandbox stop and disk proof remain required.',flush=True)
        private_write(self.dropin,EMPTY_STOP.encode())
        self.systemctl('daemon-reload')
        self.empty_stop()
        self.stop_unit(self.units['keeper'])
        self.empty_stop()  # Prove again immediately before any runner stop.
        self.stop_unit(self.units['runner'])
        self.stopped(self.units['keeper'])
        inspect = json.loads(self.sbx('inspect',self.s['name'],'--json').stdout)
        require(isinstance(inspect,dict) and inspect.get('name') == self.s['name'] and type(inspect.get('sessions')) is int, 'sandbox session count is unknown; inspect the named sandbox before proceeding')
        print(f'Sandbox sessions before stop: {inspect["sessions"]}',flush=True)
        require(inspect['sessions'] == 0, f'{self.s["name"]} still has held sessions; close those sessions before retrying')
        opened = dt.datetime.now(dt.timezone.utc).isoformat()
        print('Stopped window opens '+opened,flush=True)
        try:
            stop = self.sbx('stop',self.s['name'],check=False)
        except Refusal:
            raise Refusal(f'{self.s["name"]} stop outcome is unknown and work may still be running inside; keep both units masked and inspect before retrying') from None
        require(stop.returncode == 0, f'{self.s["name"]} refused to stop and work may still be running inside; keep both units masked and inspect before retrying')
        self.status()
        # The sole next exec is our wake; do not call inspect/exec in between.
        containers = self.inside('docker','ps','--no-trunc','--format','{{.ID}}').stdout.strip()
        print('Stopped window closes '+dt.datetime.now(dt.timezone.utc).isoformat(),flush=True)
        require(not containers, f'{self.s["name"]} woke with running containers {containers.replace(chr(10),", ")}; leave them untouched and inspect before retrying')
        after = self.disk()
        self.save('disk-after.json',after)
        require(after['boot_id'] != before['boot_id'], f'{self.s["name"]} did not prove a fresh boot; work may still be running inside, so inspect before retrying')
        for key in ('clone_commit','remote_commit','declarations','known_files','receipt_listing','receipt_file_count','receipt_total_bytes','receipt_listing_sha256','ahead_commits'):
            detail = ''
            if key == 'known_files' and before[key] != after[key]:
                names = sorted(name for name in set(before[key]) | set(after[key])
                               if before[key].get(name) != after[key].get(name))
                detail = ' for '+json.dumps(names,ensure_ascii=True,separators=(',',':'))
            require(before[key] == after[key], f'{key} changed{detail} in {self.s["clone_path"]} or {self.s["receipts_path"]}; install nothing and reconcile the disk evidence')
        processes = self.inside('ps','-eo','pid,lstart,args').stdout
        self.save('processes-after.json',{'processes':processes})
        require(not any(marker in processes for marker in self.s['legacy_command_markers']), f'legacy work is visible after waking {self.s["name"]}; leave it untouched and inspect before retrying')
        self.stopped(self.units['keeper'])
        self.stopped(self.units['runner'])
        image_settings = self.handoff()  # Accepted platform/layer/config proof, NOT engine ID equality.
        self.sbx('policy','allow','network','--sandbox',self.s['name'],','.join(profile['rules']))
        self.sbx('policy','check','network','--sandbox',self.s['name'],self.values['FORGE_TARGET_OWNER_URL'])
        for old, new in zip(profile['old_publish'],profile['publish']):
            if old != new:
                self.sbx('ports',self.s['name'],'--unpublish',old)
            self.sbx('ports',self.s['name'],'--publish',new)
        # Never start a service here. Only the reviewed template can be exposed.
        items = [self.settings_item(settings['text']), {'path':self.s['script_path'],'root':self.s['clone_path'],'data':base64.b64encode(self.template).decode(),'mode':0o755}, {'path':self.s['profile_path'],'root':self.s['clone_path'],'data':base64.b64encode(profile['text'].encode()).decode(),'mode':0o644}]
        self.replacement_started = True
        self.inside('python3','-c',INSTALL,input=json.dumps(items))
        private_write(Path(self.s['profile_source']),profile['text'].encode(),0o644)
        # Existing Compose runner consumes this exact explicit env_file. Its
        # normal run.sh forwards only SANDBOX_ENV_NAMES, unchanged by this tool.
        bootstrap = {name:self.values[name] for name in self.forwarded_names if name in self.values}
        bootstrap.update(image_settings)
        bootstrap['FORGE_CONFIG_PATH'] = str(self.settings_path)
        encoded = ''.join(name+'='+json.dumps(value.replace('$','$$'),ensure_ascii=False)+'\n' for name,value in sorted(bootstrap.items()))
        private_write(self.bootstrap_env,encoded.encode())
        require(self.bootstrap_env.read_bytes() == encoded.encode(), 'normal runner env file readback differs; reconcile the private operational output')
        for path in self.s['legacy_dropins']:
            Path(path).unlink(missing_ok=True)
        self.dropin.unlink()
        self.systemctl('daemon-reload')
        # Both old units STAY MASKED (release -3 TC6): the estate's Compose
        # supervisor looks after this sandbox now, and an unmasked runner unit
        # started by a hand-run wrapper would stop that supervisor and both
        # containers through its own stop step. Never unmasked here.
        for unit in self.units.values():
            self.stopped(unit)
        self.save('commands.json',self.events)
        self.save('sandbox-installed.json',{'format_version':1,'project':self.args.project,'sandbox':self.s['name'],'image':self.config['runtime_image'],'template_sha256':digest(self.template),'profile_sha256':digest(profile['text'].encode()),'answer_rule':self.answer,'memory_mcp_rule':self.memory_mcp,'disk_before':before,'disk_after':after,'bootstrap_image_settings':image_settings,'bootstrap_env_file':str(self.bootstrap_env),'bootstrap_env_names':sorted(bootstrap),'settings_path':str(self.settings_path),'settings_sha256':settings['sha256'],'coordinator_settings_sha256':settings['coordinator_settings_sha256'],'routine_seat':settings['seat'],'worktree_disk_floor_gb':self.s['worktree_disk_floor_gb'],'legacy_units':'masked','remote_fetch_through_normal_entry':'NOT-TESTED','memory_forwarded_names':list(MEMORY_NAMES),'actual_memory_read_write':'NOT-TESTED'})
        self.complete = True
        print('Current template and producer profile installed and read back; both old host units stay masked and stopped; actual memory read/write and normal lifecycle checks remain required.')


    # ---------------------------------------------------------------------
    # Release -3 TC4: --upgrade and --upgrade --back. The sandbox already
    # runs the containerised supervisor; nothing here stops the sandbox,
    # moves a port or a policy rule, or unmasks a unit.
    # ---------------------------------------------------------------------

    def validate_upgrade_inputs(self):
        args = self.args
        require(args.previous_receipt, '--upgrade needs --previous-receipt naming the installed sandbox-installed.json; name it explicitly')
        receipt = Path(args.previous_receipt)
        require(receipt.is_file() and not receipt.is_symlink(), f'previous receipt {receipt} is not a regular file; name the installed sandbox-installed.json')
        require(receipt.resolve() != (self.evidence/'sandbox-installed.json').resolve(),
                'the previous receipt is the one this upgrade would write; give the upgrade its own evidence_dir')
        self.previous_receipt_path = receipt
        self.previous_receipt_bytes = receipt.read_bytes()
        previous = json.loads(self.previous_receipt_bytes)
        require(isinstance(previous,dict) and previous.get('format_version') in (1,2) and previous.get('project') == args.project and previous.get('sandbox') == self.s['name'],
                'previous receipt is for another project or sandbox; name the receipt of this installation')
        require(all(isinstance(previous.get(k),str) and re.fullmatch(r'[0-9a-f]{64}',previous[k]) for k in ('template_sha256','profile_sha256')),
                'previous receipt lacks the installed template and profile hashes; reconcile it first')
        image = previous.get('bootstrap_image_settings')
        require(isinstance(image,dict) and isinstance(image.get('FORGE_IMAGE'),str) and re.fullmatch(r'[0-9a-f]{64}',str(image.get('FORGE_IMAGE_IDENTITY',''))),
                'previous receipt does not name the previous release image and its identity; reconcile it first')
        require(isinstance(previous.get('bootstrap_env_file'),str) and PurePosixPath(previous['bootstrap_env_file']).is_absolute(),
                'previous receipt does not name its bootstrap env file; reconcile it first')
        require(Path(previous['bootstrap_env_file']).resolve() != self.bootstrap_env.resolve(),
                "sandbox.bootstrap_env_file is the previous release's own file; the upgrade writes a new one and never rewrites the way back's")
        self.previous = previous
        self.previous_dir = self.evidence/'previous-installation'
        default = re.search(r'^PREFIX="\$\{SANDBOX_CONTAINER_PREFIX:-([A-Za-z0-9_.-]+)\}"$',self.template.decode(),re.MULTILINE)
        require(default is not None, 'current template container prefix is unreadable; verify its container names before upgrading')
        self.prefix = self.forwarded_values.get('SANDBOX_CONTAINER_PREFIX') or default[1]
        require(re.fullmatch(r'[A-Za-z0-9][A-Za-z0-9_.-]*',self.prefix), 'SANDBOX_CONTAINER_PREFIX is not a container name prefix; fix the forwarded value')
        self.sandbox_docker = self.forwarded_values.get('SANDBOX_DOCKER') or 'docker'
        if not args.back:
            for name in GIT_IDENTITY_NAMES:
                require(name in self.forwarded_names, f'{name} is not in SANDBOX_ENV_NAMES; the release -3 template refuses to start without the project git identity, so add the name')
                require(self.values.get(name), f'{name} has no value in the explicit env files; the release -3 template refuses to start without the project git identity, so supply it')

    def compose_supervisor(self, *, allow_absent):
        context = self.config['docker_context']
        ids = self.run(['docker','--context',context,'ps','-a','--no-trunc',
                        '--filter','label=com.docker.compose.project='+self.args.project,
                        '--filter','label=com.docker.compose.service=sandbox-runner','--format','{{.ID}}']).stdout.split()
        if not ids:
            require(allow_absent, f'no sandbox-runner container of project {self.args.project} exists, so its clean stop cannot be proved; stop it with the closed-door step (exit 0) first')
            return {'present':False}
        seen = []
        for identifier in ids:
            try:
                state = json.loads(self.run(['docker','--context',context,'container','inspect','--format','{{json .State}}',identifier]).stdout)
            except ValueError:
                state = None
            require(isinstance(state,dict) and state.get('Running') is False and state.get('Restarting') is False and state.get('Status') == 'exited',
                    f'the Compose sandbox-runner {identifier[:12]} is not stopped; stop it with the closed-door step first, so its own template stops the work inside')
            code = state.get('ExitCode')
            if code == 0:
                seen.append({'id':identifier,'exit_code':0,'finished_at':state.get('FinishedAt')})
                continue
            # The same rule as rollout-quiesce --final: any other exit is accepted
            # only once it is proved that nothing runs inside the sandbox.
            meaning = SUPERVISOR_EXITS.get(code,'it ended without its own clean stop (killed or crashed)')
            inside = self.inside_supervision()
            busy = inside['containers']+(['a live supervisor process'] if inside['record_live'] else [])+(['the supervisor\'s lock held'] if inside['lock_held'] else [])
            require(not busy,f'sandbox-runner exited {code}: {meaning}; and inside the sandbox there is still {", ".join(busy)}, so nothing was changed. Stop the bootstrap\'s work inside the sandbox (its stop word, as the supervisor\'s log says), then run this step again')
            seen.append({'id':identifier,'exit_code':code,'finished_at':state.get('FinishedAt'),'meaning':meaning,
                         'accepted_because':'nothing runs inside the sandbox: no helper or runner container, no live supervisor and no held lock','inside':inside})
        return {'present':True,'containers':seen}

    def inside_supervision(self):
        names = sorted(self.inside(self.sandbox_docker,'ps','-a','--no-trunc',
                                   '--filter',f'name=^{self.prefix}-helper$','--filter',f'name=^{self.prefix}-runner$',
                                   '--format','{{.Names}}').stdout.split())
        supervisor = self.read_state()['supervisor']
        require(isinstance(supervisor,dict) and all(type(supervisor.get(k)) is bool for k in ('record_live','lock_held')),
                'the sandbox did not say whether its supervisor still runs; look inside it')
        return {'containers':names,'record_live':supervisor['record_live'],'lock_held':supervisor['lock_held'],'record_present':bool(supervisor.get('record_present'))}

    def factory_containers_absent(self):
        names = self.inside(self.sandbox_docker,'ps','-a','--no-trunc',
                            '--filter',f'name=^{self.prefix}-helper$','--filter',f'name=^{self.prefix}-runner$',
                            '--format','{{.Names}}').stdout.split()
        require(not names, f'{", ".join(names)} still exists inside {self.s["name"]}; the previous supervisor\'s stop did not finish, so inspect it before upgrading')

    def read_state(self):
        files = {'template':self.s['script_path'],'profile':self.s['profile_path'],'settings':str(self.settings_path)}
        out = self.inside('python3','-c',STATE,json.dumps({'files':files,'clone':self.s['clone_path'],'script':self.s['script_path'],'excluded':self.excluded_roots})).stdout
        state = json.loads(out)
        require(isinstance(state,dict) and set(state.get('files',{})) == set(files),'the sandbox state is unreadable; inspect the clone before upgrading')
        return state

    def sandbox_state(self):
        files = {'template','profile','settings'}
        state = self.read_state()
        require(set(state.get('identity',{})) == {'user.name','user.email'},
                'the sandbox state is unreadable; inspect the clone before upgrading')
        supervisor = state['supervisor']
        require(not supervisor['record_live'] and not supervisor['lock_held'],
                f'a supervisor of {self.s["script_path"]} is still running inside {self.s["name"]}; stop it with its own template first')
        require(not state['settings_overlaps'],
                f'sandbox.settings_path resolves inside {self.s["name"]} to {state["settings_real_parent"]}, which overlaps '+', '.join(state['settings_overlaps'])+'; builds could change it through that folder, so choose a path whose real location is outside the clone and every shared folder')
        require(not state['settings_is_link'], f'sandbox.settings_path is itself a link inside {self.s["name"]}; name the real file')
        folder = state['settings_folder']
        if folder['exists'] and folder['mode'] & 0o022:
            raise Refusal(f'the settings folder {self.settings_path.parent} inside {self.s["name"]} is writable by others (mode {folder["mode"]:o}); make it 0755 before upgrading')
        return state

    def units_masked(self, *, mask):
        for unit in self.units.values():
            if mask and self.properties(unit)['UnitFileState'] not in ('masked','masked-runtime'):
                self.systemctl('mask',unit)
            self.stopped(unit)

    def previous_image_present(self):
        image = self.previous['bootstrap_image_settings']
        fmt = re.search(r"^IMAGE_IDENTITY_DOCUMENT_FORMAT='([^']+)'$",HANDOFF.read_text(),re.MULTILINE)
        require(fmt is not None, 'image identity format is unreadable; reconcile the accepted helper')
        result = self.inside(self.sandbox_docker,'image','inspect','--format',fmt[1],image['FORGE_IMAGE'],check=False)
        document = result.stdout.rstrip('\n').replace('\r\n','\n').removesuffix('\r').rstrip('\n')
        require(result.returncode == 0 and document.startswith('forge-image-identity/2\n') and digest((document+'\n').encode()) == image['FORGE_IMAGE_IDENTITY'],
                f'the previous release image {image["FORGE_IMAGE"]} is not in {self.s["name"]}\'s engine with its recorded identity; hand it in again before going back')

    def set_identity(self, values):
        out = self.inside('python3','-c',IDENTITY,input=json.dumps({'clone':self.s['clone_path'],'set':values})).stdout
        return json.loads(out)

    def routes_unchanged(self, installed, new):
        out = self.run(['docker','--context',self.config['docker_context'],'run','--rm','--pull=never','--network=none','--read-only','-i','--entrypoint','python',self.config['runtime_image'],'-c',ROUTES],
                       input=json.dumps({'installed':installed,'new':new})).stdout
        routes = json.loads(out)
        require(routes['installed'] == routes['new'], "the producer profile's publish or allow entries differ from the installed profile's; an upgrade does not move routes, so reconcile the profile first")

    def bootstrap_text(self, image_settings):
        bootstrap = {name:self.values[name] for name in self.forwarded_names if name in self.values}
        bootstrap.update(image_settings)
        bootstrap['FORGE_CONFIG_PATH'] = str(self.settings_path)
        return bootstrap, ''.join(name+'='+json.dumps(value.replace('$','$$'),ensure_ascii=False)+'\n' for name,value in sorted(bootstrap.items()))

    def bootstrap_settings_file(self, data):
        """The settings file a bootstrap env names (FORGE_CONFIG_PATH) and its
        hash inside the sandbox, so --switch can check the release it starts
        reads the file it was installed with. Never the file's content."""
        named = None
        for line in data.decode().splitlines():
            key, sep, value = line.partition('=')
            if sep and key == 'FORGE_CONFIG_PATH':
                try:
                    named = json.loads(value).replace('$$','$')
                except ValueError:
                    named = value
        if not named:
            return None
        out = self.inside('sha256sum',named,check=False)
        fields = out.stdout.split()
        return {'path':named,'sha256':fields[0] if out.returncode == 0 and fields else None}

    def read_back(self, expected):
        for path, data in expected:
            out = self.inside('sha256sum',path).stdout.split()
            require(out and out[0] == digest(data), f'installed file differs at {path} after writing; reconcile with --upgrade --back')

    def upgrade_plan(self):
        settings = self.sandbox_settings()
        bootstrap, _ = self.bootstrap_text({'FORGE_IMAGE':'','FORGE_IMAGE_IDENTITY':'','FORGE_RELEASE_VERSION':'','FORGE_RELEASE_MANIFEST_SHA256':''})
        print('Plan only (--upgrade): nothing is changed. Would require the previous receipt\'s template and profile hashes in the clone, the Compose sandbox-runner stopped with exit 0, no '+self.prefix+'-helper or '+self.prefix+'-runner container and no live supervisor inside '+self.s['name']+'; mask both old units if needed; save the previous template, profile, settings file and clone-local git identity to '+str(self.previous_dir)+' (0600, with hashes; the previous bootstrap env by hash only); unset the clone-local identity; hand in '+self.s['release_image']+'; write the settings file below; install the current template; write the new bootstrap env at '+str(self.bootstrap_env)+'. Never sbx stop, sbx ports, sbx policy or systemctl unmask.')
        print('Previous receipt: template '+self.previous['template_sha256']+', profile '+self.previous['profile_sha256']+', release '+str(self.previous['bootstrap_image_settings'].get('FORGE_RELEASE_VERSION'))+'; current template '+digest(self.template))
        print('Generated sandbox settings for '+str(self.settings_path)+' (sha256 '+settings['sha256']+', from coordinator settings '+settings['coordinator_settings_sha256']+'):')
        print(settings['text'].rstrip('\n'))
        print('Repository keys mapped to the clone: '+', '.join(k+' -> '+self.s['clone_path'] for k in self.s['repo_keys']))
        print('Routine seat (the coordinator\'s): '+str(settings['seat'])+'; timeout multiplier: '+str(settings['timeout_multiplier'])+'; worktree disk floor: '+str(self.s['worktree_disk_floor_gb'])+' GiB')
        print('New bootstrap env names (values not shown): '+' '.join(sorted(bootstrap)))
        print('Git identity names present with values: '+' '.join(name for name in GIT_IDENTITY_NAMES if name in bootstrap and self.values.get(name)))

    def execute_upgrade(self):
        self.require_sbx_version()
        previous = self.previous
        require(not (self.previous_dir/'previous.json').exists(),
                f'a previous installation is already saved at {self.previous_dir}; this upgrade has run before, so use --upgrade --back or reconcile that folder first')
        profile = self.profile()
        self.validate_bootstrap_ports(profile)
        settings = self.sandbox_settings()
        # Read-only, and asked again by handoff(): a wrong tag refuses here,
        # before any unit, file or identity is touched.
        self.reviewed_image_settings()
        self.release_tag_resolves()
        supervisor = self.compose_supervisor(allow_absent=False)
        # The first exec may wake a sandbox that slept after the supervisor
        # stopped; nothing old runs inside to be woken (runbook 2.8).
        self.factory_containers_absent()
        state = self.sandbox_state()
        require(not state['identity_multiple'],
                'the clone has more than one local '+' and '.join(state['identity_multiple'])+' set, so it cannot be saved and put back as one value; leave one value (or none) with git config --local and run the upgrade again')
        installed = state['files']
        require(installed['template'] and installed['template']['sha256'] == previous['template_sha256'],
                f'the clone\'s {self.s["script_path"]} is not the template the previous receipt installed; reconcile before upgrading')
        require(installed['profile'] and installed['profile']['sha256'] == previous['profile_sha256'],
                f'the clone\'s {self.s["profile_path"]} is not the profile the previous receipt installed; reconcile before upgrading')
        installed_profile = base64.b64decode(installed['profile']['data'])
        new_profile = profile['text'].encode()
        self.routes_unchanged(installed_profile.decode(),profile['text'])
        profile_changed = installed_profile != new_profile
        self.units_masked(mask=True)
        old_bootstrap = Path(previous['bootstrap_env_file'])
        require(old_bootstrap.is_file() and not old_bootstrap.is_symlink(), f'the previous bootstrap env {old_bootstrap} is missing; reconcile before upgrading')
        old_bootstrap_bytes = old_bootstrap.read_bytes()
        previous_settings_file = self.bootstrap_settings_file(old_bootstrap_bytes)
        source_bytes = Path(self.s['profile_source']).read_bytes()
        identity = state['identity']
        # Save everything the way back needs, values never printed, then the
        # manifest last: its presence means the saved copies are complete.
        saved = {}
        for key, name in (('template','sandbox-runner.sh'),('profile','profile.yaml'),('settings','settings.yaml')):
            item = installed[key]
            if item is None:
                saved[key] = None
                continue
            data = base64.b64decode(item['data'])
            private_write(self.previous_dir/name,data)
            saved[key] = {'path':{'template':self.s['script_path'],'profile':self.s['profile_path'],'settings':str(self.settings_path)}[key],'saved':name,'sha256':digest(data),'mode':item['mode']}
        identity_bytes = (json.dumps(identity,sort_keys=True)+'\n').encode()
        private_write(self.previous_dir/'git-identity.json',identity_bytes)
        private_write(self.previous_dir/'profile-source.yaml',source_bytes)
        template_new = self.template
        manifest = {
            'format_version':1,'project':self.args.project,'sandbox':self.s['name'],
            'saved_at':dt.datetime.now(dt.timezone.utc).isoformat(),
            'previous_receipt':{'path':str(self.previous_receipt_path),'sha256':digest(self.previous_receipt_bytes)},
            'release':{k:previous['bootstrap_image_settings'].get(k) for k in ('FORGE_IMAGE','FORGE_IMAGE_IDENTITY','FORGE_RELEASE_VERSION','FORGE_RELEASE_MANIFEST_SHA256')},
            'files':saved,
            'git_identity':{'saved':'git-identity.json','sha256':digest(identity_bytes),'values_sha256':{k:(None if v is None else digest(v.encode())) for k,v in identity.items()}},
            # Hash only: that file carries secret values, and --back never
            # rewrites it, it only checks it is unchanged.
            'bootstrap_env':{'path':str(old_bootstrap),'sha256':digest(old_bootstrap_bytes)},
            'profile_source':{'path':self.s['profile_source'],'sha256':digest(source_bytes),'saved':'profile-source.yaml','after_sha256':digest(new_profile)},
            'planned':{'template_sha256':digest(template_new),'profile_sha256':digest(new_profile),'settings_sha256':settings['sha256']},
        }
        private_write(self.previous_dir/'previous.json',(json.dumps(manifest,sort_keys=True,indent=2)+'\n').encode())
        self.replacement_started = True
        # U4b: a clone-local identity would override the release's system-level
        # one and hide whether release -3's own mechanism works.
        identity_after = self.set_identity({'user.name':None,'user.email':None})
        image_settings = self.handoff()
        items = [self.settings_item(settings['text'],state['settings_real_parent']),{'path':self.s['script_path'],'root':self.s['clone_path'],'data':base64.b64encode(template_new).decode(),'mode':0o755}]
        if profile_changed:
            items.append({'path':self.s['profile_path'],'root':self.s['clone_path'],'data':base64.b64encode(new_profile).decode(),'mode':0o644})
        self.inside('python3','-c',INSTALL,input=json.dumps(items))
        if profile_changed and source_bytes != new_profile:
            private_write(Path(self.s['profile_source']),new_profile,0o644)
        bootstrap, encoded = self.bootstrap_text(image_settings)
        private_write(self.bootstrap_env,encoded.encode())
        require(self.bootstrap_env.read_bytes() == encoded.encode(), 'new bootstrap env readback differs; reconcile with --upgrade --back')
        self.read_back([(self.s['script_path'],template_new),(self.s['profile_path'],new_profile),(str(self.settings_path),settings['text'].encode())])
        require(old_bootstrap.read_bytes() == old_bootstrap_bytes, 'the previous bootstrap env changed during the upgrade; reconcile before going on')
        self.units_masked(mask=False)
        self.save('commands.json',self.events)
        self.save('sandbox-installed.json',{
            'format_version':2,'project':self.args.project,'sandbox':self.s['name'],'image':self.config['runtime_image'],
            'template_sha256':digest(template_new),'profile_sha256':digest(new_profile),
            'profile_reinstalled':profile_changed,
            'profile_reinstall_reason':'producer profile bytes changed; routes unchanged' if profile_changed else 'unchanged; not reinstalled',
            'answer_rule':self.answer,'memory_mcp_rule':self.memory_mcp,
            'bootstrap_image_settings':image_settings,'bootstrap_env_file':str(self.bootstrap_env),'bootstrap_env_sha256':digest(encoded.encode()),
            'bootstrap_env_names':sorted(bootstrap),
            'settings_path':str(self.settings_path),'settings_sha256':settings['sha256'],'coordinator_settings_sha256':settings['coordinator_settings_sha256'],
            'routine_seat':settings['seat'],'worktree_disk_floor_gb':self.s['worktree_disk_floor_gb'],
            'legacy_units':'masked','clone_local_git_identity':{'saved':True,'after':identity_after},
            'compose_supervisor':supervisor,
            'previous':{'receipt':manifest['previous_receipt'],'release':manifest['release'],
                        'template_sha256':previous['template_sha256'],'profile_sha256':previous['profile_sha256'],
                        'settings':saved['settings'] and {'path':saved['settings']['path'],'sha256':saved['settings']['sha256']},
                        'bootstrap_env':{'path':str(old_bootstrap),'sha256':digest(old_bootstrap_bytes)},
                        'bootstrap_settings_file':previous_settings_file,
                        'saved_in':str(self.previous_dir),'manifest_sha256':digest((self.previous_dir/'previous.json').read_bytes())},
        })
        self.complete = True
        print('Upgraded '+self.s['name']+': settings file, template'+(' and profile' if profile_changed else '')+' installed and read back; new bootstrap env written at '+str(self.bootstrap_env)+'; clone-local git identity moved aside; both old units masked; the previous installation is saved in '+str(self.previous_dir)+'.')

    def execute_back(self):
        self.require_sbx_version()
        previous = self.previous
        supervisor = self.compose_supervisor(allow_absent=True)
        self.factory_containers_absent()
        state = self.sandbox_state()
        self.previous_image_present()
        manifest_path = self.previous_dir/'previous.json'
        restored = {}
        left_settings = None
        if manifest_path.exists():
            manifest = json_read(manifest_path)
            require(manifest.get('project') == self.args.project and manifest.get('sandbox') == self.s['name'] and manifest.get('previous_receipt',{}).get('sha256') == digest(self.previous_receipt_bytes),
                    'the saved previous installation belongs to another receipt; reconcile it first')
            items = []
            for key in ('settings','template','profile'):
                entry = manifest['files'].get(key)
                if entry is None:
                    if key == 'settings':
                        left_settings = str(self.settings_path)
                        restored[key] = ('there was no settings file before the upgrade, so the generated file '+str(self.settings_path)
                                         +' and its folder are left in place; release -2 never reads it (its bootstrap env names its own file)')
                    else:
                        restored[key] = 'none saved; left as it is'
                    continue
                data = (self.previous_dir/entry['saved']).read_bytes()
                require(digest(data) == entry['sha256'], f'the saved copy of {entry["path"]} does not match its recorded hash; reconcile the saved folder')
                item = {'path':entry['path'],'root':str(PurePosixPath(entry['path']).parent),'data':base64.b64encode(data).decode(),'mode':entry['mode']}
                items.append(item)
                restored[key] = {'path':entry['path'],'sha256':entry['sha256']}
            identity_bytes = (self.previous_dir/'git-identity.json').read_bytes()
            require(digest(identity_bytes) == manifest['git_identity']['sha256'], 'the saved clone-local git identity does not match its recorded hash; reconcile the saved folder')
            identity = json.loads(identity_bytes)
            old_bootstrap = Path(manifest['bootstrap_env']['path'])
            require(old_bootstrap.is_file() and digest(old_bootstrap.read_bytes()) == manifest['bootstrap_env']['sha256'],
                    f'the previous release\'s bootstrap env {old_bootstrap} no longer has its recorded hash; the way back would start on other settings, so reconcile it first')
            source = manifest['profile_source']
            saved_source = (self.previous_dir/source['saved']).read_bytes()
            require(digest(saved_source) == source['sha256'], 'the saved producer profile does not match its recorded hash; reconcile the saved folder')
            self.replacement_started = True
            self.inside('python3','-c',INSTALL,input=json.dumps(items))
            values_after = self.set_identity(identity)
            require(values_after == manifest['git_identity']['values_sha256'], 'the clone-local git identity did not read back as saved; reconcile it')
            current_source = Path(source['path']).read_bytes()
            if digest(current_source) == source['after_sha256'] and current_source != saved_source:
                private_write(Path(source['path']),saved_source,0o644)
                restored['profile_source'] = 'restored'
            self.read_back([(item['path'],base64.b64decode(item['data'])) for item in items])
            bootstrap_hash = manifest['bootstrap_env']['sha256']
            template_hash = manifest['files']['template']['sha256']
            restored['git_identity'] = {'values_sha256':values_after,
                'note':"the clone-local user.name and user.email values are restored exactly; the clone's .git/config file itself may differ in layout"}
        else:
            # Nothing was saved, so nothing was changed: prove the clone still
            # holds the previous installation.
            files = state['files']
            require(files['template'] and files['template']['sha256'] == previous['template_sha256'] and files['profile'] and files['profile']['sha256'] == previous['profile_sha256'],
                    'no previous installation was saved and the clone no longer holds the previous template and profile; reconcile by hand')
            old_bootstrap = Path(previous['bootstrap_env_file'])
            require(old_bootstrap.is_file(), f'the previous release\'s bootstrap env {old_bootstrap} is missing; reconcile it first')
            bootstrap_hash = digest(old_bootstrap.read_bytes())
            template_hash = previous['template_sha256']
            restored = {'note':'nothing had been changed; the previous installation was verified in place'}
        self.save('commands-back.json',self.events)
        self.save('sandbox-restored.json',{
            'format_version':1,'project':self.args.project,'sandbox':self.s['name'],
            'restored_release':previous['bootstrap_image_settings'].get('FORGE_RELEASE_VERSION'),
            'restored_image':previous['bootstrap_image_settings'].get('FORGE_IMAGE'),
            'template_sha256':template_hash,'bootstrap_env_file':str(old_bootstrap),'bootstrap_env_sha256':bootstrap_hash,
            'bootstrap_settings_file':self.bootstrap_settings_file(old_bootstrap.read_bytes()),
            'restored':restored,'compose_supervisor':supervisor,
            'restored_at':dt.datetime.now(dt.timezone.utc).isoformat(),
        })
        self.complete = True
        print('Put back the previous installation of '+self.s['name']+' (release '+str(previous['bootstrap_image_settings'].get('FORGE_RELEASE_VERSION'))+', template '+template_hash+'); its bootstrap env is unchanged; the clone-local git identity values are restored exactly; both old units left as they are.'
              +(' The generated settings file '+left_settings+' and its folder are left in place: there was none before, and release -2 never reads it.' if left_settings else ''))


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__,formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument('--config',required=True)
    parser.add_argument('--env-file',required=True)
    parser.add_argument('--project',required=True)
    parser.add_argument('--secret-env-file',action='append',default=[],help='private literal env input, repeatable; cannot override public names')
    parser.add_argument('--stop-legacy',action='store_true',help='perform the one-time legacy stop, verify, and replacement')
    parser.add_argument('--upgrade',action='store_true',help='take a new release into a sandbox the containerised supervisor already looks after (its supervisor stopped first). --upgrade and --upgrade --back each run within '+str(UPGRADE_LIMIT_SECONDS)+' seconds overall: every command is bounded by what is left, and none is started after it')
    parser.add_argument('--back',action='store_true',help='with --upgrade: put the saved previous installation back')
    parser.add_argument('--previous-receipt',help='with --upgrade: the installed sandbox-installed.json')
    parser.add_argument('--plan',action='store_true')
    args = parser.parse_args(argv)
    rollout = None
    try:
        require(not (args.upgrade and args.stop_legacy), '--upgrade and --stop-legacy are different operations; choose one')
        require(not args.back or args.upgrade, '--back goes with --upgrade; say --upgrade --back')
        rollout = Rollout(args)
        if args.upgrade:
            rollout.deadline = time.monotonic() + UPGRADE_LIMIT_SECONDS
            rollout.validate_upgrade_inputs()
            if args.plan and args.back:
                print('Plan only (--upgrade --back): nothing is changed. Would require the Compose sandbox-runner stopped with exit 0 (or removed), no helper or runner container and no live supervisor inside '+rollout.s['name']+', and the previous release image '+rollout.previous['bootstrap_image_settings']['FORGE_IMAGE']+' in its engine by identity; check every copy saved in '+str(rollout.previous_dir)+' against its hash and the previous bootstrap env against its recorded hash; put back the template, profile and settings file byte for byte (a generated settings file with no earlier one is left in place; release -2 never reads it) and the clone-local git identity values exactly; record sandbox-restored.json. Never sbx stop, sbx ports, sbx policy or systemctl unmask.')
                return 0
            if args.plan:
                rollout.upgrade_plan()
                return 0
            if args.back:
                rollout.execute_back()
            else:
                rollout.execute_upgrade()
            return 0
        if args.plan:
            print('Plan only: remote, systemd, sandbox, image and disk facts are NOT VERIFIED. Would validate profile in the pinned image; record clone, known-file hashes, receipt listing and process diagnostics; empty and prove both runner stop hooks; stop and mask keeper then runner; refuse held sessions; stop only '+rollout.s['name']+'; require positive stopped status; wake with our exec; refuse any running container or legacy process; compare every disk witness; hand in the release with the normal identity helper; write the sandbox settings file at '+str(rollout.settings_path)+' (generated from the coordinator\'s settings, loaded in the image with an empty environment); add sandbox-scoped routes (answer service '+rollout.answer+', memory MCP '+rollout.memory_mcp+'); install the current template byte-for-byte and rewrite producer profile paths/publish rules; remove legacy drop-ins; leave both old units masked and stopped (never unmasked); record evidence.')
            return 0
        require(args.stop_legacy, 'one-time replacement requires --stop-legacy (or --upgrade for a sandbox already on the containerised supervisor); inspect --plan before the attended rollout')
        rollout.execute()
        return 0
    except (Refusal,OSError,ValueError,KeyError,TypeError,AttributeError) as exc:
        if rollout and not args.plan:
            if rollout.replacement_started and not rollout.complete and not args.upgrade:
                # A transport/filesystem failure can interrupt a multi-file install;
                # keep the current lifecycle if present, and fence all starts.
                for unit in rollout.units.values():
                    try:
                        rollout.systemctl('mask',unit,check=False)
                    except Refusal:
                        pass
                try:
                    private_write(rollout.dropin,EMPTY_STOP.encode())
                    rollout.systemctl('daemon-reload',check=False)
                except (Refusal,OSError):
                    pass
            try:
                if rollout.events or not args.upgrade:
                    rollout.save('commands-back-failed.json' if args.back else 'commands-failed.json',rollout.events)
            except OSError:
                pass
        message = str(exc) if isinstance(exc,Refusal) else 'required inventory or evidence is unreadable; inspect the named private config and retain the stopped posture before retrying'
        if rollout and args.upgrade:
            if rollout.replacement_started and not rollout.complete:
                message += ('; the way back was part-way, so run --upgrade --back again once this is fixed' if args.back
                            else '; the upgrade is part-way: the previous installation is saved in '+str(rollout.previous_dir)+', and --upgrade --back puts it back')
            elif not args.plan:
                message += '; nothing in the sandbox was changed'
            suffix = '' if message.endswith(('?','.','!')) else '.'
            print('Refusing: '+message.replace('\n',' ')+suffix,file=sys.stderr)
            return 2
        if rollout and rollout.replacement_started and not rollout.complete:
            message += '; current-template/profile installation may be incomplete, so reconcile the private evidence before unmasking either unit'
        elif rollout and not rollout.replacement_started:
            message += '; nothing has been replaced, and work may still be running inside it — shall I try again, or put it back as it was and stop for today?'
        suffix = '' if message.endswith(('?','.','!')) else '.'
        print('Refusing: '+message.replace('\n',' ')+suffix,file=sys.stderr)
        return 2


if __name__ == '__main__':
    sys.exit(main())
