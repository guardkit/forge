 # Validate every destination and stage every byte before replacing any file.
 for item in items:
  path=pathlib.Path(item['path']); root=pathlib.Path(item['root']); data=base64.b64decode(item['data'],validate=True)
  assert path.is_absolute() and path.parent.is_dir() and not path.is_symlink()
  assert path.parent.resolve().is_relative_to(root.resolve())
