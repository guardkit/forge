def validate_h6(result,candidate,digest,configuration_sha256):
    """Every required observation is explicit; a summary string grants nothing."""
    def require(value):q.need(value,'H6 behavioral proof is incomplete or contradictory; preserve current authority and inspect the private probe result')
    try:
        require(type(result['format_version']) is int and result['format_version']==1 and result['outcome']=='handled-both')
        require(result['candidate_image_id']==candidate and result['pristine_sha256']==digest and result['working_pre_fixture_sha256']==digest and result['configuration_sha256']==configuration_sha256)
        require(type(result['schema_version']) is int and result['schema_version']==r.LEDGER_SCHEMA_VERSION and result['existing_rows_unchanged'] is True and result['real_client_modules']==[])
        require(result['cleanup']=='no owned worker remains' and result['worker_group_empty'] is True and result['worker_thread_stopped'] is True)
        require(type(result['init']['probe_pid']) is int and result['init']['probe_pid']>1)
        needed={'builds':{'build_id','status','mode','start_commit','target_branch'},'publication_records':{'build_id','g_commit','j_commit','checked_json','turn','lines_json'},'deployment_targets':{'target','counter','holder_build','holder_turn','running_commit'}}
        require(all(columns<=set(result['columns'][table]) for table,columns in needed.items()))
        git=result['git'];require(all(isinstance(git[k],str) and re.fullmatch('[0-9a-f]{40}',git[k]) for k in ('G','tip','J','tree')) and len({git[k] for k in ('G','tip','J')})==3)
        pub=result['publication'];require(type(pub['turn']) is int and pub['turn']==4 and pub['result']=='published, deployment pending')
        require(pub['g_commit']==git['G'] and pub['j_commit']==git['J'] and pub['checked']=={'identity':git['J'],'j_commit':git['J'],'j_tree':git['tree']} and pub['original_lines_preserved'] is True)
        require(pub['callbacks']=={'publisher':0,'guardkit':0,'deploy':0,'stage_complete':1} and all(type(value) is int for value in pub['callbacks'].values()))
        require(pub['line_kinds']==['done join','done merge-checks','done candidate-check','about to send','done send'])
        require(all(isinstance(pub[k],str) and re.fullmatch('[0-9a-f]{64}',pub[k]) for k in ('before_sha256','after_sha256')) and pub['before_sha256']!=pub['after_sha256'])
        send=pub['send_result'];require(all(send[k] is True for k in ('found_by_looking','published','contains_j')) and send['ran_on']==git['J'] and send['remote_now']==git['J'])
        target=result['fixture_ids']['target'];require(isinstance(target,str) and target and isinstance(result['fixture_ids']['build'],str))
        deploy=result['deployment'];require(type(deploy['N']) is int and deploy['N']==41 and type(deploy['N_plus_1']) is int and deploy['N_plus_1']==42)
        require(deploy['stale_fencing']=={'renew':False,'record_running':False,'release':False} and all(value is False for value in deploy['stale_fencing'].values()) and deploy['stale_record_unchanged'] is True)
        require(deploy['reconcile']=={target:'occupied (adopted)'})
        old=deploy['old_note'];final=deploy['final_note'];require(old['target']==final['target']==target and old['counter']==old['highest_counter']==41 and type(old['group']) is int and old['group']>0 and old['phase']=='running')
        require(final['highest_counter']==42 and final['group']==0 and final['counter']==0 and final['phase']=='' and final['highest_build']!=old['build'])
        require(len(deploy['old_answers'])==1 and deploy['old_answers'][0]['accepted'] is False and deploy['old_answers'][0]['word']=='the-deploy-command-was-stopped-by-a-takeover')
        successor=deploy['successor'];require(successor['accepted'] is True and type(successor['exit_code']) is int and successor['exit_code']==0 and successor['word']=='the-deploy-command-ran' and 'DEPLOYED_IDENTITY='+git['J'] in successor['output_tail'])
    except (KeyError,TypeError,ValueError,AttributeError):require(False)
    return result

def volume_argument(mount):
    """Represent one saved plain named-volume mode without changing its meaning."""
    allowed={'Type','Name','Source','Destination','Driver','Mode','RW','Propagation'}
    q.need(set(mount)==allowed and mount.get('Type')=='volume','saved named volume identity is incomplete or carries unsupported options; reconcile it before recovery')
    q.need(all(isinstance(mount[k],str) and mount[k] for k in ('Name','Source','Destination','Driver','Mode')),'saved named volume identity is incomplete; reconcile it before recovery')
    q.need(re.fullmatch(r'[a-zA-Z0-9][a-zA-Z0-9_.-]+',mount['Name']) and mount['Source'].startswith('/') and mount['Destination'].startswith('/') and all(part not in ('','.','..') for part in mount['Destination'].split('/')[1:]) and ':' not in mount['Destination'] and not any(x in mount['Source']+mount['Destination'] for x in ('\0','\n','\r')) and not any(0xd800<=ord(x)<=0xdfff for x in mount['Destination']),'saved named volume cannot be represented safely by Docker --volume; reconcile it before recovery')
    q.need(type(mount['RW']) is bool and mount['Mode']==('rw' if mount['RW'] else 'ro'),'saved named volume mode is unsupported or contradicts RW; reconcile its exact security semantics before recovery')
    q.need(mount['Propagation']=='','saved named volume propagation is unsupported; reconcile its exact semantics before recovery')
    return mount['Name']+':'+mount['Destination']+':'+mount['Mode']


def reconstruction_networks(record):
    """Return only a saved network shape Docker can recreate exactly."""
    mode=record.get('network_mode');networks=record.get('networks')
    q.need(isinstance(mode,str) and mode and isinstance(networks,dict) and networks,'previous network identity is malformed; reconcile the saved runtime')
    q.need(mode!='container' and not mode.startswith('container:'),'container-shared networking cannot be safely reconstructed; reconcile the saved runtime')
    if mode=='host':
        options=networks.get('host');fields={'Aliases','Links','IPAMConfig','DriverOpts'}
        q.need(set(networks)=={'host'} and isinstance(options,dict) and fields<=set(options),'saved host network identity is incomplete or mixed with named networks; reconcile the saved runtime')
        q.need(all(options[field] is None for field in fields),'saved host network carries aliases, links, static IPAM or driver options; reconcile its exact network identity')
        q.need(isinstance(record.get('port_bindings'),dict) and not record['port_bindings'],'saved host network carries explicit port bindings; reconcile its exact listener identity')
        return ['host']
    q.need('host' not in networks and mode in networks and all(isinstance(name,str) and name and isinstance(options,dict) for name,options in networks.items()),'previous primary network cannot be safely reconstructed; reconcile the saved runtime')
    return [mode,*[name for name in networks if name!=mode]]


class Recovery(q.Estate):
    def __init__(self,args):super().__init__(args);self.back=self.c.get('back',{})
    def allowed_images(self,service,rendered):
        images={rendered}
        if getattr(self,'_after_candidate',None) and service in ('coordinator','answer-service'):images.add(self._after_candidate)
        return images
    def remove_current(self):
        items=self.service_ids();self.stop_current(q.SERVICES)
        for item in items.values():r.docker(self.c,'rm',item['Id'])
    def old_values(self,role,record):
        filename=self.back['old_env_files'][role];p=q.private_path(filename,exists=True)
        q.need(p.stat().st_mode & 0o077==0,'old runtime values file is not private; restore mode0600 before recovery')
        values,_=q.load_script('rollout-settings').read_env(p)
        q.need(set(values)==set(record['env_names']),f'old {role} environment names differ from the runtime record; supply the complete private source')
        return values
    def validate_runtime(self,record):
        image=record['image_id'];q.need(re.fullmatch(r'sha256:[0-9a-f]{64}',image),'previous release is not an immutable image ID; preserve current state and name the saved ID')
        actual=json.loads(r.docker(self.c,'image','inspect',image).stdout)[0];q.need(actual['Id']==image,'saved image ID is absent; keep both authorities stopped')
        for tag in record['repo_tags']:
            found=json.loads(r.docker(self.c,'image','inspect',tag).stdout)[0]['Id']
            q.need(found==image,f'recorded image {image} tag {tag} now resolves to {found}; keep the estate stopped and reconcile the moved tag')
        identity=record['service_identity'];argv=q.effective_argv(identity)
        q.need(argv and (identity.get('entrypoint') or [argv[0]])[0],'previous process has no executable entrypoint or command; reconcile the saved runtime')
        q.need(all(isinstance(identity.get(k,''),str) for k in ('name','hostname','user','working_dir')) and identity.get('name','').startswith('/'),'previous service identity cannot be represented exactly; reconcile the saved runtime')
        networks=reconstruction_networks(record)
        for name in networks:
            network=record['networks'][name]
            if name!='host':r.docker(self.c,'network','inspect',name)
            q.need(not network.get('Links') and not network.get('IPAMConfig') and not network.get('DriverOpts'),'saved network requires unsupported static options; keep both authorities stopped and reconcile exact reconstruction')
        for bindings in (record['port_bindings'] or {}).values():
            q.need(all(x.get('HostPort') and x['HostPort']!='0' for x in bindings or []),'saved runtime uses an unspecified allocated port; reconcile its exact listener before recovery')
        for m in record['mounts']:
            q.need(m['Type'] in ('bind','volume'),'previous mount type is unsupported; keep the estate stopped')
            if m['Type']=='bind':q.stable_mount(m);r.path(m['Source']);continue
            volume_argument(m)
            found=json.loads(r.docker(self.c,'volume','inspect',m['Name']).stdout)
            q.need(isinstance(found,list) and len(found)==1 and found[0].get('Name')==m['Name'] and found[0].get('Driver')==m['Driver'] and found[0].get('Mountpoint')==m['Source'],'saved named volume name, driver or source no longer matches Docker; keep recovery stopped and reconcile it before removing any container')
    def create_old(self,role,record,journal):
        self.validate_runtime(record);values=self.old_values(role,record);identity=record['service_identity'];name=identity['name'].lstrip('/')
        networks=reconstruction_networks(record);created=journal['created'].get(role)
        if created is None:
            old=r.docker(self.c,'ps','--all','--filter','name=^/'+name+'$','--format','{{.ID}}').stdout.split()
            if old:
                item=r.inspect(self.c,old[0]);q.need(len(old)==1 and item['Id']==identity['container_id'] and not item['State']['Running'],f'old {role} name is occupied by another or running container; keep recovery stopped')
                r.docker(self.c,'rm',item['Id'])
        cmd=['create','--name',name,'--network',networks[0]]
        for key,flag in [('hostname','--hostname'),('user','--user'),('working_dir','--workdir')]:
            if identity.get(key):cmd += [flag,identity[key]]
        for key,value in record.get('labels',{}).items():cmd+=['--label',key+'='+value]
        policy=record['restart_policy'];restart=policy.get('Name')
        if restart:cmd+=['--restart',restart+(':'+str(policy['MaximumRetryCount']) if restart=='on-failure' and policy.get('MaximumRetryCount') else '')]
        for m in record['mounts']:
            if m['Type']=='volume':cmd+=['--volume',volume_argument(m)];continue
            text='type=bind,src='+str(m['Source'])+',dst='+m['Destination']
            if not m['RW']:text+=',readonly'
            if m.get('Propagation'):text+=',bind-propagation='+m['Propagation']
            cmd+=['--mount',text]
        for port,bindings in (record['port_bindings'] or {}).items():
