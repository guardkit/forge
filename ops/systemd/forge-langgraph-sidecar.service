# forge-langgraph-sidecar.service — supervised forge autobuild-runner sidecar (O-30, Phase E2-S3)
#
# WHAT: the autobuild-runner sidecar is a bare `nohup .venv/bin/langgraph dev …`
#   on :8124 (RUNBOOK-FEAT-JARVIS-INTERNAL-001 Prerequisite A) with NO supervisor.
#   forge-prod REFUSES to boot without FORGE_AUTOBUILD_RUNNER_URL pointing at this
#   sidecar (TASK-FORGE-FRR-F010J fail-fast guard), so if the sidecar dies or is
#   lost on reboot, the whole build back-half is down. This unit supervises it with
#   an auto-restart policy — the third un-supervised `langgraph dev` O-30 names.
#
# SCOPE: a systemd **USER** unit (the sidecar binds the forge developer venv and
#   the forge-local .env). Install/enable is a coordinator step (see
#   ops/systemd/README.md); this file is AUTHORED + `systemd-analyze verify`-clean,
#   NOT installed.
#
# PREREQUISITE (RUNBOOK-FEAT-JARVIS-INTERNAL-001 Prerequisite B): the forge venv
#   must carry langgraph-cli + the provider extras, i.e. `.venv/bin/langgraph`
#   must exist and `init_chat_model` must import langchain-openai. Bring those in
#   with `uv sync --extra providers` (or the pip line in the runbook) BEFORE enable.
#
# BOOT ORDER (see ops/systemd/README.md §Boot order): the sidecar must be UP
#   before forge-prod (forge serve fail-fasts on a dead FORGE_AUTOBUILD_RUNNER_URL).
#   A user unit cannot hard-order against the system-scoped forge-prod container;
#   Restart=on-failure closes the race (forge-prod, itself restart: unless-stopped
#   after E2-S3(a), retries until the sidecar answers on :8124).

[Unit]
Description=forge autobuild-runner sidecar (langgraph dev — autobuild_runner graph on :8124)
Documentation=file:///home/richardwoollcott/Projects/appmilla_github/forge/ops/systemd/README.md
Documentation=file:///home/richardwoollcott/Projects/appmilla_github/ai-transition/docs/factory-gap-analysis-2026-07-13.md
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
WorkingDirectory=%h/Projects/appmilla_github/forge
# forge.langgraph.json registers ONLY autobuild_runner — the default langgraph.json
# also registers `orchestrator`, which fails to import (Prerequisite A). langgraph
# loads the file named in that config ("env": ".env"); sourced here too (optional).
EnvironmentFile=-%h/Projects/appmilla_github/forge/.env
# Canonical launch (RUNBOOK Prerequisite A), minus `nohup … &` (systemd owns the
# process lifecycle now): foreground, single graph, blocking backend, no reload.
# Invoked through `uv run` (matching the jarvis front door) so it binds the pinned
# forge venv; the runbook's bare `.venv/bin/langgraph` is the same binary. `uv run`
# also keeps the unit `systemd-analyze verify`-clean before Prerequisite B installs
# langgraph-cli into the venv (uv is the exec; langgraph is resolved at run time).
ExecStart=%h/.local/bin/uv run langgraph dev \
    --config forge.langgraph.json \
    --port 8124 --host 0.0.0.0 \
    --no-browser --allow-blocking --no-reload
# The O-30 requirement: auto-recover the crashed sidecar. on-failure so a clean
# operator `systemctl --user stop` stays stopped.
Restart=on-failure
RestartSec=5
TimeoutStartSec=120

[Install]
WantedBy=default.target
